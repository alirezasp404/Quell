<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- Quell Design System: Componentized Light Theme Palette       -->
    <!-- Clean, high-contrast desktop aesthetic for daylight productivity  -->
    <!-- ================================================================= -->

    <!-- Base Palette Colors -->
    <Color x:Key="AppControlFaceColor">#F8FAFC</Color>
    <Color x:Key="AppSurfaceColor">#F8FAFC</Color>
    <Color x:Key="AppWindowBackgroundColor">#FFFFFF</Color>
    <Color x:Key="AppWorkspaceColor">#FFFFFF</Color>
    <Color x:Key="AppBorderColor">#E2E8F0</Color>
    <Color x:Key="AppBorderLightColor">#F1F5F9</Color>
    <Color x:Key="AppBorderDarkColor">#CBD5E1</Color>
    <Color x:Key="AppTextPrimaryColor">#0F172A</Color>
    <Color x:Key="AppTextSecondaryColor">#475569</Color>
    <Color x:Key="AppTextMutedColor">#94A3B8</Color>
    <Color x:Key="AppAccentColor">#2563EB</Color>
    <Color x:Key="AppAccentHoverColor">#1D4ED8</Color>
    <Color x:Key="AppSplitterColor">#E2E8F0</Color>
    <Color x:Key="AppSplitterHoverColor">#3B82F6</Color>
    <Color x:Key="AppTabSelectedColor">#FFFFFF</Color>
    <Color x:Key="AppTabUnselectedColor">#F8FAFC</Color>
    <Color x:Key="AppTabHoverColor">#F1F5F9</Color>
    <Color x:Key="AppHeaderBgColor">#F8FAFC</Color>
    <Color x:Key="AppToolHoverBgColor">#F1F5F9</Color>
    <Color x:Key="AppToolHoverBorderColor">#CBD5E1</Color>

    <!-- Core Semantic Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppWorkspaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppControlFaceBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppSurfaceMutedBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppBorderLightBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppBorderDarkBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AppAccentMutedBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="AppSplitterBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppSplitterHoverBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AppTabActiveBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppTabInactiveBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppTabHoverBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppTabActiveBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AppEditorBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppEditorForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppSidebarHeaderBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppSidebarHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppSidebarTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppSidebarBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppChipActiveBackgroundBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="AppChipActiveForegroundBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AppMenuBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppMenuBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppStarGoldBrush" Color="#D97706" />
    <SolidColorBrush x:Key="AppTopBarBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppTopBarBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppRailBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppRailBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppButtonBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppButtonForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppButtonBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppToolHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppToolHoverBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppModalOverlayBrush" Color="#66000000" />
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#FFFFFF" />

    <!-- Segmented Control & Filter Toggle Tokens -->
    <SolidColorBrush x:Key="AppSegmentedTrackBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppSegmentedTrackBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppSegmentedItemActiveBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppSegmentedItemActiveBorderBrush" Color="#CBD5E1" />

    <!-- Terminal Component Semantic Brushes -->
    <SolidColorBrush x:Key="AppTerminalBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppTerminalForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppTerminalToolbarBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppTerminalToolbarBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppTerminalTabBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppTerminalTabActiveBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppTerminalTabBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppTerminalTabActiveBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AppTerminalSelectionBrush" Color="#302563EB" />
    <SolidColorBrush x:Key="AppTerminalCursorBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AppTerminalStatusBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppTerminalStatusBorderBrush" Color="#E2E8F0" />

    <!-- Table Component Semantic Brushes (QueryResultTable & SchemaPropertiesTable) -->
    <SolidColorBrush x:Key="AppTableGutterBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppTableGutterForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppTableGutterBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppTableDividerBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="AppTableWhiteColBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppTableAltColBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppTableCellForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppTableCellBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppTableHeaderBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppTableHeaderForegroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppTableHeaderBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppTableGridLinesHorizontalBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppTableGridLinesVerticalBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppTableSelectedBackgroundBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="AppTableSelectedForegroundBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="AppTableActiveBackgroundBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="AppTableActiveForegroundBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="AppTableActiveBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AppTableHoverBackgroundBrush" Color="#F1F5F9" />

    <!-- Primary Key Semantic Brushes (Neutral Slate - NO ORANGE) -->
    <SolidColorBrush x:Key="AppTablePkBadgeBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppTablePkBadgeBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppTablePkBadgeForegroundBrush" Color="#475569" />
    <SolidColorBrush x:Key="AppTablePkColumnForegroundBrush" Color="#0F172A" />

    <!-- Foreign Key Semantic Brushes -->
    <SolidColorBrush x:Key="AppTableFkBadgeBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppTableFkBadgeBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AppTableFkBadgeForegroundBrush" Color="#475569" />

    <!-- Danger & Alert Muted Background -->
    <SolidColorBrush x:Key="AppDangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="AppDangerHoverBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="AppDangerMutedBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="AppDangerBorderBrush" Color="#FCA5A5" />
    <SolidColorBrush x:Key="AppDangerForegroundBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="AppSuccessBackgroundBrush" Color="#D1FAE5" />
    <SolidColorBrush x:Key="AppSuccessBorderBrush" Color="#6EE7B7" />
    <SolidColorBrush x:Key="AppSuccessForegroundBrush" Color="#047857" />
    <SolidColorBrush x:Key="AppStatusActiveBrush" Color="#059669" />
    <SolidColorBrush x:Key="AppStatusActiveBackgroundBrush" Color="#D1FAE5" />
    <SolidColorBrush x:Key="AppStatusDeletedBrush" Color="#E11D48" />
    <SolidColorBrush x:Key="AppStatusDeletedBackgroundBrush" Color="#FFE4E6" />
    <SolidColorBrush x:Key="AppStatusWarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="AppStatusWarningBackgroundBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="AppWarningBackgroundBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="AppWarningBorderBrush" Color="#FCD34D" />
    <SolidColorBrush x:Key="AppWarningForegroundBrush" Color="#B45309" />

    <!-- IntelliSense & Overlay Component Semantic Brushes -->
    <SolidColorBrush x:Key="AppIntelliSenseHeaderBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppIntelliSenseBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AppIntelliSenseBadgeBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="AppIntelliSenseBadgeForegroundBrush" Color="#64748B" />

    <!-- SQL Syntax Keyword Color Token (Default: Light Mode Royal Blue) -->
    <SolidColorBrush x:Key="AppKeywordBrush" Color="#2563EB" />

    <!-- Focus Visual Suppression Tokens (Eliminate harsh black focus outlines) -->
    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="Transparent" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="Transparent" />
    <Thickness x:Key="SystemControlFocusVisualPrimaryThickness">0</Thickness>
    <Thickness x:Key="SystemControlFocusVisualSecondaryThickness">0</Thickness>

    <!-- Menu & Flyout Default Tokens -->
    <SolidColorBrush x:Key="PopupBackground" Color="Transparent" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource AppBorderColor}" />
    <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
    <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="MenuFlyoutPresenterCornerRadius">6</CornerRadius>

</ResourceDictionary>
