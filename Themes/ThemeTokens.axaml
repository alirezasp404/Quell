<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- Quell Modern Design System: Shared Theme Tokens & Dimensions      -->
    <!-- Componentized design metrics aligned with Quell New Design        -->
    <!-- ================================================================= -->

    <!-- Corner Radii -->
    <CornerRadius x:Key="AppCornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="AppCornerRadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="AppCornerRadiusLarge">8</CornerRadius>
    <CornerRadius x:Key="AppCornerRadiusRound">9999</CornerRadius>

    <!-- Standard Font Families -->
    <FontFamily x:Key="AppFontFamilyDefault">Inter, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif</FontFamily>
    <FontFamily x:Key="AppFontFamilyMonospace">JetBrains Mono, Cascadia Code, SF Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- Standard Table Metrics -->
    <x:Double x:Key="AppTableRowHeight">20</x:Double>
    <x:Double x:Key="AppTableHeaderHeight">25</x:Double>
    <x:Double x:Key="AppTableGutterWidth">56</x:Double>
    <x:Double x:Key="AppTableCellFontSize">11</x:Double>

</ResourceDictionary>
