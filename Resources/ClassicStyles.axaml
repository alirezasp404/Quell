<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Global Modern Typography -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="Inter, Segoe UI Variable, Segoe UI, sans-serif"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ========================================================================= -->
    <!-- Global Focus Visual Suppression (Eliminates Harsh Black Focus Borders)   -->
    <!-- ========================================================================= -->
    <Style Selector=":is(TemplatedControl)">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <!-- ========================================================================= -->
    <!-- Global Interactive Hover Cursors (Hand Pointer for Clickable Controls)    -->
    <!-- ========================================================================= -->

    <!-- Buttons (Standard, Tool, Menu, Tab, Action, Icon) -->
    <Style Selector=":is(Button)">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector=":is(Button):pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector=":is(Button):disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Toggle & Repeat Buttons -->
    <Style Selector="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style Selector="RepeatButton">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="RepeatButton:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="RepeatButton:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Menu & Context Menu Items (Zero Black Border on Click, Focus, or Selection) -->
    <Style Selector="MenuItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="MenuItem:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="MenuItem:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="MenuItem:focus /template/ Border#PART_LayoutRoot">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="MenuItem:focus-visible /template/ Border#PART_LayoutRoot">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Top-Level Menu Items in Menu Bar (File, Edit, View, Window, Help) -->
    <Style Selector="Menu > MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Menu > MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Menu > MenuItem:focus /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Menu > MenuItem:focus-visible /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Menu > MenuItem:open /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Dropdown Popup & Flyout Presenters (Theme-Colored Borders, No Black Outline) -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <!-- CheckBoxes & RadioButtons -->
    <Style Selector="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="CheckBox:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="CheckBox:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="RadioButton:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="RadioButton:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Dropdown / ComboBox Controls and Items -->
    <Style Selector="ComboBox">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ComboBox:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ComboBoxItem:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Tab Items -->
    <Style Selector="TabItem">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="TabItem:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- ListBox & Completion Items -->
    <Style Selector="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBoxItem:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- TreeView Nodes & Expanders -->
    <Style Selector="TreeViewItem">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="TreeViewItem:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="TreeViewItem:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- DataGrid Interactive Headers, Rows and Cells -->
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridColumnHeader:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridRowHeader">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridRowHeader:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridRow">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridRow:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridCell:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridCell TextBlock">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridCell TextBlock:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Sliders -->
    <Style Selector="Slider">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Slider:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Slider:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Links / HyperlinkButtons -->
    <Style Selector="HyperlinkButton">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="HyperlinkButton:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="HyperlinkButton:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Interactive Custom Card / Item Classes -->
    <Style Selector="Border.table-node-item">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.table-node-item:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.database-node-item">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.database-node-item:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.folder-node-item">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.folder-node-item:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.saved-connection-item">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.saved-connection-item:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.history-item">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.history-item:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.theme-card">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.theme-card:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.color-card">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.color-card:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.editor-tab">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.editor-tab:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.modal-backdrop">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.modal-backdrop:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.target-db-pill">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.target-db-pill:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector=":is(Control).cursor-pointer">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector=":is(Control).cursor-pointer:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector=":is(Control).pointer-hand">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector=":is(Control).pointer-hand:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Explicit Text Editors & Inputs (Preserve IBeam Cursor for Text Selection) -->
    <Style Selector="TextBox">
        <Setter Property="Cursor" Value="IBeam"/>
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Modern Menu & Toolbar Buttons -->
    <Style Selector="Button.classic-menu-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.classic-menu-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.classic-menu-btn:focus /template/ ContentPresenter">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.classic-menu-btn:focus-visible /template/ ContentPresenter">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Modern Toolbar Action Button -->
    <Style Selector="Button.classic-tool-btn">
        <Setter Property="Background" Value="{DynamicResource AppButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppButtonForegroundBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBorderBrush}"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.classic-tool-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppToolHoverBorderBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.classic-tool-btn:focus /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
    </Style>
    <Style Selector="Button.classic-tool-btn:focus-visible /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
    </Style>

    <!-- Modern Tab Button -->
    <Style Selector="Button.classic-tab-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="4,4,0,0"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.classic-tab-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppTabHoverBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.classic-tab-btn.active">
        <Setter Property="Background" Value="{DynamicResource AppTabActiveBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Modern GridSplitter -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource AppSplitterBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="GridSplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSplitterHoverBrush}"/>
    </Style>

</Styles>
