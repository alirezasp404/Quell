<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:ui="using:FluentAvalonia.UI.Controls">

    <!-- Global Modern Typography -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="Inter, Segoe UI Variable, Segoe UI, sans-serif"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ========================================================================= -->
    <!-- Global Focus Visual Suppression (Eliminates Harsh Black Focus Borders)   -->
    <!-- ========================================================================= -->
    <Style Selector=":is(TemplatedControl)">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <!-- ========================================================================= -->
    <!-- Global Interactive Hover Cursors (Hand Pointer for Clickable Controls)    -->
    <!-- ========================================================================= -->

    <!-- Buttons (Standard, Tool, Menu, Tab, Action, Icon) -->
    <Style Selector=":is(Button)">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector=":is(Button):pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector=":is(Button):disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Toggle & Repeat Buttons -->
    <Style Selector="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style Selector="RepeatButton">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="RepeatButton:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="RepeatButton:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Menu & Context Menu Items (Zero Black Border on Click, Focus, or Selection) -->
    <Style Selector="MenuItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="MenuItem:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="MenuItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="MenuItem:open">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
    </Style>
    <Style Selector="MenuItem:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
    </Style>
    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="MenuItem:focus /template/ Border#PART_LayoutRoot">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="MenuItem:focus-visible /template/ Border#PART_LayoutRoot">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Top-Level Menu Items in Menu Bar (File, Edit, View, Window, Help) -->
    <Style Selector="Menu > MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Menu > MenuItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Menu > MenuItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Menu > MenuItem:open">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Menu > MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Menu > MenuItem:focus /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Menu > MenuItem:focus-visible /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Menu > MenuItem:open /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Complete Elimination of Black Corners on Popups, Menus, ToolTips and Flyouts -->
    <Style Selector="PopupRoot">
        <Setter Property="TransparencyLevelHint" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="OverlayPopupHost">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Popup">
        <Setter Property="WindowManagerAddShadowHint" Value="False"/>
        <Setter Property="ShouldUseOverlayLayer" Value="True"/>
    </Style>

    <!-- Dropdown Popup and Flyout Presenters (Theme-Colored Borders, No Black Outline) -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <!-- Compact Dropdown / MenuFlyout Options & ContextMenu Items (Desktop IDE Scale) -->
    <Style Selector="MenuFlyoutPresenter MenuItem">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="6,1,8,1"/>
    </Style>
    <Style Selector="MenuFlyoutPresenter MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="6,1,8,1"/>
    </Style>
    <Style Selector="ContextMenu MenuItem">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="6,1,8,1"/>
    </Style>
    <Style Selector="ContextMenu MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="6,1,8,1"/>
    </Style>

    <!-- Top-Level Menu and MenuItem Dropdown Popup Borders (Zero Black Corners) -->
    <Style Selector="MenuItem /template/ Popup#PART_Popup">
        <Setter Property="WindowManagerAddShadowHint" Value="False"/>
        <Setter Property="ShouldUseOverlayLayer" Value="True"/>
    </Style>
    <Style Selector="MenuItem /template/ Popup#PART_Popup > Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BoxShadow" Value="0 8 24 0 #40000000"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Menu > MenuItem /template/ Popup#PART_Popup > Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BoxShadow" Value="0 8 24 0 #40000000"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="MenuItem /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BoxShadow" Value="0 8 24 0 #40000000"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Menu > MenuItem /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BoxShadow" Value="0 8 24 0 #40000000"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- ComboBox Dropdown Popups -->
    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BoxShadow" Value="0 8 24 0 #40000000"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- ToolTips -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="ToolTip.ShouldUseOverlayLayer" Value="True"/>
    </Style>

    <!-- CheckBoxes & RadioButtons -->
    <Style Selector="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="CheckBox:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="CheckBox:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="RadioButton:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="RadioButton:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Dropdown / ComboBox Controls and Items -->
    <Style Selector="ComboBox">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ComboBox:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ComboBoxItem:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="ComboBoxItem /template/ Border#PART_LayoutRoot">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>

    <!-- Tab Items -->
    <Style Selector="TabItem">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="TabItem:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- ListBox & Completion Items -->
    <Style Selector="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBoxItem:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- TreeView Nodes & Expanders -->
    <Style Selector="TreeViewItem">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="TreeViewItem:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="TreeViewItem:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- DataGrid Interactive Headers, Rows and Cells -->
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridColumnHeader:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridRowHeader">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridRowHeader:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridRow">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridRow:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridCell:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridCell TextBlock">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="DataGridCell TextBlock:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Sliders -->
    <Style Selector="Slider">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Slider:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Slider:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Links / HyperlinkButtons -->
    <Style Selector="HyperlinkButton">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="HyperlinkButton:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="HyperlinkButton:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- Interactive Custom Card / Item Classes -->
    <Style Selector="Border.table-node-item">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.table-node-item:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.database-node-item">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.database-node-item:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.folder-node-item">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.folder-node-item:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.saved-connection-item">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.saved-connection-item:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.history-item">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.history-item:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.theme-card">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.theme-card:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.color-card">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.color-card:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.editor-tab">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.editor-tab:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.modal-backdrop">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.modal-backdrop:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.target-db-pill">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.target-db-pill:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector=":is(Control).cursor-pointer">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector=":is(Control).cursor-pointer:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector=":is(Control).pointer-hand">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector=":is(Control).pointer-hand:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Explicit Text Editors & Inputs (Preserve IBeam Cursor for Text Selection) -->
    <Style Selector="TextBox">
        <Setter Property="Cursor" Value="IBeam"/>
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- ========================================================================= -->
    <!-- QUELL DESIGN SYSTEM: Unified Buttons, Tabs, Inputs, Cards & Modals        -->
    <!-- ========================================================================= -->

    <!-- Ghost / Header / Strip Button -->
    <Style Selector="Button.classic-menu-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadiusControl}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.classic-menu-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.classic-menu-btn:focus /template/ ContentPresenter">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.classic-menu-btn:focus-visible /template/ ContentPresenter">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Tab Close Icon Button -->
    <Style Selector="Button.quell-tab-close-btn">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.quell-tab-close-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>

    <!-- Secondary / Toolbar Action Button -->
    <Style Selector="Button.classic-tool-btn">
        <Setter Property="Background" Value="{DynamicResource AppButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppButtonForegroundBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadiusControl}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBorderBrush}"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.classic-tool-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppToolHoverBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.classic-tool-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppToolHoverBorderBrush}"/>
    </Style>
    <Style Selector="Button.classic-tool-btn:focus /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
    </Style>
    <Style Selector="Button.classic-tool-btn:focus-visible /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
    </Style>

    <!-- Primary Accent Action CTA Button -->
    <Style Selector="Button.quell-btn-primary">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadiusControl}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.quell-btn-primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.quell-btn-primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
    </Style>

    <!-- Destructive / Danger Confirm CTA Button -->
    <Style Selector="Button.quell-btn-danger">
        <Setter Property="Background" Value="{DynamicResource AppDangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadiusControl}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.quell-btn-danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppDangerHoverBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.quell-btn-danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppDangerHoverBrush}"/>
    </Style>

    <!-- Segmented Tab Control Track & Tabs (Tables / Views / Procs, All / Failed / This DB, etc.) -->
    <Style Selector="Border.quell-segmented-track">
        <Setter Property="Background" Value="{DynamicResource AppSegmentedTrackBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppSegmentedTrackBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadiusLarge}"/>
        <Setter Property="Padding" Value="3"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadiusMedium}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadiusMedium}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab:not(.active):pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab:not(.active):pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab.active">
        <Setter Property="Background" Value="{DynamicResource AppSegmentedItemActiveBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppSegmentedItemActiveBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppChipActiveForegroundBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSegmentedItemActiveBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppSegmentedItemActiveBorderBrush}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab.active TextBlock.seg-label">
        <Setter Property="Foreground" Value="{DynamicResource AppChipActiveForegroundBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab:not(.active) TextBlock.seg-label">
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab:not(.active):pointerover TextBlock.seg-label">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab.active ic|SymbolIcon.seg-icon">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab:not(.active) ic|SymbolIcon.seg-icon">
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab:not(.active):pointerover ic|SymbolIcon.seg-icon">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab.active ui|FASymbolIcon.seg-icon">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab:not(.active) ui|FASymbolIcon.seg-icon">
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab:not(.active):pointerover ui|FASymbolIcon.seg-icon">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab.active PathIcon.seg-icon">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab:not(.active) PathIcon.seg-icon">
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
    </Style>
    <Style Selector="Button.quell-segmented-tab:not(.active):pointerover PathIcon.seg-icon">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>

    <!-- Companion Filter Scope Pill Toggle (e.g. Active DB) -->
    <Style Selector="ToggleButton.quell-filter-toggle">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="ToggleButton.quell-filter-toggle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
    </Style>
    <Style Selector="ToggleButton.quell-filter-toggle:checked">
        <Setter Property="Background" Value="{DynamicResource AppChipActiveBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppChipActiveForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ToggleButton.quell-filter-toggle:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppChipActiveBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
    </Style>

    <!-- Unified Input & Search Shell -->
    <Style Selector="Border.quell-input-box">
        <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadiusLarge}"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>
    <Style Selector="Border.quell-input-box:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderDarkBrush}"/>
    </Style>

    <!-- Standard Section / Content Card -->
    <Style Selector="Border.quell-card">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadiusLarge}"/>
    </Style>

    <!-- Unified Modal Header & Footer Chrome -->
    <Style Selector="Border.modal-dialog-card">
        <Setter Property="Background" Value="{DynamicResource AppWorkspaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadiusModal}"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Border.quell-modal-header">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="10,10,0,0"/>
        <Setter Property="Padding" Value="18,12"/>
    </Style>
    <Style Selector="Border.quell-modal-footer">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="CornerRadius" Value="0,0,10,10"/>
        <Setter Property="Padding" Value="18,10"/>
    </Style>

    <!-- Modern Tab Button (Modal Strips / Section Tabs) -->
    <Style Selector="Button.classic-tab-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="7,7,0,0"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="Button.classic-tab-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppTabHoverBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.classic-tab-btn.active">
        <Setter Property="Background" Value="{DynamicResource AppTabActiveBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Modern GridSplitter -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource AppSplitterBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="GridSplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppSplitterHoverBrush}"/>
    </Style>


    <!-- ========================================================================= -->
    <!-- GPU-Accelerated Dynamic Motion Pipeline (Active ONLY in GPU Mode)         -->
    <!-- CPU Software Mode disables animations & heavy blurs to stay ultra-light   -->
    <!-- ========================================================================= -->

    <!-- 1. Modal Backdrop & Card Elevation (GPU Motion + Soft Shadow vs CPU Crisp Flat) -->
    <Style Selector=":is(TopLevel).gpu-mode Border.modal-backdrop">
        <Style.Animations>
            <Animation Duration="0:0:0.18" FillMode="Forward" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1.0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector=":is(TopLevel).gpu-mode Border.modal-dialog-card">
        <Setter Property="BoxShadow" Value="0 16 40 0 #48000000"/>
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Style.Animations>
            <Animation Duration="0:0:0.22" FillMode="Forward" Easing="BackEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.0"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="0.93"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="0.93"/>
                    <Setter Property="TranslateTransform.Y" Value="12"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1.0"/>
                    <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector=":is(TopLevel):not(.gpu-mode) Border.modal-dialog-card">
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
    </Style>
    <Style Selector=":is(TopLevel):not(.gpu-mode) MenuItem /template/ Popup#PART_Popup > Border, :is(TopLevel):not(.gpu-mode) ComboBox /template/ Border#PopupBorder">
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
    </Style>

    <!-- 2. GPU-Accelerated Interactive Buttons & Segmented Tabs -->
    <Style Selector=":is(TopLevel).gpu-mode Button.classic-tool-btn, :is(TopLevel).gpu-mode Button.quell-btn-primary, :is(TopLevel).gpu-mode Button.quell-btn-danger, :is(TopLevel).gpu-mode Button.quell-segmented-tab, :is(TopLevel).gpu-mode ToggleButton.quell-filter-toggle">
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=":is(TopLevel).gpu-mode Button.classic-tool-btn:pressed, :is(TopLevel).gpu-mode Button.quell-btn-primary:pressed, :is(TopLevel).gpu-mode Button.quell-btn-danger:pressed, :is(TopLevel).gpu-mode Button.quell-segmented-tab:pressed, :is(TopLevel).gpu-mode ToggleButton.quell-filter-toggle:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>
    <Style Selector=":is(TopLevel):not(.gpu-mode) Button.classic-tool-btn, :is(TopLevel):not(.gpu-mode) Button.quell-btn-primary, :is(TopLevel):not(.gpu-mode) Button.quell-btn-danger, :is(TopLevel):not(.gpu-mode) Button.quell-segmented-tab, :is(TopLevel):not(.gpu-mode) ToggleButton.quell-filter-toggle">
        <Setter Property="Transitions" Value="{x:Null}"/>
    </Style>

    <!-- 3. GPU-Accelerated Workspace Document & Tool Tabs -->
    <Style Selector=":is(TopLevel).gpu-mode Border.editor-tab">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=":is(TopLevel).gpu-mode Button.footer-tab-btn, :is(TopLevel).gpu-mode Button.modern-terminal-tab, :is(TopLevel).gpu-mode Button.classic-tab-btn">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- 4. GPU-Accelerated Filter Pill Buttons -->
    <Style Selector=":is(TopLevel).gpu-mode Button.filter-pill-btn">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=":is(TopLevel).gpu-mode Button.filter-pill-btn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <!-- 5. GPU-Accelerated ER Diagram & Import Canvas Cards + Infinite Spinner -->
    <Style Selector=":is(TopLevel).gpu-mode Border.diagram-table-card, :is(TopLevel).gpu-mode Border.canvas-card">
        <Setter Property="BoxShadow" Value="0 6 18 0 #28000000"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=":is(TopLevel).gpu-mode Border.intellisense-card">
        <Setter Property="BoxShadow" Value="0 8 24 0 #38000000"/>
    </Style>
    <Style Selector=":is(TopLevel):not(.gpu-mode) Border.intellisense-card">
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
    </Style>
    <Style Selector=":is(TopLevel).gpu-mode Border.theme-card, :is(TopLevel).gpu-mode Border.quick-launch-card">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=":is(TopLevel).gpu-mode Button.nav-cat-btn, :is(TopLevel).gpu-mode Button.perf-mode-card">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=":is(TopLevel).gpu-mode Border.diagram-table-card:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.02) translateY(-2px)"/>
        <Setter Property="BoxShadow" Value="0 10 28 0 #45000000"/>
    </Style>
    <Style Selector=":is(TopLevel):not(.gpu-mode) Border.diagram-table-card, :is(TopLevel):not(.gpu-mode) Border.canvas-card">
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
    </Style>

    <Style Selector=":is(TopLevel).gpu-mode Border.spin-indicator">
        <Style.Animations>
            <Animation Duration="0:0:1.0" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0.0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360.0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- 6. GPU-Accelerated Sidebar & Rail Interactive Items -->
    <Style Selector=":is(TopLevel).gpu-mode Border.sidebar-row-item, :is(TopLevel).gpu-mode Border.history-card">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=":is(TopLevel).gpu-mode Button.dock-rail-btn, :is(TopLevel).gpu-mode Button.panel-icon-btn">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
</Styles>
