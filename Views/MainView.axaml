<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:components="using:Quell.Components"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Quell.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

    <!-- Cross-Platform View (Mobile & Single-View Layout) -->
    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- 1. FIXED TOP NAVBAR -->
        <components:NavbarComponent x:Name="MainNavbar" Grid.Row="0" DataContext="{Binding Navbar}" />

        <!-- 2. MAIN DYNAMIC WORKSPACE (Sidebar + Editor + Footer) -->
        <Grid x:Name="MainGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Resizable Sidebar Column (Min: 160px, Max: 450px) -->
                <ColumnDefinition Width="240" MinWidth="160" MaxWidth="450" />
                <ColumnDefinition Width="Auto" />
                <!-- Center Dynamic Workspace Column (Takes remaining width: *) -->
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            
            <!-- LEFT RESIZABLE SIDEBAR -->
            <components:SidebarComponent Grid.Column="0" 
                                         DataContext="{Binding Sidebar}" />

            <!-- VERTICAL DRAG SPLITTER FOR SIDEBAR -->
            <GridSplitter x:Name="SidebarSplitter"
                          Grid.Column="1" 
                          Width="4" 
                          ResizeDirection="Columns" 
                          ResizeBehavior="PreviousAndNext" 
                          Cursor="SizeWestEast" 
                          IsVisible="{Binding Sidebar.IsVisible}" />

            <!-- CENTER & FOOTER WORKSPACE -->
            <Grid x:Name="CenterGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Center Document Canvas (Takes remaining height: *) -->
                    <RowDefinition Height="*" MinHeight="180" />
                    <RowDefinition Height="Auto" />
                    <!-- Resizable Bottom Output Panel (Compact Default: 140px, Min: 70px, Max: 450px) -->
                    <RowDefinition Height="140" MinHeight="70" MaxHeight="450" />
                </Grid.RowDefinitions>
                
                <!-- CENTER DOCUMENT CANVAS -->
                <components:EditorComponent x:Name="MainEditor" Grid.Row="0" DataContext="{Binding Editor}" />

                <!-- HORIZONTAL DRAG SPLITTER FOR FOOTER -->
                <GridSplitter x:Name="FooterSplitter"
                              Grid.Row="1" 
                              Height="4" 
                              ResizeDirection="Rows" 
                              ResizeBehavior="PreviousAndNext" 
                              Cursor="SizeNorthSouth" 
                              IsVisible="{Binding Footer.IsVisible}" />

                <!-- BOTTOM OUTPUT TOOL WINDOW -->
                <components:FooterComponent Grid.Row="2" 
                                            DataContext="{Binding Footer}" />
            </Grid>
        </Grid>

        <!-- 3. FIXED BOTTOM STATUS BAR -->
        <components:StatusBarComponent Grid.Row="2" />

        <!-- FLOATING CORNER "GET UPDATES" BADGE BOX (Shown when modal is dismissed) -->
        <Border Grid.Row="1" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom"
                Margin="0,0,24,18"
                ZIndex="85"
                IsVisible="{Binding UpdateModal.IsCornerBadgeVisible}"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppAccentBrush}"
                BorderThickness="1.5"
                CornerRadius="6"
                BoxShadow="0 4 16 0 #40000000"
                Padding="10,6">
            <Button Classes="classic-tool-btn"
                    Command="{Binding OpenUpdateModalCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Cursor="Hand"
                    ToolTip.Tip="A new version of Quell Studio is available. Click to open release details.">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="4" Width="22" Height="22">
                        <ui:FASymbolIcon Symbol="Download" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="Get Updates" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            <Border Background="#10B981" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpdateModal.LatestVersion}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="New version available • Click to view" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Border>

        <!-- 4. MODAL DIALOGS OVERLAYS (Top-level ZIndex & Full Viewport) -->
        <components:ConnectDatabaseModalComponent Grid.Row="0" Grid.RowSpan="3" ZIndex="100" DataContext="{Binding ConnectModal}" />
        <components:ConfirmActionModalComponent Grid.Row="0" Grid.RowSpan="3" ZIndex="101" DataContext="{Binding ConfirmModal}" />
        <components:ExportDataModalComponent Grid.Row="0" Grid.RowSpan="3" ZIndex="102" DataContext="{Binding ExportModal}" />
        <components:SettingsModalComponent Grid.Row="0" Grid.RowSpan="3" ZIndex="103" DataContext="{Binding SettingsModal}" />
        <components:DatabaseDiagramModalComponent Grid.Row="0" Grid.RowSpan="3" ZIndex="105" DataContext="{Binding DiagramModal}" />
        <components:UpdateModalComponent Grid.Row="0" Grid.RowSpan="3" ZIndex="106" DataContext="{Binding UpdateModal}" />
    </Grid>
</UserControl>
