<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Quell.ViewModels"
              xmlns:ic="using:FluentIcons.Avalonia"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
              mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="300"
              x:Class="Quell.Components.ObjectExplorerEmptyStateComponent">

    <!-- Reusable Object Explorer Empty State Card (Shown when disconnected) -->
    <Border Classes="quell-card"
            Background="{DynamicResource AppWorkspaceBrush}"
            Margin="8">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="16">
            <ic:SymbolIcon Symbol="Database" FontSize="36" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="No Active Connection" 
                       Foreground="{DynamicResource AppTextSecondaryBrush}" 
                       FontSize="12" 
                       FontWeight="SemiBold" 
                       HorizontalAlignment="Center" 
                       TextAlignment="Center"/>
            <Button Classes="quell-btn-primary" 
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectModal.OpenCommand}" 
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:FASymbolIcon Symbol="Link" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="Connect..." VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
