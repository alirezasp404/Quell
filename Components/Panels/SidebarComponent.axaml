<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Quell.ViewModels"
              xmlns:components="using:Quell.Components"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
              xmlns:i="using:Avalonia.Xaml.Interactivity"
              xmlns:b="using:Quell.Behaviors"
              xmlns:ic="using:FluentIcons.Avalonia"
              mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="700"
              x:Class="Quell.Components.SidebarComponent"
              x:DataType="vm:SidebarViewModel"
              x:Name="SidebarRoot"
              IsVisible="{Binding IsVisible}">

    <UserControl.Styles>
        <Style Selector="ToggleButton.classic-chip-btn">
            <Setter Property="Background" Value="{DynamicResource AppWorkspaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="MinHeight" Value="18"/>
        </Style>
        <Style Selector="ToggleButton.classic-chip-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="ToggleButton.classic-chip-btn:checked">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
        </Style>

        <!-- Table Node Item Styling: Hover & Active/Clicked States -->
        <Style Selector="Border.table-node-item">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.table-node-item:not(.active):pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.table-node-item.active">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.table-node-item.active TextBlock.table-name">
            <Setter Property="Foreground" Value="{DynamicResource AppTableActiveForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.table-node-item.active ic|SymbolIcon.table-icon">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Border.table-node-item:not(.active) TextBlock.table-name">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="Border.table-node-item:not(.active) ic|SymbolIcon.table-icon">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        </Style>

        <!-- Dock Rail Icon Button -->
        <Style Selector="Button.dock-rail-btn">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.dock-rail-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.dock-rail-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}"/>
        </Style>
        <Style Selector="Button.dock-rail-btn.active">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Button.dock-rail-btn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.dock-rail-btn.pinned">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Button.dock-rail-btn.pinned /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
        </Style>
        <Style Selector="Button.dock-rail-btn.pinned ic|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <Style Selector="Button.pin-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.pin-button /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="Button.pin-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHoverBrush}"/>
        </Style>
        <Style Selector="Button.pin-button.pinned">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Button.pin-button.pinned /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.pin-button.pinned:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Button.pin-button.pinned ic|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Button.pin-button.pinned TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <Style Selector="Button.close-drawer-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.close-drawer-btn:pointerover">
            <Setter Property="Background" Value="#25EF4444"/>
            <Setter Property="BorderBrush" Value="#66EF4444"/>
            <Setter Property="Foreground" Value="#EF4444"/>
        </Style>
    </UserControl.Styles>

    <!-- Modern DataGrip Style Left Activity Dock + Collapsible Drawer -->
    <Border Background="{DynamicResource AppSidebarBackgroundBrush}" 
            BorderBrush="{DynamicResource AppSidebarBorderBrush}" 
            BorderThickness="0,0,1,0">
        <Grid ColumnDefinitions="54, *">
            
            <!-- 1. LEFT DOCK RAIL (Windows/DataGrip Style Vertical Icon Dock) -->
            <Border Grid.Column="0" 
                    Width="54"
                    Background="{DynamicResource AppWorkspaceBrush}" 
                    BorderBrush="{DynamicResource AppBorderBrush}" 
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Top Section: App Badge & Navigation Tools -->
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,6,0,0" HorizontalAlignment="Center">
                        <!-- App Tile -->
                        <Border Width="34" Height="34" 
                                CornerRadius="8" 
                                Background="{DynamicResource AppAccentMutedBrush}" 
                                HorizontalAlignment="Center" 
                                Margin="0,2,0,4">
                            <ic:SymbolIcon Symbol="DatabaseSearch" FontSize="18" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="6,2" Width="30"/>

                        <!-- 1a. Databases / Saved Connections (Click to open/expand) -->
                        <Button Classes="dock-rail-btn" 
                                Classes.active="{Binding IsDatabasesTabActive}"
                                Command="{Binding ToggleDatabasesTabCommand}"
                                ToolTip.Tip="Databases &amp; Connections (Click to open)">
                            <i:Interaction.Behaviors>
                                <b:GpuButtonPressBehavior PressScale="0.92" />
                            </i:Interaction.Behaviors>
                            <Grid>
                                <Border Width="3" Height="20" CornerRadius="1.5" 
                                        Background="{DynamicResource AppAccentBrush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="-6,0,0,0" 
                                        IsVisible="{Binding IsDatabasesTabActive}" />
                                <ic:SymbolIcon Symbol="Database" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 1b. Explorer / Tables & Schemas (Click to open/expand) -->
                        <Button Classes="dock-rail-btn" 
                                Classes.active="{Binding IsExplorerTabActive}"
                                Command="{Binding ToggleExplorerTabCommand}"
                                ToolTip.Tip="Object Explorer - Tables &amp; Schemas (Click to open)">
                            <i:Interaction.Behaviors>
                                <b:GpuButtonPressBehavior PressScale="0.92" />
                            </i:Interaction.Behaviors>
                            <Grid>
                                <Border Width="3" Height="20" CornerRadius="1.5" 
                                        Background="{DynamicResource AppAccentBrush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="-6,0,0,0" 
                                        IsVisible="{Binding IsExplorerTabActive}" />
                                <ic:SymbolIcon Symbol="Folder" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- 1c. History / Query History (Click to open/expand) -->
                        <Button Classes="dock-rail-btn" 
                                Classes.active="{Binding IsHistoryTabActive}"
                                Command="{Binding ToggleHistoryTabCommand}"
                                ToolTip.Tip="Query History (Click to open)">
                            <i:Interaction.Behaviors>
                                <b:GpuButtonPressBehavior PressScale="0.92" />
                            </i:Interaction.Behaviors>
                            <Grid>
                                <Border Width="3" Height="20" CornerRadius="1.5" 
                                        Background="{DynamicResource AppAccentBrush}" 
                                        HorizontalAlignment="Left" 
                                        Margin="-6,0,0,0" 
                                        IsVisible="{Binding IsHistoryTabActive}" />
                                <ic:SymbolIcon Symbol="History" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Separator -->
                        <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="6,4" Width="30"/>

                        <!-- 1d. Connected Active Database Icon Pill -->
                        <Button Classes="dock-rail-btn" 
                                IsVisible="{Binding IsConnected}"
                                Command="{Binding ToggleExplorerTabCommand}"
                                ToolTip.Tip="{Binding DatabaseName, StringFormat='Active Database: {0} (Click to explore)'}">
                            <i:Interaction.Behaviors>
                                <b:GpuButtonPressBehavior PressScale="0.92" />
                            </i:Interaction.Behaviors>
                            <Grid Width="34" Height="34">
                                <Border Background="{DynamicResource AppAccentMutedBrush}" CornerRadius="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <ic:SymbolIcon Symbol="Database" FontSize="16" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2">
                                    <i:Interaction.Behaviors>
                                        <b:GpuPulseAttentionBehavior MinOpacity="0.4" CycleDurationMs="2000" />
                                    </i:Interaction.Behaviors>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Tools: Connect, ER Diagram, Refresh, Pin -->
                    <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,6" HorizontalAlignment="Center">
                        <!-- Quick Connect -->
                        <Button Classes="dock-rail-btn" 
                                Command="{Binding OpenConnectDialogCommand}" 
                                ToolTip.Tip="Add New Connection...">
                            <i:Interaction.Behaviors>
                                <b:GpuButtonPressBehavior PressScale="0.92" />
                            </i:Interaction.Behaviors>
                            <ic:SymbolIcon Symbol="DatabasePlugConnected" FontSize="16" Foreground="{DynamicResource AppAccentBrush}"/>
                        </Button>

                        <!-- ER Diagram -->
                        <Button Classes="dock-rail-btn" 
                                Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).OpenDiagramModalCommand}" 
                                ToolTip.Tip="ER Diagram &amp; Relations">
                            <i:Interaction.Behaviors>
                                <b:GpuButtonPressBehavior PressScale="0.92" />
                            </i:Interaction.Behaviors>
                            <ic:SymbolIcon Symbol="TableMultiple" FontSize="16" Foreground="{DynamicResource AppAccentBrush}"/>
                        </Button>

                        <!-- Refresh Schema -->
                        <Button Classes="dock-rail-btn" 
                                Command="{Binding RefreshCommand}" 
                                ToolTip.Tip="Refresh All Connections &amp; Tables">
                            <i:Interaction.Behaviors>
                                <b:GpuButtonPressBehavior PressScale="0.92" />
                            </i:Interaction.Behaviors>
                            <ic:SymbolIcon Symbol="ArrowSync" FontSize="15" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </Button>

                        <!-- Pin / Dock Mode Toggle -->
                        <Button Classes="dock-rail-btn" 
                                Classes.pinned="{Binding IsPinned}"
                                Command="{Binding TogglePinCommand}"
                                ToolTip.Tip="{Binding PinTooltipText}">
                            <i:Interaction.Behaviors>
                                <b:GpuButtonPressBehavior PressScale="0.92" />
                            </i:Interaction.Behaviors>
                            <ic:SymbolIcon Symbol="Pin" FontSize="15"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. DETAILS DRAWER (Full Content Panel, Expands in Place) -->
            <Border Grid.Column="1" 
                    Background="{DynamicResource AppSidebarBackgroundBrush}"
                    ClipToBounds="True"
                    IsVisible="{Binding IsExpanded}">
                <Grid RowDefinitions="Auto, *">
                    <!-- Drawer Header (Title + Status + Pin + Close) -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource AppSidebarHeaderBackgroundBrush}" 
                            BorderBrush="{DynamicResource AppSidebarBorderBrush}" 
                            BorderThickness="0,0,0,1" 
                            Height="30" 
                            Padding="10,0,6,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DrawerTitle}" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}" 
                                           FontSize="10" 
                                           Foreground="{DynamicResource AppTextMutedBrush}" 
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="110"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="pin-button" 
                                        Classes.pinned="{Binding IsPinned}"
                                        Command="{Binding TogglePinCommand}"
                                        ToolTip.Tip="{Binding PinTooltipText}"
                                        Padding="5,2"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ic:SymbolIcon Symbol="Pin" FontSize="11"/>
                                        <TextBlock Text="{Binding PinStatusText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="close-drawer-btn" 
                                        Command="{Binding CollapseDockCommand}"
                                        ToolTip.Tip="Close Sidebar (Esc)"
                                        Padding="5,3"
                                        Cursor="Hand">
                                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="9"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Content (Grid.Row="1") -->
                    <Grid Grid.Row="1">

                        <!-- ======================================================== -->
                        <!-- TAB 1: DATABASES VIEW (Saved Connections List)          -->
                        <!-- ======================================================== -->
                        <Grid RowDefinitions="Auto, *" Margin="0" IsVisible="{Binding IsDatabasesTab}">
                            <!-- Header with New Connection button -->
                            <Border Grid.Row="0" Padding="8,6,6,6" BorderBrush="{DynamicResource AppSidebarBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="SAVED CONNECTIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding SavedConnections.Count, StringFormat='{}{0} saved connection(s)'}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="classic-tool-btn" Command="{Binding OpenConnectDialogCommand}" Padding="6,3">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ui:FASymbolIcon Symbol="Add" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="New" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Scrollable Connections List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,6">
                                <StackPanel Spacing="4">
                                    <ItemsControl ItemsSource="{Binding SavedConnections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="saved-connection-item"
                                                        Cursor="Hand"
                                                        Background="{DynamicResource AppWorkspaceBrush}" 
                                                        BorderBrush="{DynamicResource AppBorderBrush}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="5" 
                                                        Padding="8,6" 
                                                        Margin="0,2"
                                                        HorizontalAlignment="Stretch"
                                                        DoubleTapped="OnSavedConnectionDoubleTapped">
                                                    <!-- Right-Click ContextMenu for Saved Connection -->
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Connect" 
                                                                      Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).ActivateConnectionCommand}"
                                                                      CommandParameter="{Binding}"
                                                                      IsVisible="{Binding !IsActive}">
                                                                <MenuItem.Icon>
                                                                    <ui:FASymbolIcon Symbol="Play" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Disconnect" 
                                                                      Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).DisconnectSavedConnectionCommand}"
                                                                      CommandParameter="{Binding}"
                                                                      IsVisible="{Binding IsActive}">
                                                                <MenuItem.Icon>
                                                                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="11" Foreground="#EF4444"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="Edit Connection..." 
                                                                      Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).EditSavedConnectionCommand}"
                                                                      CommandParameter="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <ui:FASymbolIcon Symbol="Settings" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="Open in Terminal (CLI)" 
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).LaunchCliInTerminalCommand}">
                                                                <MenuItem.Icon>
                                                                    <ui:FASymbolIcon Symbol="Play" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="Delete Connection" 
                                                                      Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).DisconnectAndRemoveConnectionCommand}"
                                                                      CommandParameter="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <ui:FASymbolIcon Symbol="Delete" FontSize="11" Foreground="#EF4444"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>

                                                    <Grid ColumnDefinitions="Auto, *">
                                                        <!-- Dedicated Database Vector Icon Tile -->
                                                        <Border Grid.Column="0" 
                                                                Width="26" Height="26" 
                                                                CornerRadius="6" 
                                                                Background="{Binding BadgeColor}" 
                                                                VerticalAlignment="Center" 
                                                                Margin="0,0,8,0">
                                                            <PathIcon Data="M12 3C6.5 3 2 4.34 2 6v12c0 1.66 4.5 3 10 3s10-1.34 10-3V6c0-1.66-4.5-3-10-3zm0 2c4.42 0 8 .9 8 2s-3.58 2-8 2-8-.9-8-2 3.58-2 8-2zm8 13c0 1.1-3.58 2-8 2s-8-.9-8-2v-2.12c1.76 1.05 4.7 1.62 8 1.62s6.24-.57 8-1.62V18zm0-4.5c0 1.1-3.58 2-8 2s-8-.9-8-2v-2.12c1.76 1.05 4.7 1.62 8 1.62s6.24-.57 8-1.62v2.12zm0-4.5c0 1.1-3.58 2-8 2s-8-.9-8-2V6.88c1.76 1.05 4.7 1.62 8 1.62s6.24-.57 8-1.62V9z" 
                                                                      Width="13" Height="13" 
                                                                      Foreground="White" 
                                                                      HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Details -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayTitle}" 
                                                                           FontSize="11" 
                                                                           FontWeight="SemiBold" 
                                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                                                           TextTrimming="CharacterEllipsis"/>

                                                                <!-- Connected / Active Dot Indicator -->
                                                                <Border Width="6" Height="6" 
                                                                        CornerRadius="3" 
                                                                        Background="{Binding StatusBadgeColor}" 
                                                                        VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <TextBlock Text="{Binding DatabaseType}" 
                                                                       FontSize="10" 
                                                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="No saved connections yet" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource AppTextMutedBrush}" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,20" 
                                               IsVisible="{Binding !SavedConnections.Count}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ======================================================== -->
                        <!-- TAB 2: OBJECT EXPLORER (Hierarchical Database Tree)      -->
                        <!-- ======================================================== -->
                        <Grid RowDefinitions="Auto, *" Margin="0" IsVisible="{Binding IsExplorerTab}">
                            <!-- Search & Filter Box -->
                            <StackPanel Grid.Row="0" Margin="6,6,6,6" Spacing="4">
                                <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsConnected}">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" VerticalAlignment="Center">
                                            <i:Interaction.Behaviors>
                                                <b:GpuPulseAttentionBehavior MinOpacity="0.4" CycleDurationMs="2000" />
                                            </i:Interaction.Behaviors>
                                        </Border>
                                        <ic:SymbolIcon Symbol="Database" FontSize="10" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Active:" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DatabaseName}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  IsChecked="{Binding FilterActiveOnly}"
                                                  Classes="classic-chip-btn"
                                                  ToolTip.Tip="Search only in active database tables"
                                                  Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <ui:FASymbolIcon Symbol="Filter" FontSize="8" VerticalAlignment="Center"/>
                                            <TextBlock Text="Active Only" FontSize="9" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox Grid.Column="0" 
                                             Classes="classic-search-box"
                                             Text="{Binding TableSearchFilter, Mode=TwoWay}"
                                             PlaceholderText="{Binding SearchPlaceholderText}"
                                             Height="24"
                                             Padding="6,2"
                                             FontSize="11"/>

                                    <Button Grid.Column="1" 
                                            Classes="classic-menu-btn"
                                            Command="{Binding ClearSearchFilterCommand}"
                                            IsVisible="{Binding HasSearchFilter}"
                                            Padding="4,2"
                                            Margin="0,0,4,0"
                                            ToolTip.Tip="Clear search filter">
                                        <ui:FASymbolIcon Symbol="Dismiss" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Hierarchical TreeView -->
                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                              IsVisible="{Binding FilteredDatabaseNodes.Count}">
                                    <TreeView ItemsSource="{Binding FilteredDatabaseNodes}" 
                                              SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0">
                                        <TreeView.Styles>
                                            <Style Selector="TreeViewItem" x:DataType="vm:SidebarTreeNodeBase">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="MinHeight" Value="24"/>
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            </Style>
                                            <Style Selector="TreeViewItem:selected /template/ Border#SelectionBorder">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </TreeView.Styles>
                                        <TreeView.DataTemplates>
                                            <TreeDataTemplate DataType="vm:DatabaseConnectionTreeNode" ItemsSource="{Binding Children}">
                                                <Border Classes="table-node-item"
                                                        Padding="4,2" 
                                                        Margin="0,1"
                                                        CornerRadius="3"
                                                        Background="Transparent">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Connect" 
                                                                      Command="{Binding ConnectCommand}" 
                                                                      IsVisible="{Binding !IsConnected}">
                                                                <MenuItem.Icon>
                                                                    <ui:FASymbolIcon Symbol="Play" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Disconnect" 
                                                                      Command="{Binding DisconnectCommand}" 
                                                                      IsVisible="{Binding IsConnected}">
                                                                <MenuItem.Icon>
                                                                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="11" Foreground="#EF4444"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="Refresh Tables" 
                                                                      Command="{Binding RefreshCommand}">
                                                                <MenuItem.Icon>
                                                                    <ui:FASymbolIcon Symbol="Refresh" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="Edit Connection..." 
                                                                      Command="{Binding EditCommand}">
                                                                <MenuItem.Icon>
                                                                    <ui:FASymbolIcon Symbol="Settings" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Open in Terminal (CLI)" 
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).LaunchCliInTerminalCommand}">
                                                                <MenuItem.Icon>
                                                                    <ui:FASymbolIcon Symbol="Play" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="Delete Connection" 
                                                                      Command="{Binding DeleteCommand}">
                                                                <MenuItem.Icon>
                                                                    <ui:FASymbolIcon Symbol="Delete" FontSize="11" Foreground="#EF4444"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <ic:SymbolIcon Grid.Column="0" 
                                                                       Symbol="Database" 
                                                                       FontSize="13" 
                                                                       Foreground="{DynamicResource AppAccentBrush}" 
                                                                       Margin="0,0,6,0" 
                                                                       VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" 
                                                                   Text="{Binding Title}" 
                                                                   FontSize="11" 
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Border Grid.Column="2" 
                                                                Width="6" Height="6" 
                                                                CornerRadius="3" 
                                                                Background="{Binding StatusColor}" 
                                                                VerticalAlignment="Center" 
                                                                Margin="4,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </TreeDataTemplate>

                                            <TreeDataTemplate DataType="vm:FolderTreeNode" ItemsSource="{Binding Children}">
                                                <Border Padding="4,2" Margin="0,1" CornerRadius="3" Background="Transparent">
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <ic:SymbolIcon Grid.Column="0" 
                                                                       Symbol="Folder" 
                                                                       FontSize="13" 
                                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                                                       Margin="0,0,6,0" 
                                                                       VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" 
                                                                   Text="{Binding Title}" 
                                                                   FontSize="11" 
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" 
                                                                   Text="{Binding Subtitle}" 
                                                                   FontSize="9" 
                                                                   Foreground="{DynamicResource AppTextMutedBrush}" 
                                                                   VerticalAlignment="Center" 
                                                                   Margin="4,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </TreeDataTemplate>

                                            <DataTemplate DataType="vm:TableTreeNode">
                                                <Border Classes="table-node-item"
                                                        Classes.active="{Binding IsActive}"
                                                        PointerPressed="OnTableNodePointerPressed"
                                                        Padding="4,2" 
                                                        Margin="0,1" 
                                                        CornerRadius="3"
                                                        Background="Transparent">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Select TOP 100 Rows" Command="{Binding ExecuteTop100Command}">
                                                                <MenuItem.Icon>
                                                                    <ui:FASymbolIcon Symbol="Play" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="Copy Table Name" Command="{Binding CopyTableNameCommand}">
                                                                <MenuItem.Icon>
                                                                    <ui:FASymbolIcon Symbol="Copy" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid ColumnDefinitions="Auto, *">
                                                        <ic:SymbolIcon Grid.Column="0" 
                                                                       Symbol="Table" 
                                                                       Classes="table-icon"
                                                                       FontSize="12" 
                                                                       Margin="0,0,6,0" 
                                                                       VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" 
                                                                   Classes="table-name"
                                                                   Text="{Binding TableName}" 
                                                                   FontSize="11" 
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>

                                            <DataTemplate DataType="vm:PlaceholderTreeNode">
                                                <TextBlock Text="{Binding Title}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" Margin="8,2"/>
                                            </DataTemplate>
                                        </TreeView.DataTemplates>
                                    </TreeView>
                                </ScrollViewer>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding !FilteredDatabaseNodes.Count}">
                                    <TextBlock Text="No databases or tables found" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- ======================================================== -->
                        <!-- TAB 3: HISTORY VIEW (Recent Query History List)          -->
                        <!-- ======================================================== -->
                        <Grid Margin="0" IsVisible="{Binding IsHistoryTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,6">
                                <ItemsControl ItemsSource="{Binding HistoryItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="history-item" Cursor="Hand" CornerRadius="4" Padding="6,4" Margin="0,1" Background="Transparent">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <Button Grid.Column="0" 
                                                            Background="Transparent" 
                                                            BorderThickness="0" 
                                                            Padding="0" 
                                                            HorizontalAlignment="Stretch" 
                                                            HorizontalContentAlignment="Left"
                                                            Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SelectHistoryItemCommand}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding QueryText}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding ExecutedAt}" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Border Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ExecutionTime}" FontSize="9" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
