<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Fdb.ViewModels"
              mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="26"
              x:Class="Fdb.Components.MainMenuBarComponent"
              x:DataType="vm:NavbarViewModel">

    <!-- Native Desktop MenuBar (File, Edit, View, Window, Help) + Brand & Connection Badge -->
    <Border Background="{DynamicResource AppBackgroundBrush}" 
            BorderBrush="{DynamicResource AppBorderLightBrush}" 
            BorderThickness="0,0,0,1" 
            Height="26" 
            Padding="6,0">
        <Grid ColumnDefinitions="Auto, *, Auto">
            <!-- Brand Icon/Title + Menu -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- Project Brand Logo -->
                <Border CornerRadius="4" ClipToBounds="True" Width="18" Height="18" Margin="0,0,6,0">
                    <Image Source="avares://Fdb/Assets/fdb_icon.png" 
                           Width="18" Height="18" 
                           Stretch="Uniform" 
                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                </Border>
                <TextBlock Text="{Binding Title}" 
                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                           FontWeight="Bold" 
                           FontSize="12" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"/>

                <!-- Native Menu Dropdown System -->
                <Menu Background="Transparent" FocusAdorner="{x:Null}">
                    <!-- File Menu -->
                    <MenuItem Header="File">
                        <MenuItem Header="Connect to Database..." 
                                  InputGesture="Ctrl+Shift+C"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectModal.OpenCommand}" />
                        <MenuItem Header="Export Results to File..." 
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ExportModal.OpenCommand}" />
                        <Separator />
                        <MenuItem Header="New Query" 
                                  InputGesture="Ctrl+N" 
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Editor.AddTabCommand}" />
                        <MenuItem Header="Save" 
                                  InputGesture="Ctrl+S" 
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SaveQueryCommand}" />
                        <Separator />
                        <MenuItem Header="Settings..." 
                                  InputGesture="Ctrl+," 
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SettingsModal.OpenCommand}" />
                        <Separator />
                        <MenuItem Header="Exit" 
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ExitCommand}" />
                    </MenuItem>

                    <!-- Edit Menu -->
                    <MenuItem Header="Edit">
                        <MenuItem Header="Undo" InputGesture="Ctrl+Z" />
                        <MenuItem Header="Redo" InputGesture="Ctrl+Y" />
                        <Separator />
                        <MenuItem Header="Cut" InputGesture="Ctrl+X" />
                        <MenuItem Header="Copy" InputGesture="Ctrl+C" />
                        <MenuItem Header="Paste" InputGesture="Ctrl+V" />
                    </MenuItem>

                    <!-- View Menu -->
                    <MenuItem Header="View">
                        <MenuItem Header="Object Explorer (Sidebar)" 
                                  InputGesture="Ctrl+B"
                                  HotKey="Ctrl+B"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleSidebarCommand}" />
                        <MenuItem Header="Output &amp; Results (Footer)" 
                                  InputGesture="Ctrl+J"
                                  HotKey="Ctrl+J"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleFooterCommand}" />
                        <Separator />
                        <MenuItem Header="Integrated Terminal" 
                                  InputGesture="Ctrl+Oem3"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleTerminalCommand}" />
                    </MenuItem>

                    <!-- Window / Workspace Menu (Restore Tabs & Panels) -->
                    <MenuItem Header="Window">
                        <MenuItem Header="Show Object Explorer" 
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowSidebarCommand}" />
                        <MenuItem Header="Show Output &amp; Results" 
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowFooterCommand}" />
                        <Separator />
                        <MenuItem Header="Restore Footer Tabs">
                            <MenuItem Header="Results" 
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreFooterTabCommand}" 
                                      CommandParameter="Results" />
                            <MenuItem Header="Terminal" 
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreFooterTabCommand}" 
                                      CommandParameter="Terminal" />
                        </MenuItem>
                        <MenuItem Header="Restore Sidebar Tabs">
                            <MenuItem Header="Explorer" 
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreSidebarTabCommand}" 
                                      CommandParameter="Explorer" />
                            <MenuItem Header="Databases" 
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreSidebarTabCommand}" 
                                      CommandParameter="Databases" />
                            <MenuItem Header="History" 
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreSidebarTabCommand}" 
                                      CommandParameter="History" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Reset Window Layout" 
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ResetLayoutCommand}" />
                    </MenuItem>

                    <!-- Help Menu -->
                    <MenuItem Header="Help">
                        <MenuItem Header="Documentation" />
                        <MenuItem Header="About Fdb Studio" />
                    </MenuItem>
                </Menu>
            </StackPanel>

            <!-- Right Info / Status -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,6,0">
                <!-- Connection Status Pill -->
                <Border Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="8,2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="{Binding ConnectionDotColor}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectionStatusText}" 
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                   FontSize="11" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
