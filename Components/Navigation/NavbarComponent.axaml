<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Fdb.ViewModels"
              xmlns:components="using:Fdb.Components"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
              mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="54"
              x:Class="Fdb.Components.NavbarComponent"
              x:DataType="vm:NavbarViewModel">

    <!-- Composed Navbar Component: MainMenuBarComponent + Action Toolbar Row -->
    <Border Background="{DynamicResource AppBackgroundBrush}" 
            BorderBrush="{DynamicResource AppBorderBrush}" 
            BorderThickness="0,0,0,1">
        <StackPanel Orientation="Vertical">
            <!-- 1. Native Desktop MenuBar Component -->
            <components:MainMenuBarComponent DataContext="{Binding}" />

            <!-- 2. Standard Action Toolbar Row -->
            <Border Background="{DynamicResource AppSurfaceBrush}" Height="28" Padding="6,2">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Background="{DynamicResource AppAccentBrush}" 
                            Foreground="White" 
                            FontWeight="SemiBold" 
                            FontSize="11" 
                            CornerRadius="4" 
                            Padding="10,4"
                            Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ExecuteQueryCommand}"
                            ToolTip.Tip="Execute active SQL query (F5)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Play" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Run (F5)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="classic-tool-btn"
                            Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).Editor.AddTabCommand}"
                            ToolTip.Tip="Open New Query Tab (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Add" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="New Query" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="classic-tool-btn"
                            Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).SaveQueryCommand}"
                            ToolTip.Tip="Save Query to SQLite Storage (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Save" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="16" Background="{DynamicResource AppBorderBrush}" Margin="4,0"/>

                    <!-- Target Database Selector ComboBox -->
                    <Border Background="{DynamicResource AppWorkspaceBrush}" 
                            BorderBrush="{DynamicResource AppBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Height="24" 
                            Padding="4,0" 
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Folder" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="DB:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).AvailableTargetDatabases}"
                                      SelectedItem="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).SelectedTargetDatabase}"
                                      PlaceholderText="No Active Database"
                                      FontSize="11"
                                      Height="22"
                                      Padding="4,1"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      MinWidth="190"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Background="{Binding BadgeColor}" CornerRadius="3" Padding="4,1">
                                                <TextBlock Text="{Binding DatabaseType}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding FullDisplayName}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Border Width="1" Height="16" Background="{DynamicResource AppBorderBrush}" Margin="4,0"/>

                    <Button x:Name="ConnectButton"
                            Classes="classic-tool-btn" 
                            Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ConnectModal.OpenCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Link" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Connect..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="classic-tool-btn"
                            Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).DisconnectCommand}"
                            ToolTip.Tip="Disconnect from active database session">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="Disconnect" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
