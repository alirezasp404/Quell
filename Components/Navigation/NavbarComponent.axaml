<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:components="using:Quell.Components"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="36"
             x:Class="Quell.Components.NavbarComponent"
             x:DataType="vm:NavbarViewModel">

    <UserControl.Styles>
        <!-- Window Chrome Button Styling -->
        <Style Selector="Button.win-control-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.win-control-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.win-control-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource AppTabHoverBackgroundBrush}"/>
        </Style>

        <!-- Close Button (Windows Standard Red Hover) -->
        <Style Selector="Button.win-close-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.win-close-btn:pointerover">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.win-close-btn:pressed">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Hamburger Menu Toggle Button Styling -->
        <Style Selector="Button.hamburger-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.hamburger-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Button.hamburger-btn.active-menu">
            <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- GPU-Accelerated Hamburger Icon Transform Pipeline -->
        <Style Selector=":is(TopLevel).gpu-mode Button.hamburger-btn PathIcon.hamburger-icon">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.20"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.hamburger-btn.active-menu PathIcon.hamburger-icon">
            <Setter Property="RenderTransform" Value="rotate(90deg)"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- Animated Navbar Menu Items Container (Closed / Base State) -->
        <Style Selector="Border.nav-menu-bar-container">
            <Setter Property="MaxWidth" Value="0"/>
            <Setter Property="Opacity" Value="0.0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="0%,50%"/>
            <Setter Property="RenderTransform" Value="translateX(-18px) scale(0.95)"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <!-- Animated Navbar Menu Items Container (Open / Active State) -->
        <Style Selector="Border.nav-menu-bar-container.menu-open">
            <Setter Property="MaxWidth" Value="480"/>
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="RenderTransform" Value="translateX(0px) scale(1.0)"/>
        </Style>

        <!-- GPU-Accelerated Fluid Motion Pipeline for Navbar Menu Container (Skia DirectX 11 / ANGLE hardware pipeline) -->
        <Style Selector=":is(TopLevel).gpu-mode Border.nav-menu-bar-container">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="MaxWidth" Duration="0:0:0.32" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- CPU Software Mode: Lightweight & Fast Transitions (0 lag on basic software rasterizer) -->
        <Style Selector=":is(TopLevel):not(.gpu-mode) Border.nav-menu-bar-container">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="MaxWidth" Duration="0:0:0.12" Easing="LinearEasing"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.10" Easing="LinearEasing"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="LinearEasing"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Top-Level Menu Items in Navbar Strip -->
        <Style Selector="Menu.navbar-menu-strip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Menu.navbar-menu-strip > MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Menu.navbar-menu-strip > MenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="Menu.navbar-menu-strip > MenuItem:open">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- GPU-Accelerated Micro-Interactions on Top-Level Menu Items -->
        <Style Selector=":is(TopLevel).gpu-mode Menu.navbar-menu-strip > MenuItem">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.20" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector=":is(TopLevel).gpu-mode Menu.navbar-menu-strip > MenuItem:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04) translateY(-1px)"/>
        </Style>
        <Style Selector=":is(TopLevel).gpu-mode Menu.navbar-menu-strip > MenuItem:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)"/>
        </Style>

        <!-- Dropdown Popup Border & Shadow Styling -->
        <Style Selector="Menu.navbar-menu-strip MenuItem /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BoxShadow" Value="0 8 24 0 #40000000"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <!-- Compact Action Button in Title Bar -->
        <Style Selector="Button.titlebar-action-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.titlebar-action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- ========================================================================= -->
        <!-- Responsive Adaptive Layout Styles                                         -->
        <!-- ========================================================================= -->

        <!-- 1. Medium Breakpoint: Hide action button text labels (icons remain with ToolTips) -->
        <Style Selector="UserControl.responsive-medium TextBlock.action-btn-text">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="UserControl.responsive-medium Border.target-db-pill ComboBox">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MaxWidth" Value="140"/>
        </Style>

        <!-- 2. Compact Breakpoint: Compact DB selector and icon-only connection dot -->
        <Style Selector="UserControl.responsive-compact TextBlock.action-btn-text">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="UserControl.responsive-compact TextBlock.conn-status-text">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="UserControl.responsive-compact Border.target-db-pill ComboBox">
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="MaxWidth" Value="110"/>
        </Style>

        <!-- 3. Minimal Breakpoint: Minimal title & hide secondary buttons -->
        <Style Selector="UserControl.responsive-minimal TextBlock.action-btn-text">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="UserControl.responsive-minimal TextBlock.app-title-text">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="UserControl.responsive-minimal TextBlock.conn-status-text">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="UserControl.responsive-minimal TextBlock.db-label-text">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="UserControl.responsive-minimal Button.disconnect-btn">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="UserControl.responsive-minimal Border.target-db-pill ComboBox">
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="MaxWidth" Value="90"/>
        </Style>
    </UserControl.Styles>

    <!-- Unified Modern Desktop IDE Custom Title Bar & Navigation Bar (Height: 36px) -->
    <Border Background="{DynamicResource AppBackgroundBrush}" 
            BorderBrush="{DynamicResource AppBorderBrush}" 
            BorderThickness="0,0,0,1" 
            Height="36"
            PointerPressed="OnTitleBarPointerPressed">
        <!-- 4-Column Responsive Layout: Left Menu, Flexible Action Tools, Connection Status, Pinned Window Controls -->
        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
            
            <!-- 1. Left Area: Brand Logo, App Title, Hamburger Toggle Button & GPU-Animated Navbar Menu Strip -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,4,0">
                <!-- App Logo -->
                <Border CornerRadius="4" ClipToBounds="True" Width="18" Height="18" Margin="0,0,4,0">
                    <Image Source="avares://Quell/Assets/quell_icon.png" 
                           Width="18" Height="18" 
                           Stretch="Uniform" 
                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                </Border>
                
                <!-- App Title -->
                <TextBlock Classes="app-title-text"
                           Text="Quell" 
                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                           FontWeight="Bold" 
                           FontSize="11" 
                           VerticalAlignment="Center" 
                           Margin="0,0,6,0"/>

                <Border Width="1" Height="14" Background="{DynamicResource AppBorderBrush}" Margin="2,0,4,0" VerticalAlignment="Center"/>

                <!-- Hamburger Menu Toggle Button (Hardware-Accelerated Icon Motion) -->
                <Button x:Name="HamburgerButton"
                        Classes="hamburger-btn"
                        Click="OnHamburgerClicked"
                        ToolTip.Tip="{Binding GpuTooltipText}">
                    <Panel Width="14" Height="14">
                        <PathIcon x:Name="HamburgerIcon"
                                  Classes="hamburger-icon"
                                  Data="M2 3.5h12v1.5H2zm0 3.75h12v1.5H2zm0 3.75h12v1.5H2z"
                                  Width="12" Height="11"
                                  Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    </Panel>
                </Button>

                <!-- Animated Navbar Menu Items Container (Slides & Glides fluidly into navbar) -->
                <Border x:Name="NavMenuContainer" 
                        Classes="nav-menu-bar-container"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Menu x:Name="NavMenuBar" 
                          Classes="navbar-menu-strip" 
                          Background="Transparent" 
                          FocusAdorner="{x:Null}" 
                          VerticalAlignment="Center">
                        
                        <!-- File Menu -->
                        <MenuItem x:Name="MenuFile" Classes="nav-item nav-item-1" Header="File" FontSize="11">
                            <MenuItem.Icon>
                                <ui:FASymbolIcon Symbol="Folder" FontSize="11" />
                            </MenuItem.Icon>
                            <MenuItem Header="Connect to Database..." 
                                      InputGesture="Ctrl+Shift+C"
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ConnectModal.OpenCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Link" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Export Results to File..." 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ExportModal.OpenCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Download" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="New Query" 
                                      InputGesture="Ctrl+N" 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).Editor.AddTabCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Add" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Save" 
                                      InputGesture="Ctrl+S" 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).SaveQueryCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Save" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Settings..." 
                                      InputGesture="Ctrl+," 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).SettingsModal.OpenCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Settings" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Exit" 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ExitCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <!-- Edit Menu -->
                        <MenuItem x:Name="MenuEdit" Classes="nav-item nav-item-2" Header="Edit" FontSize="11">
                            <MenuItem.Icon>
                                <ui:FASymbolIcon Symbol="Edit" FontSize="11" />
                            </MenuItem.Icon>
                            <MenuItem Header="Undo" InputGesture="Ctrl+Z" />
                            <MenuItem Header="Redo" InputGesture="Ctrl+Y" />
                            <Separator />
                            <MenuItem Header="Cut" InputGesture="Ctrl+X" />
                            <MenuItem Header="Copy" InputGesture="Ctrl+C" />
                            <MenuItem Header="Paste" InputGesture="Ctrl+V" />
                        </MenuItem>

                        <!-- Database Management & Tools Menu -->
                        <MenuItem x:Name="MenuDatabase" Classes="nav-item nav-item-3" Header="Database" FontSize="11">
                            <MenuItem.Icon>
                                <ui:FASymbolIcon Symbol="Folder" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                            </MenuItem.Icon>

                            <!-- Connection Management -->
                            <MenuItem Header="Connect to Database..." 
                                      InputGesture="Ctrl+Shift+C"
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ConnectModal.OpenCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Link" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Disconnect Active Session" 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).DisconnectCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Refresh Schema &amp; Tables" 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).RefreshDatabaseSchemaCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Sync" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>

                            <Separator />

                            <!-- Data Export & Excel -->
                            <MenuItem Header="Export Table Data..." 
                                      InputGesture="Ctrl+E"
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).OpenExportTableModalCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Download" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Create Excel from Table (*.xlsx)..." 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).QuickExportExcelCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Document" FontSize="11" Foreground="#10B981"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <Separator />

                            <!-- Backup & Restore -->
                            <MenuItem Header="Backup Database (.sql dump)..." 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).BackupDatabaseCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Save" FontSize="11" Foreground="#38BDF8"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Restore Database from Backup..." 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).RestoreDatabaseCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Sync" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>

                            <Separator />

                            <!-- ER Diagram & Schema Relations -->
                            <MenuItem Header="ER Diagram &amp; Schema Relations..." 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).OpenDiagramModalCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Preview" FontSize="11" Foreground="#F59E0B"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="View Table Schema &amp; Properties" 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ShowTablePropertiesCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Tag" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Generate DDL Script (CREATE TABLE)" 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).GenerateTableDdlCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Code" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>

                            <Separator />

                            <!-- Maintenance -->
                            <MenuItem Header="Optimize &amp; Vacuum Database" 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).OptimizeDatabaseCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Settings" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <!-- View Menu -->
                        <MenuItem x:Name="MenuView" Classes="nav-item nav-item-4" Header="View" FontSize="11">
                            <MenuItem.Icon>
                                <ui:FASymbolIcon Symbol="FullScreen" FontSize="11" />
                            </MenuItem.Icon>
                            <MenuItem Header="Object Explorer (Sidebar)" 
                                      InputGesture="Ctrl+B"
                                      HotKey="Ctrl+B"
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ToggleSidebarCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Folder" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Output &amp; Results (Footer)" 
                                      InputGesture="Ctrl+J"
                                      HotKey="Ctrl+J"
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ToggleFooterCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Document" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Integrated Terminal" 
                                      InputGesture="Ctrl+Oem3"
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ToggleTerminalCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Code" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <!-- Window / Workspace Menu -->
                        <MenuItem x:Name="MenuWindow" Classes="nav-item nav-item-5" Header="Window" FontSize="11">
                            <MenuItem.Icon>
                                <ui:FASymbolIcon Symbol="Globe" FontSize="11" />
                            </MenuItem.Icon>
                            <MenuItem Header="Show Object Explorer" 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ShowSidebarCommand}" />
                            <MenuItem Header="Show Output &amp; Results" 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ShowFooterCommand}" />
                            <Separator />
                            <MenuItem Header="Restore Footer Tabs">
                                <MenuItem Header="Results" 
                                          Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).RestoreFooterTabCommand}" 
                                          CommandParameter="Results" />
                                <MenuItem Header="Terminal" 
                                          Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).RestoreFooterTabCommand}" 
                                          CommandParameter="Terminal" />
                            </MenuItem>
                            <MenuItem Header="Restore Sidebar Tabs">
                                <MenuItem Header="Explorer" 
                                          Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).RestoreSidebarTabCommand}" 
                                          CommandParameter="Explorer" />
                                <MenuItem Header="Databases" 
                                          Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).RestoreSidebarTabCommand}" 
                                          CommandParameter="Databases" />
                                <MenuItem Header="History" 
                                          Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).RestoreSidebarTabCommand}" 
                                          CommandParameter="History" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Reset Window Layout" 
                                      Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ResetLayoutCommand}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Sync" FontSize="11" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <!-- Help Menu -->
                        <MenuItem x:Name="MenuHelp" Classes="nav-item nav-item-6" Header="Help" FontSize="11">
                            <MenuItem.Icon>
                                <ui:FASymbolIcon Symbol="Important" FontSize="11" />
                            </MenuItem.Icon>
                            <MenuItem Header="Documentation" />
                            <MenuItem Header="About Quell" />
                        </MenuItem>
                    </Menu>
                </Border>
            </StackPanel>

            <!-- 2. Center Area: Core Action Tools Strip + Draggable Spacer (Takes remaining width: *) -->
            <Grid Grid.Column="1" ColumnDefinitions="Auto, *" VerticalAlignment="Stretch" Margin="6,0">
                <!-- Action Tools Strip (Adapts gracefully across responsive breakpoints) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Border Width="1" Height="16" Background="{DynamicResource AppBorderBrush}" Margin="2,0,6,0" VerticalAlignment="Center"/>

                    <!-- Run Query Button (Accent Primary) -->
                    <Button Classes="run-query-btn"
                            Background="{DynamicResource AppAccentBrush}" 
                            Foreground="White" 
                            FontWeight="SemiBold" 
                            FontSize="11" 
                            CornerRadius="4" 
                            Height="24"
                            Padding="8,2"
                            FocusAdorner="{x:Null}"
                            Cursor="Hand"
                            Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ExecuteQueryCommand}"
                            ToolTip.Tip="Execute active SQL query (F5)">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Play" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Classes="action-btn-text" Text="Run (F5)" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- New Query Tab Button -->
                    <Button Classes="titlebar-action-btn"
                            Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).Editor.AddTabCommand}"
                            ToolTip.Tip="Open New Query Tab (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Add" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Classes="action-btn-text" Text="New" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Save Query Button -->
                    <Button Classes="titlebar-action-btn"
                            Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).SaveQueryCommand}"
                            ToolTip.Tip="Save Query to SQLite Storage (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Save" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Classes="action-btn-text" Text="Save" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="14" Background="{DynamicResource AppBorderBrush}" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- Target Database Selector ComboBox -->
                    <Border Classes="target-db-pill"
                            Background="{DynamicResource AppSurfaceBrush}" 
                            BorderBrush="{DynamicResource AppBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Height="24" 
                            Padding="4,0" 
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Folder" FontSize="10" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Classes="db-label-text" Text="DB:" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).AvailableTargetDatabases}"
                                      SelectedItem="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).SelectedTargetDatabase}"
                                      PlaceholderText="No Active Database"
                                      FontSize="11"
                                      Height="22"
                                      Padding="4,0"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      MinWidth="160"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Background="{Binding BadgeColor}" CornerRadius="3" Padding="4,1">
                                                <TextBlock Text="{Binding DatabaseType}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding FullDisplayName}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Width="1" Height="14" Background="{DynamicResource AppBorderBrush}" Margin="4,0" VerticalAlignment="Center"/>

                    <!-- Connect Button (x:Name="ConnectButton" preserved for verification suite) -->
                    <Button x:Name="ConnectButton"
                            Classes="titlebar-action-btn" 
                            Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).ConnectModal.OpenCommand}"
                            ToolTip.Tip="Connect to Database (Ctrl+Shift+C)">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Link" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Classes="action-btn-text" Text="Connect..." FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Disconnect Button -->
                    <Button Classes="titlebar-action-btn disconnect-btn"
                            Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).DisconnectCommand}"
                            ToolTip.Tip="Disconnect from active database session">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Classes="action-btn-text" Text="Disconnect" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Center Draggable Area (Takes all remaining width) -->
                <Panel Grid.Column="1" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
            </Grid>

            <!-- 3. Right: Connection Status Badge -->
            <StackPanel Grid.Column="2" Classes="conn-badge-panel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                <Border Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="6,2">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{Binding ConnectionDotColor}" VerticalAlignment="Center"/>
                        <TextBlock Classes="conn-status-text"
                                   Text="{Binding ConnectionStatusText}" 
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                   FontSize="10" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 4. Far Right: Native-Style Window Control Buttons (Minimize, Maximize/Restore, Close - ALWAYS Pinned & Visible) -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
                <!-- Minimize Button -->
                <Button x:Name="MinimizeButton"
                        Classes="win-control-btn"
                        Click="OnMinimizeClicked"
                        ToolTip.Tip="Minimize">
                    <PathIcon Data="M2 11h10v1H2z" Width="10" Height="10" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                </Button>

                <!-- Maximize / Restore Button -->
                <Button x:Name="MaximizeButton"
                        Classes="win-control-btn"
                        Click="OnMaximizeClicked"
                        ToolTip.Tip="Maximize / Restore">
                    <Panel>
                        <!-- Maximize Icon (Normal State) -->
                        <PathIcon x:Name="MaximizeIcon"
                                  Data="M2 2h10v10H2V2zm1 1v8h8V3H3z"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource AppTextSecondaryBrush}"
                                  IsVisible="True"/>
                        <!-- Restore Icon (Maximized State) -->
                        <PathIcon x:Name="RestoreIcon"
                                  Data="M4 2h8v8h-2v2H2V4h2V2zm1 1v1h5v5h1V3H5zM3 5v6h6V5H3z"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource AppTextSecondaryBrush}"
                                  IsVisible="False"/>
                    </Panel>
                </Button>

                <!-- Close Button -->
                <Button x:Name="CloseButton"
                        Classes="win-close-btn"
                        Click="OnCloseClicked"
                        ToolTip.Tip="Close (Alt+F4)">
                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
