<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:models="using:Quell.Models"
             xmlns:components="using:Quell.Components"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="250"
             x:Class="Quell.Components.TerminalComponent"
             x:DataType="vm:TerminalViewModel"
             Background="{DynamicResource AppWorkspaceBrush}">

    <UserControl.Styles>
        <!-- Modern Terminal Tab Styling (Synchronized with Theme System) -->
        <Style Selector="Button.modern-terminal-tab">
            <Setter Property="Background" Value="{DynamicResource AppTerminalTabBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTerminalTabBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,3,6,3"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.modern-terminal-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppTabHoverBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderDarkBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.modern-terminal-tab.active">
            <Setter Property="Background" Value="{DynamicResource AppTerminalTabActiveBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTerminalTabActiveBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Modern Action Toolbar Button Styling -->
        <Style Selector="Button.terminal-action-btn">
            <Setter Property="Background" Value="{DynamicResource AppButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource AppButtonForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.terminal-action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>

        <!-- Quick Launch Card Styling -->
        <Style Selector="Border.quick-launch-card">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style Selector="Border.quick-launch-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppTabHoverBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <!-- 1. Dedicated Modern Terminal Session Bar (Synchronized with Theme System) -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppTerminalToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource AppTerminalToolbarBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                MinHeight="36">
            <Grid ColumnDefinitions="Auto, *, Auto">
                
                <!-- Left: Sessions Tab Strip & Add Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TerminalSessionViewModel">
                                <Button Classes="modern-terminal-tab"
                                        Classes.active="{Binding IsActive}"
                                        Command="{Binding $parent[UserControl].((vm:TerminalViewModel)DataContext).SelectSessionCommand}"
                                        CommandParameter="{Binding}">
                                    <!-- Right-Click Context Menu -->
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Close" 
                                                      Command="{Binding CloseSessionCommand}">
                                                <MenuItem.Icon>
                                                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="11" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Restart Shell" 
                                                      Command="{Binding RestartSessionCommand}">
                                                <MenuItem.Icon>
                                                    <ui:FASymbolIcon Symbol="Sync" FontSize="11" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <!-- Shell Icon -->
                                        <ui:FASymbolIcon Symbol="Play" FontSize="10" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" />

                                        <!-- Title -->
                                        <TextBlock Text="{Binding Title}" FontSize="11" VerticalAlignment="Center" />

                                        <!-- Live Status Dot -->
                                        <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" IsVisible="{Binding IsRunning}" ToolTip.Tip="Running" />
                                        <Ellipse Width="6" Height="6" Fill="#64748B" VerticalAlignment="Center" IsVisible="{Binding !IsRunning}" ToolTip.Tip="Stopped" />

                                        <!-- Circular Close Button -->
                                        <Button Classes="terminal-action-btn"
                                                Width="16" Height="16" Padding="0" CornerRadius="8"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                ToolTip.Tip="Close session"
                                                Command="{Binding CloseSessionCommand}"
                                                VerticalAlignment="Center">
                                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="8" Foreground="{DynamicResource AppTextMutedBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add Terminal Split-Button -->
                    <Border Background="{DynamicResource AppButtonBackgroundBrush}"
                            BorderBrush="{DynamicResource AppButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Click to instantly open Default Shell -->
                            <Button Classes="terminal-action-btn"
                                    Height="26"
                                    Padding="8,2"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    ToolTip.Tip="New Terminal (Default Shell)"
                                    Command="{Binding NewSessionCommand}"
                                    CommandParameter="{x:Null}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <ui:FASymbolIcon Symbol="Add" FontSize="10" Foreground="{DynamicResource AppAccentBrush}" />
                                    <TextBlock Text="New" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppButtonForegroundBrush}" />
                                </StackPanel>
                            </Button>

                            <Rectangle Width="1" Fill="{DynamicResource AppBorderBrush}" VerticalAlignment="Stretch" />

                            <!-- Dropdown Chevron for CLI and shell selection -->
                            <Button Classes="terminal-action-btn"
                                    Height="26"
                                    Width="18"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    ToolTip.Tip="Select Terminal Shell">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Default Shell" Command="{Binding NewSessionCommand}" CommandParameter="{x:Null}">
                                            <MenuItem.Icon>
                                                <ui:FASymbolIcon Symbol="Play" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <ui:FASymbolIcon Symbol="ChevronDown" FontSize="8" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Action Toolbar (Theme-Aware Unified Styling) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Quick DB CLI Launcher Badge -->
                    <Button Classes="classic-accent-btn"
                            Height="26"
                            Padding="8,3"
                            IsVisible="{Binding HasActiveConnection}"
                            Command="{Binding LaunchDatabaseCliCommand}"
                            CommandParameter="{x:Null}"
                            ToolTip.Tip="Launch pre-connected CLI tool for active database">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Sync" FontSize="10" />
                            <TextBlock Text="{Binding ActiveConnectionBadge}" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Clear Screen Buffer -->
                    <Button Classes="terminal-action-btn"
                            Command="{Binding ClearActiveBufferCommand}"
                            ToolTip.Tip="Clear Terminal Screen (Ctrl+L)">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Clear" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" />
                            <TextBlock Text="Clear" FontSize="11" Foreground="{DynamicResource AppButtonForegroundBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Restart Active Session -->
                    <Button Classes="terminal-action-btn"
                            Command="{Binding ActiveSession.RestartSessionCommand}"
                            ToolTip.Tip="Restart Active Shell">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Sync" FontSize="11" Foreground="#10B981" />
                            <TextBlock Text="Restart" FontSize="11" Foreground="{DynamicResource AppButtonForegroundBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Maximize / Restore Terminal -->
                    <Button Classes="terminal-action-btn"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Footer.ToggleMaximizeCommand}"
                            ToolTip.Tip="Toggle Terminal Fullscreen / Maximize">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="FullScreen" FontSize="11" Foreground="#F59E0B" />
                            <TextBlock Text="Maximize" FontSize="11" Foreground="{DynamicResource AppButtonForegroundBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Kill Active Session -->
                    <Button Classes="terminal-action-btn"
                            Command="{Binding CloseSessionCommand}"
                            CommandParameter="{x:Null}"
                            ToolTip.Tip="Terminate active terminal process">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="10" Foreground="#EF4444" />
                            <TextBlock Text="Kill" FontSize="11" Foreground="#EF4444" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Terminal Sessions Body Host -->
        <Grid Grid.Row="1">
            <!-- Persistent Sessions Host (stacks all views, only active session view is visible) -->
            <Grid x:Name="SessionsHost" />

            <!-- Modern Hero Empty State when no sessions exist -->
            <Border IsVisible="{Binding !Sessions.Count}"
                    Background="{DynamicResource AppWorkspaceBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="540">
                    <!-- Icon & Titles -->
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Play" FontSize="20" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Integrated Terminal"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Fast, isolated command line &amp; database CLI environments"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Quick-Launch Cards Grid -->
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" Margin="0,4,0,0">
                        <!-- Card 1: Default Shell -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Classes="quick-launch-card"
                                Margin="4">
                            <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding NewSessionCommand}" CommandParameter="{x:Null}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{DynamicResource AppSurfaceMutedBrush}" Margin="0,0,10,0">
                                        <ui:FASymbolIcon Symbol="Play" FontSize="14" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Default Shell" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="Launch configured default system shell" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Card 2: Database CLI -->
                        <Border Grid.Row="0" Grid.Column="1"
                                Classes="quick-launch-card"
                                Margin="4">
                            <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding LaunchDatabaseCliCommand}" CommandParameter="{x:Null}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{DynamicResource AppSurfaceMutedBrush}" Margin="0,0,10,0">
                                        <ui:FASymbolIcon Symbol="Sync" FontSize="14" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Database CLI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="Pre-connected CLI for active connection" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Card 3: New Terminal -->
                        <Border Grid.Row="1" Grid.Column="0"
                                Classes="quick-launch-card"
                                Margin="4">
                            <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding NewSessionCommand}" CommandParameter="{x:Null}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{DynamicResource AppSurfaceMutedBrush}" Margin="0,0,10,0">
                                        <ui:FASymbolIcon Symbol="Code" FontSize="14" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="New Terminal" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="Standard command line prompt" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Card 4: Terminal Settings -->
                        <Border Grid.Row="1" Grid.Column="1"
                                Classes="quick-launch-card"
                                Margin="4">
                            <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SettingsModal.OpenCommand}" CommandParameter="{x:Null}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{DynamicResource AppSurfaceMutedBrush}" Margin="0,0,10,0">
                                        <ui:FASymbolIcon Symbol="Settings" FontSize="14" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Configure Terminal" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="Shells, fonts, and CLI executable paths" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
