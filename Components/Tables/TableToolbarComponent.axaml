<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Fdb.ViewModels"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="30"
              x:Class="Fdb.Components.TableToolbarComponent"
              x:DataType="vm:QueryResultTableViewModel">

    <!-- Reusable Table Toolbar Component (Filter, Refresh, Execution Stats, Export) -->
    <Border Background="{DynamicResource AppSurfaceBrush}" 
            BorderBrush="{DynamicResource AppBorderBrush}" 
            BorderThickness="0,0,0,1" 
            Padding="6,2">
        <Grid ColumnDefinitions="Auto, *, Auto">
            <!-- Left: Search Filter & Refresh -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBox Width="180" 
                         Height="23" 
                         FontSize="11" 
                         Padding="6,2" 
                         CornerRadius="4" 
                         PlaceholderText="Filter table rows..." 
                         Text="{Binding SearchFilter}"/>
                <Button Classes="classic-tool-btn" 
                        Command="{Binding RefreshCommand}" 
                        IsEnabled="{Binding !IsRefreshing}"
                        Height="23" 
                        Padding="6,2" 
                        ToolTip.Tip="Refresh table data from database (F5)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ui:FASymbolIcon Symbol="Refresh" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="classic-tool-btn" Command="{Binding OpenEditSelectedCellCommand}" Height="23" Padding="6,2" ToolTip.Tip="Edit selected cell graphically &amp; execute UPDATE (F2)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ui:FASymbolIcon Symbol="Edit" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Edit Cell..." VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes="classic-tool-btn" Command="{Binding DeleteSelectedRowCommand}" Height="23" Padding="6,2" ToolTip.Tip="Delete selected row with safety confirmation &amp; live SQL (Del)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ui:FASymbolIcon Symbol="Delete" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center"/>
                        <TextBlock Text="Delete Row" Foreground="#EF4444" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Middle: Query Generation / Execution Pill -->
            <Border Grid.Column="1" 
                    Margin="8,0" 
                    IsVisible="{Binding HasLastQueryMessage}"
                    Background="{DynamicResource AppSurfaceBrush}" 
                    BorderBrush="{DynamicResource AppBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="6,1"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:FASymbolIcon Symbol="Checkmark" FontSize="11" Foreground="#10B981" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LastQueryMessage}" 
                               FontSize="11" 
                               Foreground="{DynamicResource AppTextSecondaryBrush}" 
                               VerticalAlignment="Center" 
                               MaxWidth="350"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Classes="classic-tool-btn" 
                            Command="{Binding DismissMessageCommand}" 
                            Padding="2,0" 
                            BorderThickness="0" 
                            Background="Transparent">
                        <ui:FASymbolIcon Symbol="Dismiss" FontSize="9"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right: Execution Stats & Export -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Target Database Badge -->
                <Border Background="{DynamicResource AppWorkspaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Height="23"
                        Padding="8,1">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ui:FASymbolIcon Symbol="Folder" FontSize="11" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TargetDatabaseName}" 
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                   FontWeight="SemiBold"
                                   FontSize="11" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Primary Key Badge (Distinct Golden Pill) -->
                <Border Background="{DynamicResource AppTablePkBadgeBackgroundBrush}" 
                        BorderBrush="{DynamicResource AppTablePkBadgeBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Height="23"
                        Padding="8,1"
                        IsVisible="{Binding HasPrimaryKey}"
                        ToolTip.Tip="Primary Key column in current table">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" Width="10" Height="10" Foreground="{DynamicResource AppTablePkColumnForegroundBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="PK:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTablePkBadgeForegroundBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PrimaryKeyColumnName}" 
                                   Foreground="{DynamicResource AppTablePkColumnForegroundBrush}" 
                                   FontWeight="Bold" 
                                   FontSize="11" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Execution Time Badge -->
                <Border Background="{DynamicResource AppWorkspaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Height="23"
                        Padding="8,1">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ui:FASymbolIcon Symbol="Clock" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ExecutionTime}" 
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                   FontSize="11" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Row Count Badge -->
                <Border Background="{DynamicResource AppWorkspaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Height="23"
                        Padding="8,1">
                    <TextBlock Text="{Binding TotalRows, StringFormat='{}{0} rows'}" 
                               Foreground="{DynamicResource AppTextSecondaryBrush}" 
                               FontSize="11" 
                               FontWeight="Medium" 
                               VerticalAlignment="Center"/>
                </Border>

                <Button Classes="classic-tool-btn" 
                        Height="23" 
                        Padding="6,2"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ExportModal.OpenCommand}"
                        ToolTip.Tip="Export table rows (CSV, JSON, SQL, TSV)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ui:FASymbolIcon Symbol="Download" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Export..." VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
