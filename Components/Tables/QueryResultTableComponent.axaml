<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:components="using:Quell.Components"
             xmlns:ic="using:FluentIcons.Avalonia"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="400"
             x:Class="Quell.Components.QueryResultTableComponent"
             x:DataType="vm:QueryResultTableViewModel">

    <UserControl.Styles>
        <!-- Distinct Excel Row Header / Index Column Cell Style -->
        <Style Selector="DataGridCell.row-header-col">
            <Setter Property="Background" Value="{DynamicResource AppTableGutterBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableGutterForegroundBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppTableCellFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableGutterBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style Selector="DataGridCell.row-header-col.excel-gutter-active">
            <Setter Property="Background" Value="{DynamicResource AppTableHeaderActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableHeaderActiveForegroundBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Alternating Column Cell Colors & Row-Striped / Flat Modes -->
        <Style Selector="DataGridCell.white-col, DataGridCell.flat-col, DataGridCell.stripe-row">
            <Setter Property="Background" Value="{DynamicResource AppTableWhiteColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppTableCellFontSize}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableCellBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style Selector="DataGridCell.alt-col">
            <Setter Property="Background" Value="{DynamicResource AppTableAltColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppTableCellFontSize}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableCellBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style Selector="DataGridRow.excel-row-odd DataGridCell.stripe-row">
            <Setter Property="Background" Value="{DynamicResource AppTableAltColBackgroundBrush}"/>
        </Style>

        <!-- Primary Key & Foreign Key Column Cell Styles -->
        <Style Selector="DataGridCell.pk-col">
            <Setter Property="Background" Value="{DynamicResource AppTableWhiteColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="{DynamicResource AppTableCellFontSize}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableCellBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style Selector="DataGridRow.excel-row-odd DataGridCell.pk-col.stripe-row">
            <Setter Property="Background" Value="{DynamicResource AppTableAltColBackgroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell.pk-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.pk-col">
            <Setter Property="Background" Value="{DynamicResource AppTableWhiteColBackgroundBrush}"/>
        </Style>

        <Style Selector="DataGridCell.fk-col">
            <Setter Property="Background" Value="{DynamicResource AppTableAltColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="{DynamicResource AppTableCellFontSize}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableCellBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style Selector="DataGridRow.excel-row-odd DataGridCell.fk-col.stripe-row">
            <Setter Property="Background" Value="{DynamicResource AppTableAltColBackgroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow.excel-row-even DataGridCell.fk-col.stripe-row">
            <Setter Property="Background" Value="{DynamicResource AppTableWhiteColBackgroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell.fk-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.fk-col">
            <Setter Property="Background" Value="{DynamicResource AppTableAltColBackgroundBrush}"/>
        </Style>

        <Style Selector="Button.fk-link-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.fk-link-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>

        <Style Selector="Button.fk-nav-btn">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
        <Style Selector=":is(TopLevel).gpu-mode Button.fk-nav-btn">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.fk-nav-btn:pointerover">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>

        <!-- Row Pointer Over (Hover) -->
        <Style Selector="DataGridRow:pointerover DataGridCell.row-header-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell.white-col, DataGridRow:pointerover DataGridCell.alt-col, DataGridRow:pointerover DataGridCell.flat-col, DataGridRow:pointerover DataGridCell.stripe-row">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>

        <!-- Keep the grid's row selection invisible; cells are highlighted individually. -->
        <Style Selector="DataGridRow:selected DataGridCell.row-header-col">
            <Setter Property="Background" Value="{DynamicResource AppTableGutterBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableGutterForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.row-header-col.excel-gutter-active">
            <Setter Property="Background" Value="{DynamicResource AppTableHeaderActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableHeaderActiveForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.white-col, DataGridRow:selected DataGridCell.flat-col, DataGridRow:selected DataGridCell.stripe-row">
            <Setter Property="Background" Value="{DynamicResource AppTableWhiteColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected.excel-row-odd DataGridCell.stripe-row">
            <Setter Property="Background" Value="{DynamicResource AppTableAltColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.alt-col">
            <Setter Property="Background" Value="{DynamicResource AppTableAltColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover DataGridCell.row-header-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableGutterForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover DataGridCell.white-col, DataGridRow:selected:pointerover DataGridCell.alt-col, DataGridRow:selected:pointerover DataGridCell.flat-col, DataGridRow:selected:pointerover DataGridCell.stripe-row">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
        </Style>

        <!-- Excel-style cell selection -->
        <Style Selector="DataGridCell.excel-selected">
            <Setter Property="Background" Value="{DynamicResource AppTableSelectedBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableSelectedForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell.excel-selected">
            <Setter Property="Background" Value="{DynamicResource AppTableSelectedBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableSelectedForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.excel-selected">
            <Setter Property="Background" Value="{DynamicResource AppTableSelectedBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableSelectedForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover DataGridCell.excel-selected">
            <Setter Property="Background" Value="{DynamicResource AppTableSelectedBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableSelectedForegroundBrush}"/>
        </Style>

        <Style Selector="DataGridCell.excel-active">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableActiveForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell.excel-active">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableActiveForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.excel-active">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableActiveForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover DataGridCell.excel-active">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableActiveForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Excel-Style Column Header Styling -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppTableHeaderBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableHeaderForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="{DynamicResource AppTableHeaderHeight}"/>
            <Setter Property="Height" Value="{DynamicResource AppTableHeaderHeight}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableHeaderBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="DataGridColumnHeader.excel-header-active">
            <Setter Property="Background" Value="{DynamicResource AppTableHeaderActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableHeaderActiveForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
        </Style>
    </UserControl.Styles>

    <!-- Excel-Grade Query Result Table Component -->
    <Border Background="{DynamicResource AppWorkspaceBrush}">
        <Grid RowDefinitions="Auto, Auto, *, Auto">
            
            <!-- 1. Table Toolbar Component -->
            <components:TableToolbarComponent Grid.Row="0" DataContext="{Binding}" />

            <!-- 1b. Navigation History & Foreign Key Breadcrumb Bar -->
            <Border Grid.Row="1"
                    IsVisible="{Binding CanNavigateBack}"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,4">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Button Grid.Column="0"
                            Classes="classic-tool-btn"
                            Command="{Binding NavigateBackCommand}"
                            Height="24"
                            Padding="8,2"
                            ToolTip.Tip="Return to previous table results">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:FASymbolIcon Symbol="Back" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NavigateBackText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" 
                               Margin="12,0,0,0" 
                               Text="{Binding NavigationBreadcrumbText}"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" 
                               FontSize="11" 
                               VerticalAlignment="Center" 
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <!-- 2. Interactive Excel-Style DataGrid -->
            <DataGrid x:Name="ResultsDataGrid"
                      Grid.Row="2" 
                      ItemsSource="{Binding Rows}" 
                      SelectedItem="{Binding SelectedRow}"
                      IsVisible="{Binding HasRows}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single"
                      ClipboardCopyMode="None"
                      GridLinesVisibility="All" 
                      HorizontalGridLinesBrush="{DynamicResource AppTableGridLinesHorizontalBrush}"
                      VerticalGridLinesBrush="{DynamicResource AppTableGridLinesVerticalBrush}"
                      CanUserResizeColumns="True" 
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      BorderThickness="0"
                      RowHeight="{DynamicResource AppTableRowHeight}"
                      CellPointerPressed="OnCellPointerPressed"
                      LoadingRow="OnLoadingRow"
                      UnloadingRow="OnUnloadingRow"
                      Sorting="OnSorting">

                <DataGrid.Columns>
                    <!-- Col 0: Excel Corner Select-All Header + Row Number Gutter -->
                    <DataGridTemplateColumn Tag="ROW #"
                                            CellStyleClasses="row-header-col"
                                            Width="56" 
                                            CanUserResize="False">
                        <DataGridTemplateColumn.Header>
                            <Button Classes="classic-menu-btn"
                                    Click="OnSelectAllCornerClick"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    ToolTip.Tip="Select All Cells (Ctrl+A)">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="#" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AppTableGutterForegroundBrush}"/>
                                    <PathIcon Data="M2 14 L14 14 L14 2 Z" Width="8" Height="8" Opacity="0.55" Foreground="{DynamicResource AppTableGutterForegroundBrush}"/>
                                </StackPanel>
                            </Button>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:QueryResultRow">
                                <Grid ColumnDefinitions="*, Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding RowIndex}" 
                                               FontSize="{DynamicResource AppTableCellFontSize}" 
                                               FontWeight="SemiBold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" 
                                            Width="1" 
                                            Background="{DynamicResource AppTableDividerBrush}" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Stretch"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 2b. Clean Empty State Overlay (Visible when no query results and not loading) -->
            <Border Grid.Row="2" 
                    IsVisible="{Binding ShowEmptyState}"
                    Background="{DynamicResource AppWorkspaceBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ic:SymbolIcon Symbol="Table" FontSize="36" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No Query Results" 
                               FontSize="13" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource AppTextSecondaryBrush}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Execute a query (F5) or select a table from Object Explorer to view data." 
                               FontSize="11" 
                               Foreground="{DynamicResource AppTextMutedBrush}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 2c. Async Query & Table Loading Overlay (Visible while loading/executing query) -->
            <Border Grid.Row="2" 
                    IsVisible="{Binding IsLoading}"
                    Background="{DynamicResource AppWorkspaceBrush}"
                    Opacity="0.96"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch">
                <Border x:Name="QueryLoadingCardBorder"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="24,18"
                        MinWidth="260"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     CornerRadius="2"
                                     Foreground="{DynamicResource AppAccentBrush}"
                                     Background="{DynamicResource AppBorderBrush}"
                                     HorizontalAlignment="Stretch" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <ic:SymbolIcon Symbol="Database" 
                                           FontSize="16" 
                                           Foreground="{DynamicResource AppAccentBrush}" 
                                           VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LoadingMessage}" 
                                       FontSize="12.5" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Executing query asynchronously..." 
                                       FontSize="11" 
                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                       VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AppWorkspaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1">
                                <TextBlock Text="{Binding LoadingElapsedText}"
                                           FontFamily="{DynamicResource AppFontFamilyMonospace}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <Button Classes="classic-tool-btn"
                                Command="{Binding CancelQueryCommand}"
                                HorizontalAlignment="Center"
                                Height="24"
                                Padding="12,2"
                                CornerRadius="6"
                                Margin="0,2,0,0">
                            <TextBlock Text="Cancel" FontSize="11" Foreground="#F2677A" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>
            </Border>

            <!-- 3. Table Pagination Component -->
            <components:TablePaginationComponent Grid.Row="3" DataContext="{Binding}" />
        </Grid>
    </Border>
</UserControl>
