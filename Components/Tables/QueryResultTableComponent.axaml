<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Fdb.ViewModels"
             xmlns:components="using:Fdb.Components"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="400"
             x:Class="Fdb.Components.QueryResultTableComponent"
             x:DataType="vm:QueryResultTableViewModel">

    <UserControl.Styles>
        <!-- Distinct Row Header / Index Column Cell Style with Prominent Divider Line -->
        <Style Selector="DataGridCell.row-header-col">
            <Setter Property="Background" Value="{DynamicResource AppTableGutterBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableGutterForegroundBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppTableCellFontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableGutterBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,2,1"/>
        </Style>

        <!-- Alternating Column Cell Colors: Pure White vs Soft Dimmer Off-White (Compact Height) -->
        <Style Selector="DataGridCell.white-col">
            <Setter Property="Background" Value="{DynamicResource AppTableWhiteColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppTableCellFontSize}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableCellBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style Selector="DataGridCell.alt-col">
            <Setter Property="Background" Value="{DynamicResource AppTableAltColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppTableCellFontSize}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableCellBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Primary Key Column Cell Style (Standard Foreground & Neutral Weight - NO ORANGE) -->
        <Style Selector="DataGridCell.pk-col">
            <Setter Property="Background" Value="{DynamicResource AppTableWhiteColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="{DynamicResource AppTableCellFontSize}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableCellBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell.pk-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.pk-col">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
        </Style>

<!-- Foreign Key Column Cell Style (Neutral Slate Foreground - NO ORANGE) -->
        <Style Selector="DataGridCell.fk-col">
            <Setter Property="Background" Value="{DynamicResource AppTableAltColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="{DynamicResource AppTableCellFontSize}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableCellBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell.fk-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.fk-col">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
        </Style>

        <Style Selector="Button.fk-nav-btn">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.fk-nav-btn:pointerover">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>

        <!-- Row Pointer Over (Hover) -->
        <Style Selector="DataGridRow:pointerover DataGridCell.row-header-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell.white-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell.alt-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>

        <!-- Keep the grid's row selection invisible; cells are highlighted individually. -->
        <Style Selector="DataGridRow:selected DataGridCell.row-header-col">
            <Setter Property="Background" Value="{DynamicResource AppTableGutterBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableGutterForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.white-col">
            <Setter Property="Background" Value="{DynamicResource AppTableWhiteColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.alt-col">
            <Setter Property="Background" Value="{DynamicResource AppTableAltColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover DataGridCell.row-header-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableGutterForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover DataGridCell.white-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover DataGridCell.alt-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
        </Style>

        <!-- Excel-style cell selection -->
        <Style Selector="DataGridCell.excel-selected">
            <Setter Property="Background" Value="{DynamicResource AppTableSelectedBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableSelectedForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell.excel-selected">
            <Setter Property="Background" Value="{DynamicResource AppTableSelectedBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableSelectedForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.excel-selected">
            <Setter Property="Background" Value="{DynamicResource AppTableSelectedBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableSelectedForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover DataGridCell.excel-selected">
            <Setter Property="Background" Value="{DynamicResource AppTableSelectedBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableSelectedForegroundBrush}"/>
        </Style>

        <Style Selector="DataGridCell.excel-active">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableActiveForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell.excel-active">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableActiveForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.excel-active">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableActiveForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover DataGridCell.excel-active">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableActiveForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableActiveBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Modern Column Header Styling with Prominent Titles (Compact Height) -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppTableHeaderBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableHeaderForegroundBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableHeaderBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <!-- Professional Database Query Result Table Component with Alternating Columns -->
    <Border Background="{DynamicResource AppWorkspaceBrush}">
        <Grid RowDefinitions="Auto, *, Auto">
            
            <!-- 1. Table Toolbar Component -->
            <components:TableToolbarComponent Grid.Row="0" DataContext="{Binding}" />

            <!-- 2. Interactive DataGrid with Alternating Columns & Prominent Titles (RowHeight=25) -->
            <DataGrid x:Name="ResultsDataGrid"
                      Grid.Row="1" 
                      ItemsSource="{Binding Rows}" 
                      SelectedItem="{Binding SelectedRow}"
                      IsVisible="{Binding HasRows}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single"
                      ClipboardCopyMode="None"
                      GridLinesVisibility="All" 
                      HorizontalGridLinesBrush="{DynamicResource AppTableGridLinesHorizontalBrush}"
                      VerticalGridLinesBrush="{DynamicResource AppTableGridLinesVerticalBrush}"
                      CanUserResizeColumns="True" 
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      BorderThickness="0"
                      RowHeight="25"
                      CellPointerPressed="OnCellPointerPressed"
                      LoadingRow="OnLoadingRow"
                      UnloadingRow="OnUnloadingRow"
                      Sorting="OnSorting">
                
                <!-- DataGrid Context Menu -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit Cell Value..." Command="{Binding OpenEditSelectedCellCommand}" InputGesture="F2">
                            <MenuItem.Icon>
                                <ui:FASymbolIcon Symbol="Edit" FontSize="11" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Generate UPDATE Query..." Command="{Binding GenerateUpdateQueryCommand}">
                            <MenuItem.Icon>
                                <ui:FASymbolIcon Symbol="Code" FontSize="11" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Delete Selected Row(s)" Command="{Binding DeleteSelectedRowCommand}" InputGesture="Delete">
                            <MenuItem.Icon>
                                <ui:FASymbolIcon Symbol="Delete" FontSize="11" Foreground="#EF4444" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Delete Selected Column(s)" Command="{Binding DeleteSelectedColumnCommand}">
                            <MenuItem.Icon>
                                <ui:FASymbolIcon Symbol="Delete" FontSize="11" Foreground="#EF4444" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Generate DELETE Query..." Command="{Binding GenerateDeleteQueryCommand}">
                            <MenuItem.Icon>
                                <ui:FASymbolIcon Symbol="Code" FontSize="11" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Refresh Table Data" Command="{Binding RefreshCommand}" InputGesture="F5">
                            <MenuItem.Icon>
                                <ui:FASymbolIcon Symbol="Refresh" FontSize="11" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Copy Cell Value" Command="{Binding CopyCellCommand}" InputGesture="Ctrl+C" />
                        <MenuItem Header="Copy Entire Row" Command="{Binding CopyRowCommand}" />
                        <Separator />
                        <MenuItem Header="Copy as JSON" />
                        <MenuItem Header="Copy as CSV" />
                        <MenuItem Header="Export Results to File..." 
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ExportModal.OpenCommand}">
                            <MenuItem.Icon>
                                <ui:FASymbolIcon Symbol="Download" FontSize="11" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Filter by This Value" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <!-- Col 0: Index / Row # (Gutter style with prominent vertical line divider in front of number) -->
                    <DataGridTemplateColumn Header="ROW #" 
                                            CellStyleClasses="row-header-col"
                                            Width="56" 
                                            CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:QueryResultRow">
                                <Grid ColumnDefinitions="*, Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding RowIndex}" 
                                               Foreground="{DynamicResource AppTableGutterForegroundBrush}" 
                                               FontSize="11" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                    <!-- Clear vertical divider line right in front of the row number -->
                                    <Border Grid.Column="1" 
                                            Width="2" 
                                            Background="{DynamicResource AppTableDividerBrush}" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Stretch"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <!-- Col 1: ID (Primary Key with Distinct Golden PK Badge & Icon) -->
                    <DataGridTextColumn Header="ID" 
                                        CellStyleClasses="pk-col"
                                        Binding="{Binding Id}" 
                                        FontWeight="Bold"
                                        Width="95">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource AppTablePkBadgeBackgroundBrush}" 
                                            BorderBrush="{DynamicResource AppTablePkBadgeBorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="3" 
                                            Padding="3,1">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <PathIcon Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" Width="9" Height="9" Foreground="{DynamicResource AppTablePkBadgeForegroundBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="PK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTablePkBadgeForegroundBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="ID" FontWeight="Bold" Foreground="{DynamicResource AppTableHeaderForegroundBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Col 2: NAME (Dimmer Off-White) -> Column with Title "NAME" & names below -->
                    <DataGridTextColumn Header="NAME" 
                                        CellStyleClasses="alt-col"
                                        Binding="{Binding Name}" 
                                        FontWeight="SemiBold"
                                        Width="170" />

                    <!-- Col 3: EMAIL (Pure White) -->
                    <DataGridTextColumn Header="EMAIL" 
                                        CellStyleClasses="white-col"
                                        Binding="{Binding Email}" 
                                        Width="210" />

                    <!-- Col 4: ROLE (Foreign Key with distinct FK badge and navigation arrow button) -->
                    <DataGridTemplateColumn Header="ROLE" 
                                            CellStyleClasses="alt-col fk-col"
                                            Width="140">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                            ToolTip.Tip="Foreign Key -> References Roles(Title)">
                                    <Border Background="{DynamicResource AppTableFkBadgeBackgroundBrush}" 
                                            BorderBrush="{DynamicResource AppTableFkBadgeBorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="3" 
                                            Padding="3,1"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <PathIcon Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z" 
                                                      Width="9" Height="9" 
                                                      Foreground="{DynamicResource AppTableFkBadgeForegroundBrush}" 
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="FK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTableFkBadgeForegroundBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="ROLE" FontWeight="Bold" Foreground="{DynamicResource AppTableHeaderForegroundBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:QueryResultRow">
                                <Grid ColumnDefinitions="*, Auto" Margin="4,0" VerticalAlignment="Stretch">
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding Role}" 
                                               VerticalAlignment="Center" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource AppTableCellForegroundBrush}"/>
                                    <Button Grid.Column="1"
                                            Classes="fk-nav-btn"
                                            Width="20" Height="20"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            ToolTip.Tip="Navigate to referenced record in Roles table"
                                            Click="OnForeignKeyNavigationClick"
                                            Tag="Role">
                                        <PathIcon Data="M14 5l7 7m0 0l-7 7m7-7H3" 
                                                  Width="10" Height="10" 
                                                  Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                                  VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Col 5: COURSE / دوره (Foreign Key with distinct FK badge and navigation arrow button) -->
                    <DataGridTemplateColumn Header="COURSE" 
                                            CellStyleClasses="white-col fk-col"
                                            Width="190">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                            ToolTip.Tip="Foreign Key -> References Courses(Title) / Users">
                                    <Border Background="{DynamicResource AppTableFkBadgeBackgroundBrush}" 
                                            BorderBrush="{DynamicResource AppTableFkBadgeBorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="3" 
                                            Padding="3,1"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <PathIcon Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z" 
                                                      Width="9" Height="9" 
                                                      Foreground="{DynamicResource AppTableFkBadgeForegroundBrush}" 
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="FK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTableFkBadgeForegroundBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="COURSE" FontWeight="Bold" Foreground="{DynamicResource AppTableHeaderForegroundBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:QueryResultRow">
                                <Grid ColumnDefinitions="*, Auto" Margin="4,0" VerticalAlignment="Stretch">
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding Course}" 
                                               VerticalAlignment="Center" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource AppTableCellForegroundBrush}"/>
                                    <Button Grid.Column="1"
                                            Classes="fk-nav-btn"
                                            Width="20" Height="20"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            ToolTip.Tip="Navigate to related record via Foreign Key"
                                            Click="OnForeignKeyNavigationClick"
                                            Tag="Course">
                                        <PathIcon Data="M14 5l7 7m0 0l-7 7m7-7H3" 
                                                  Width="10" Height="10" 
                                                  Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                                  VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Col 5: STATUS (Pure White) -> Plain Text -->
                    <DataGridTextColumn Header="STATUS" 
                                        CellStyleClasses="white-col"
                                        Binding="{Binding Status}" 
                                        Width="110" />

                    <!-- Col 6: CREATED AT (Dimmer Off-White) -->
                    <DataGridTextColumn Header="CREATED AT" 
                                        CellStyleClasses="alt-col"
                                        Binding="{Binding CreatedAt}" 
                                        Width="170" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 2b. Clean Empty State Overlay (Visible when no query results) -->
            <Border Grid.Row="1" 
                    IsVisible="{Binding !HasRows}"
                    Background="{DynamicResource AppWorkspaceBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ui:FASymbolIcon Symbol="Page" FontSize="28" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No Query Results" 
                               FontSize="13" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource AppTextSecondaryBrush}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Execute a query (F5) or select a table from Object Explorer to view data." 
                               FontSize="11" 
                               Foreground="{DynamicResource AppTextMutedBrush}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 3. Table Pagination Component -->
            <components:TablePaginationComponent Grid.Row="2" DataContext="{Binding}" />
        </Grid>
    </Border>
</UserControl>
