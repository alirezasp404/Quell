<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Fdb.ViewModels"
              xmlns:components="using:Fdb.Components"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
              mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="600"
              x:Class="Fdb.Components.SidebarComponent"
              x:DataType="vm:SidebarViewModel"
              IsVisible="{Binding IsVisible}">

    <!-- Reusable Sidebar Panel Component (Explorer / Databases / History) -->
    <Border Background="{DynamicResource AppSurfaceBrush}" 
            BorderBrush="{DynamicResource AppBorderBrush}" 
            BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto, Auto, *">
            
            <!-- 1. Tool Window Header Component -->
            <components:ToolWindowHeaderComponent Grid.Row="0" 
                                                  Title="OBJECT EXPLORER" 
                                                  CloseCommand="{Binding ClosePanelCommand}" />

            <!-- 2. Auto-Expanding Tab Strip with Right-Click ContextMenu -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource AppSurfaceBrush}" 
                    BorderBrush="{DynamicResource AppBorderBrush}" 
                    BorderThickness="0,0,0,1" 
                    Padding="4,2,4,0">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="classic-tab-btn" 
                                    Content="{Binding}" 
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SelectTabCommand}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <!-- Right-Click ContextMenu -->
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Close Tab" 
                                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).CloseTabCommand}" 
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Close Sidebar Panel" 
                                                  Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).ClosePanelCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 3. Dynamic Tab Content -->
            <Grid Grid.Row="2">

                <!-- ======================================================== -->
                <!-- TAB 1: OBJECT EXPLORER (Database Info & Tables List)   -->
                <!-- ======================================================== -->
                <Grid RowDefinitions="Auto, Auto, *" Margin="6,8"
                      IsVisible="{Binding SelectedTab, Converter={x:Static StringConverters.IsNullOrEmpty}, ConverterParameter='Explorer'}">
                    <Grid.Styles>
                        <!-- Show only when SelectedTab == Explorer -->
                        <Style Selector="Grid">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                    </Grid.Styles>
                </Grid>

                <!-- Explorer Content Panel -->
                <Grid RowDefinitions="Auto, Auto, *" Margin="6,8">
                    <!-- Visibility based on SelectedTab -->
                    <Grid.IsVisible>
                        <MultiBinding>
                            <MultiBinding.Bindings>
                                <Binding Path="SelectedTab" />
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Grid.IsVisible>

                    <!-- A. Active Database Info Card -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource AppWorkspaceBrush}" 
                            BorderBrush="{DynamicResource AppBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="5" 
                            Padding="8,6" 
                            Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border Grid.Column="0" 
                                    Width="8" Height="8" 
                                    CornerRadius="4" 
                                    Background="#10B981" 
                                    VerticalAlignment="Center" 
                                    Margin="0,0,6,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConnectionTitle}" 
                                           FontSize="11" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StatusText}" 
                                           FontSize="10" 
                                           Foreground="{DynamicResource AppTextMutedBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="2" 
                                    Classes="classic-menu-btn" 
                                    Command="{Binding RefreshCommand}"
                                    ToolTip.Tip="Refresh Tables"
                                    Padding="4,2">
                                <ui:FASymbolIcon Symbol="Refresh" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- B. Table Search Filter -->
                    <Border Grid.Row="1" Margin="0,0,0,6">
                        <TextBox Text="{Binding TableSearchFilter}" 
                                 Height="26" 
                                 FontSize="11" 
                                 Padding="6,2"
                                 CornerRadius="4" 
                                 PlaceholderText="Filter tables..."/>
                    </Border>

                    <!-- C. Tables List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2">
                            <!-- Tables Items -->
                            <ItemsControl ItemsSource="{Binding FilteredTables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" 
                                                Padding="6,4" 
                                                Margin="0,1"
                                                Background="Transparent">
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
                                                </Style>
                                            </Border.Styles>
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <ui:FASymbolIcon Grid.Column="0" 
                                                                 Symbol="Document" 
                                                                 FontSize="11" 
                                                                 Foreground="{DynamicResource AppAccentBrush}" 
                                                                 VerticalAlignment="Center" 
                                                                 Margin="0,0,6,0"/>

                                                <Button Grid.Column="1" 
                                                        Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SelectTableCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding FullName}" 
                                                               FontSize="11" 
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                                               VerticalAlignment="Center" 
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Button>

                                                <Border Grid.Column="2" 
                                                        Background="{DynamicResource AppSurfaceBrush}" 
                                                        BorderBrush="{DynamicResource AppBorderBrush}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="3" 
                                                        Padding="4,1">
                                                    <TextBlock Text="{Binding DisplayType}" 
                                                               FontSize="9" 
                                                               Foreground="{DynamicResource AppTextMutedBrush}" 
                                                               FontWeight="Medium"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty Filter Message -->
                            <TextBlock Text="No tables match filter" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,20" 
                                       IsVisible="{Binding !FilteredTables.Count}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</UserControl>
