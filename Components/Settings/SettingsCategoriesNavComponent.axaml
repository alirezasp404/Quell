<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Quell.ViewModels"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
              mc:Ignorable="d" d:DesignWidth="190" d:DesignHeight="400"
              x:Class="Quell.Components.SettingsCategoriesNavComponent"
              x:DataType="vm:SettingsModalViewModel">

    <UserControl.Styles>
        <Style Selector="Button.nav-cat-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav-cat-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        </Style>
        <Style Selector="Button.nav-cat-btn.active">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        </Style>
        <Style Selector="Button.nav-cat-btn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Reusable Categories Navigation Sidebar Component for Settings Dialog -->
    <Border Background="{DynamicResource AppSurfaceMutedBrush}" 
            BorderBrush="{DynamicResource AppBorderBrush}" 
            BorderThickness="0,0,1,0" 
            Padding="8,12">
        <StackPanel Spacing="4">
            <TextBlock Text="PREFERENCES" 
                       FontSize="10" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource AppTextMutedBrush}" 
                       Margin="8,0,0,8"/>

            <!-- 1. Appearance Category Item -->
            <Button Classes="nav-cat-btn"
                    Classes.active="{Binding IsAppearanceCategory}"
                    Command="{Binding SelectCategoryCommand}" 
                    CommandParameter="Appearance">
                <Grid ColumnDefinitions="Auto, Auto, *">
                    <Border Grid.Column="0" Width="3" Height="14" CornerRadius="1.5" 
                            Background="{DynamicResource AppAccentBrush}" 
                            Margin="0,0,8,0"
                            IsVisible="{Binding IsAppearanceCategory}" />
                    <ui:FASymbolIcon Grid.Column="1" Symbol="Settings" FontSize="13" 
                                     Foreground="{DynamicResource AppAccentBrush}"
                                     VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Appearance" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- 2. Results Table Customization Category Item -->
            <Button Classes="nav-cat-btn"
                    Classes.active="{Binding IsTableCategory}"
                    Command="{Binding SelectCategoryCommand}" 
                    CommandParameter="Table">
                <Grid ColumnDefinitions="Auto, Auto, *">
                    <Border Grid.Column="0" Width="3" Height="14" CornerRadius="1.5" 
                            Background="{DynamicResource AppAccentBrush}" 
                            Margin="0,0,8,0"
                            IsVisible="{Binding IsTableCategory}" />
                    <ui:FASymbolIcon Grid.Column="1" Symbol="ViewAll" FontSize="13" 
                                     Foreground="{DynamicResource AppAccentBrush}"
                                     VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Results Table" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- 3. Customization (Panels & Editor) Category Item -->
            <Button Classes="nav-cat-btn"
                    Classes.active="{Binding IsCustomizationCategory}"
                    Command="{Binding SelectCategoryCommand}" 
                    CommandParameter="Customization">
                <Grid ColumnDefinitions="Auto, Auto, *">
                    <Border Grid.Column="0" Width="3" Height="14" CornerRadius="1.5" 
                            Background="{DynamicResource AppAccentBrush}" 
                            Margin="0,0,8,0"
                            IsVisible="{Binding IsCustomizationCategory}" />
                    <ui:FASymbolIcon Grid.Column="1" Symbol="Edit" FontSize="13" 
                                     Foreground="{DynamicResource AppAccentBrush}"
                                     VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Customization" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- 4. Shortcuts Category Item -->
            <Button Classes="nav-cat-btn"
                    Classes.active="{Binding IsShortcutsCategory}"
                    Command="{Binding SelectCategoryCommand}" 
                    CommandParameter="Shortcuts">
                <Grid ColumnDefinitions="Auto, Auto, *">
                    <Border Grid.Column="0" Width="3" Height="14" CornerRadius="1.5" 
                            Background="{DynamicResource AppAccentBrush}" 
                            Margin="0,0,8,0"
                            IsVisible="{Binding IsShortcutsCategory}" />
                    <ui:FASymbolIcon Grid.Column="1" Symbol="Keyboard" FontSize="13" 
                                     Foreground="{DynamicResource AppAccentBrush}"
                                     VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Shortcuts" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- 5. Performance & Graphics Category Item -->
            <Button Classes="nav-cat-btn"
                    Classes.active="{Binding IsPerformanceCategory}"
                    Command="{Binding SelectCategoryCommand}" 
                    CommandParameter="Performance">
                <Grid ColumnDefinitions="Auto, Auto, *">
                    <Border Grid.Column="0" Width="3" Height="14" CornerRadius="1.5" 
                            Background="{DynamicResource AppAccentBrush}" 
                            Margin="0,0,8,0"
                            IsVisible="{Binding IsPerformanceCategory}" />
                    <PathIcon Grid.Column="1" 
                              Data="M15 9H9v6h6V9zm-2 4h-2v-2h2v2zm8-2V9h-2V7c0-1.1-.9-2-2-2h-2V3h-2v2h-2V3h-2v2H9c-1.1 0-2 .9-2 2v2H5v2h2v2H5v2h2v2c0 1.1.9 2 2 2h2v2h2v-2h2v2h2v-2h2c1.1 0 2-.9 2-2v-2h2v-2h-2v-2h2zm-4 6H7V7h10v10z" 
                              Width="13" Height="13" 
                              Foreground="{DynamicResource AppAccentBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Performance &amp; GPU" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- 5. Integrated Terminal Category Item -->
            <Button Classes="nav-cat-btn"
                    Command="{Binding SelectCategoryCommand}" 
                    CommandParameter="Terminal">
                <Grid ColumnDefinitions="Auto, *">
                    <ui:FASymbolIcon Grid.Column="0" Symbol="Play" FontSize="13" 
                                     Foreground="{DynamicResource AppAccentBrush}"
                                     VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Terminal" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
