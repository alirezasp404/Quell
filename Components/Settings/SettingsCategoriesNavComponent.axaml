<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Fdb.ViewModels"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
              mc:Ignorable="d" d:DesignWidth="190" d:DesignHeight="400"
              x:Class="Fdb.Components.SettingsCategoriesNavComponent"
              x:DataType="vm:SettingsModalViewModel">

    <UserControl.Styles>
        <Style Selector="Button.nav-cat-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav-cat-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Reusable Categories Navigation Sidebar Component for Settings Dialog -->
    <Border Background="{DynamicResource AppSurfaceMutedBrush}" 
            BorderBrush="{DynamicResource AppBorderBrush}" 
            BorderThickness="0,0,1,0" 
            Padding="8,12">
        <StackPanel Spacing="4">
            <TextBlock Text="PREFERENCES" 
                       FontSize="10" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource AppTextMutedBrush}" 
                       Margin="8,0,0,8"/>

            <!-- 1. Appearance Category Item -->
            <Button Classes="nav-cat-btn"
                    Command="{Binding SelectCategoryCommand}" 
                    CommandParameter="Appearance">
                <Grid ColumnDefinitions="Auto, *">
                    <ui:FASymbolIcon Grid.Column="0" Symbol="Settings" FontSize="13" 
                                     Foreground="{DynamicResource AppAccentBrush}"
                                     VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Appearance" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- 2. Results Table Customization Category Item -->
            <Button Classes="nav-cat-btn"
                    Command="{Binding SelectCategoryCommand}" 
                    CommandParameter="Table">
                <Grid ColumnDefinitions="Auto, *">
                    <ui:FASymbolIcon Grid.Column="0" Symbol="ViewAll" FontSize="13" 
                                     Foreground="{DynamicResource AppAccentBrush}"
                                     VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Results Table" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- 3. Customization (Panels & Editor) Category Item -->
            <Button Classes="nav-cat-btn"
                    Command="{Binding SelectCategoryCommand}" 
                    CommandParameter="Customization">
                <Grid ColumnDefinitions="Auto, *">
                    <ui:FASymbolIcon Grid.Column="0" Symbol="Edit" FontSize="13" 
                                     Foreground="{DynamicResource AppAccentBrush}"
                                     VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Customization" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- 4. Shortcuts Category Item -->
            <Button Classes="nav-cat-btn"
                    Command="{Binding SelectCategoryCommand}" 
                    CommandParameter="Shortcuts">
                <Grid ColumnDefinitions="Auto, *">
                    <ui:FASymbolIcon Grid.Column="0" Symbol="Keyboard" FontSize="13" 
                                     Foreground="{DynamicResource AppAccentBrush}"
                                     VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Shortcuts" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
