<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="using:Quell.ViewModels"
              xmlns:services="using:Quell.Services"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
              mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="700"
              x:Class="Quell.Components.ShortcutsSettingsComponent"
              x:Name="ShortcutsRoot"
              x:DataType="vm:SettingsModalViewModel">

    <UserControl.Styles>
        <Style Selector="Border.keycap">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="BoxShadow" Value="0 1 2 #20000000" />
        </Style>

        <Style Selector="Button.cat-filter-btn">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.cat-filter-btn:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}" />
        </Style>
        <Style Selector="Button.cat-filter-btn.active">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="Button.cat-filter-btn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="Button.cat-filter-btn.active TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="14">
        <!-- Section Header -->
        <Grid ColumnDefinitions="*, Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Keyboard Shortcuts" 
                           FontSize="15" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                <TextBlock Text="Dynamic shortcuts loaded from and persisted to the SQLite database." 
                           FontSize="11" 
                           Foreground="{DynamicResource AppTextMutedBrush}"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    Command="{Binding ResetAllShortcutsCommand}"
                    Classes="classic-tool-btn" 
                    Padding="10,4"
                    FontSize="11"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:FASymbolIcon Symbol="Undo" FontSize="11"/>
                    <TextBlock Text="Reset All" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Separator Background="{DynamicResource AppBorderBrush}" Margin="0,2"/>

        <!-- Search Bar and Filter Pills -->
        <Grid ColumnDefinitions="*, Auto">
            <TextBox Grid.Column="0" 
                     Text="{Binding ShortcutSearchFilter}" 
                     PlaceholderText="Search shortcuts by name or keys..."
                     Classes="classic-search-box"
                     FontSize="11"
                     Padding="8,6"
                     Margin="0,0,8,0"/>

            <!-- Category Filter Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Classes="cat-filter-btn" Classes.active="{Binding IsAllShortcutsCategory}" Content="All" Command="{Binding FilterShortcutsByCategoryCommand}" CommandParameter="All"/>
                <Button Classes="cat-filter-btn" Classes.active="{Binding IsQueryShortcutsCategory}" Content="Query" Command="{Binding FilterShortcutsByCategoryCommand}" CommandParameter="Query &amp; Execution"/>
                <Button Classes="cat-filter-btn" Classes.active="{Binding IsEditorShortcutsCategory}" Content="Editor" Command="{Binding FilterShortcutsByCategoryCommand}" CommandParameter="File &amp; Editor"/>
                <Button Classes="cat-filter-btn" Classes.active="{Binding IsPanelsShortcutsCategory}" Content="Panels" Command="{Binding FilterShortcutsByCategoryCommand}" CommandParameter="Panels &amp; View"/>
            </StackPanel>
        </Grid>

        <!-- Shortcuts List -->
        <Border Background="{DynamicResource AppSurfaceBrush}" 
                BorderBrush="{DynamicResource AppBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="6" 
                ClipToBounds="True">
            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredShortcuts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:ShortcutItem">
                            <Border BorderBrush="{DynamicResource AppBorderLightBrush}" 
                                    BorderThickness="0,0,0,1" 
                                    Padding="12,9">
                                <Grid ColumnDefinitions="*, Auto">
                                    <!-- Shortcut Info -->
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="12" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>

                                            <!-- Category Badge -->
                                            <Border Background="{DynamicResource AppSurfaceMutedBrush}" 
                                                    CornerRadius="3" 
                                                    Padding="4,1" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" 
                                                           FontSize="9" 
                                                           Foreground="{DynamicResource AppTextMutedBrush}"/>
                                            </Border>

                                            <!-- Modified indicator -->
                                            <Border IsVisible="{Binding IsModified}" 
                                                    Background="{DynamicResource AppAccentBrush}" 
                                                    CornerRadius="3" 
                                                    Padding="4,1" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="MODIFIED" 
                                                           FontSize="8" 
                                                           FontWeight="Bold" 
                                                           Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}" 
                                                   FontSize="10" 
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Shortcut Key Action / Edit controls -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <!-- Normal View: Keycaps Display -->
                                        <Panel IsVisible="{Binding !IsEditing}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <ItemsControl ItemsSource="{Binding KeyTokens}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="3"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="keycap">
                                                                <TextBlock Text="{Binding}" 
                                                                           FontSize="10" 
                                                                           FontWeight="Bold" 
                                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                                                           FontFamily="{DynamicResource AppFontFamilyMonospace}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Edit Shortcut Button -->
                                                <Button Command="{Binding #ShortcutsRoot.((vm:SettingsModalViewModel)DataContext).StartEditShortcutCommand}" 
                                                        CommandParameter="{Binding}"
                                                        Classes="classic-menu-btn" 
                                                        Padding="4,2" 
                                                        Margin="4,0,0,0"
                                                        ToolTip.Tip="Customize this shortcut">
                                                    <ui:FASymbolIcon Symbol="Edit" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                                </Button>

                                                <!-- Reset Single Shortcut Button -->
                                                <Button IsVisible="{Binding IsModified}"
                                                        Command="{Binding #ShortcutsRoot.((vm:SettingsModalViewModel)DataContext).ResetShortcutCommand}" 
                                                        CommandParameter="{Binding}"
                                                        Classes="classic-menu-btn" 
                                                        Padding="4,2" 
                                                        ToolTip.Tip="Reset to default shortcut">
                                                    <ui:FASymbolIcon Symbol="Undo" FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Panel>

                                        <!-- Edit Mode: Key Input Capture -->
                                        <Panel IsVisible="{Binding IsEditing}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBox Text="{Binding EditingGesture}" 
                                                         KeyDown="OnShortcutTextBoxKeyDown"
                                                         PlaceholderText="Press key..." 
                                                         Width="110" 
                                                         FontSize="10" 
                                                         FontFamily="{DynamicResource AppFontFamilyMonospace}" 
                                                         Padding="4,2"/>

                                                <!-- Confirm Edit -->
                                                <Button Command="{Binding #ShortcutsRoot.((vm:SettingsModalViewModel)DataContext).ApplyEditShortcutCommand}" 
                                                        CommandParameter="{Binding}"
                                                        Classes="classic-tool-btn" 
                                                        Padding="6,3" 
                                                        Background="{DynamicResource AppAccentBrush}" 
                                                        Foreground="White"
                                                        ToolTip.Tip="Apply new key gesture">
                                                    <ui:FASymbolIcon Symbol="Checkmark" FontSize="10"/>
                                                </Button>

                                                <!-- Cancel Edit -->
                                                <Button Command="{Binding #ShortcutsRoot.((vm:SettingsModalViewModel)DataContext).CancelEditShortcutCommand}" 
                                                        CommandParameter="{Binding}"
                                                        Classes="classic-tool-btn" 
                                                        Padding="6,3" 
                                                        ToolTip.Tip="Cancel editing">
                                                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="10"/>
                                                </Button>
                                            </StackPanel>
                                        </Panel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
