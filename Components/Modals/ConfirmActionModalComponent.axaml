<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:b="using:Quell.Behaviors"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Quell.Components.ConfirmActionModalComponent"
             x:DataType="vm:ConfirmActionModalViewModel"
             IsVisible="{Binding IsOpen}">

    <!-- Reusable Action Confirmation & Destruction Alert Modal -->
    <Grid>
        <!-- Backdrop (Click to dismiss) -->
        <Border Classes="modal-backdrop" Cursor="Hand" Focusable="False" FocusAdorner="{x:Null}" Background="{DynamicResource AppModalOverlayBrush}" PointerPressed="OnBackdropPointerPressed" />

        <!-- Centered Dialog Window Card -->
        <Border Classes="modal-dialog-card"
                Focusable="False"
                Width="420"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            <i:Interaction.Behaviors>
                <b:GpuModalEntranceBehavior StartScale="0.93" DurationMs="220" />
            </i:Interaction.Behaviors>
            
            <Grid RowDefinitions="Auto, *, Auto">
                
                <!-- 1. Header -->
                <Border Grid.Row="0" Classes="quell-modal-header">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" 
                                Background="{DynamicResource AppDangerMutedBrush}" 
                                CornerRadius="7" 
                                Width="30" 
                                Height="30" 
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Important" FontSize="13" Foreground="{DynamicResource AppDangerForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Column="1" 
                                   Text="{Binding Title}" 
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                   FontSize="13" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="2" 
                                Classes="classic-menu-btn" 
                                Command="{Binding CancelCommand}"
                                Padding="6,2" 
                                MinHeight="22">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="10"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Message Body -->
                <StackPanel Grid.Row="1" Margin="20,16" Spacing="10">
                    <TextBlock Text="{Binding Message}" 
                               Foreground="{DynamicResource AppTextSecondaryBrush}" 
                               FontSize="12" 
                               TextWrapping="Wrap" 
                               LineHeight="18"/>

                    <!-- Target Name Pill (if provided) -->
                    <Border Background="{DynamicResource AppSurfaceBrush}" 
                            BorderBrush="{DynamicResource AppBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="8,4" 
                            HorizontalAlignment="Left"
                            IsVisible="{Binding TargetName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding TargetName}" 
                                   FontFamily="Cascadia Code, Consolas, monospace" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource AppDangerForegroundBrush}"/>
                    </Border>
                </StackPanel>

                <!-- 3. Footer -->
                <Border Grid.Row="2" Classes="quell-modal-footer">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="classic-tool-btn" 
                                Content="Cancel" 
                                Command="{Binding CancelCommand}"/>

                        <Button Classes="quell-btn-danger"
                                Padding="16,6"
                                Content="{Binding ConfirmButtonText}" 
                                Command="{Binding ConfirmCommand}">
                            <i:Interaction.Behaviors>
                                <b:GpuButtonPressBehavior PressScale="0.94" />
                            </i:Interaction.Behaviors>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
