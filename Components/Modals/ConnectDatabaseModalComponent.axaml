<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:b="using:Quell.Behaviors"
             xmlns:ic="using:FluentIcons.Avalonia"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Quell.Components.ConnectDatabaseModalComponent"
             x:DataType="vm:ConnectDatabaseModalViewModel"
             IsVisible="{Binding IsOpen}">

    <!-- Dynamic Database Connection Modal Dialog -->
    <Grid>
        <!-- Backdrop (Click to dismiss) -->
        <Border Classes="modal-backdrop" Cursor="Hand" Focusable="False" FocusAdorner="{x:Null}" Background="{DynamicResource AppModalOverlayBrush}" PointerPressed="OnBackdropPointerPressed" />

        <!-- Centered Dialog Window Card -->
        <Border Classes="modal-dialog-card"
                Background="{DynamicResource AppWorkspaceBrush}" 
                BorderBrush="{DynamicResource AppBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                ClipToBounds="True"
                Focusable="False" FocusAdorner="{x:Null}" 
                BoxShadow="0 10 25 0 #33000000"
                Width="530"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            <i:Interaction.Behaviors>
                <b:GpuModalEntranceBehavior StartScale="0.93" DurationMs="220" />
            </i:Interaction.Behaviors>
            
            <Grid RowDefinitions="Auto, *, Auto">
                
                <!-- 1. Dialog Header -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        CornerRadius="8,8,0,0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" 
                                Background="{DynamicResource AppAccentBrush}" 
                                CornerRadius="6" 
                                Width="28" 
                                Height="28" 
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="DatabasePlugConnected" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ModalTitle}" 
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                       FontSize="13" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding ModalSubtitle}" 
                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                       FontSize="11" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                Classes="classic-menu-btn" 
                                Command="{Binding CloseCommand}"
                                Padding="6,2" 
                                MinHeight="22">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="10"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Form Body -->
                <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,14" Spacing="14">
                        
                        <!-- A. Database Engine Selection Cards -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Select Database Engine" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            
                            <ItemsControl ItemsSource="{Binding EngineOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding $parent[UserControl].((vm:ConnectDatabaseModalViewModel)DataContext).SelectEngineCommand}"
                                                CommandParameter="{Binding Id}"
                                                Margin="3"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <Border CornerRadius="6"
                                                    Padding="8,8"
                                                    BorderThickness="1.5">
                                                <Border.Styles>
                                                    <Style Selector="Border">
                                                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                                    </Style>
                                                    <!-- Highlight when selected -->
                                                    <Style Selector="Border[Tag=True]">
                                                        <Setter Property="Background" Value="#153B82F6" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                                    </Style>
                                                </Border.Styles>
                                                <Border.Tag>
                                                    <Binding Path="IsSelected" />
                                                </Border.Tag>

                                                <StackPanel Spacing="5" HorizontalAlignment="Center">
                                                    <!-- Engine Badge -->
                                                    <Border Background="{Binding BadgeBackground}" 
                                                            CornerRadius="4" 
                                                            Padding="5,2" 
                                                            HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Badge}" 
                                                                   Foreground="White" 
                                                                   FontSize="9" 
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                    
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontSize="11" 
                                                               FontWeight="SemiBold" 
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"/>

                                                    <TextBlock Text="{Binding DefaultPortText}" 
                                                               FontSize="9" 
                                                               Foreground="{DynamicResource AppTextMutedBrush}" 
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- B. Saved Connections Quick Selector (Persisted in SQLite) -->
                        <StackPanel Spacing="6" IsVisible="{Binding SavedConnections.Count}">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Saved Connections in SQLite" 
                                           FontSize="11" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding SavedConnections.Count, StringFormat='{}{0} saved'}" 
                                           FontSize="10" 
                                           Foreground="{DynamicResource AppTextMutedBrush}"/>
                            </Grid>
                            
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SavedConnections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AppSurfaceBrush}" 
                                                    BorderBrush="{DynamicResource AppBorderBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="4" 
                                                    Padding="4,2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Classes="classic-tool-btn"
                                                            Command="{Binding $parent[UserControl].((vm:ConnectDatabaseModalViewModel)DataContext).SelectSavedConnectionCommand}"
                                                            CommandParameter="{Binding}"
                                                            Padding="4,2" 
                                                            BorderThickness="0" 
                                                            Background="Transparent">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Border Background="{Binding BadgeColor}" CornerRadius="3" Padding="4,1">
                                                                <TextBlock Text="{Binding DatabaseType}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="classic-tool-btn" 
                                                            Command="{Binding $parent[UserControl].((vm:ConnectDatabaseModalViewModel)DataContext).DeleteSavedConnectionCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Disconnect and Delete from SQLite"
                                                            Padding="3,2">
                                                        <ui:FASymbolIcon Symbol="Dismiss" FontSize="9" Foreground="#EF4444"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,2"/>

                        <!-- C. SERVER-BASED CONFIGURATION (SQL Server, PostgreSQL, MySQL) -->
                        <StackPanel Spacing="12" IsVisible="{Binding IsServerBased}">
                            <!-- Server & Port -->
                            <Grid ColumnDefinitions="*, 12, 100">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Server Host / IP" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBox Text="{Binding Server}" Height="30" FontSize="12" CornerRadius="4" Padding="8,4" PlaceholderText="localhost"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Port" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBox Text="{Binding Port}" Height="30" FontSize="12" CornerRadius="4" Padding="8,4" PlaceholderText="1433"/>
                                </StackPanel>
                            </Grid>

                            <!-- Database Name -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Initial Database" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBox Text="{Binding Database}" Height="30" FontSize="12" CornerRadius="4" Padding="8,4" PlaceholderText="master"/>
                            </StackPanel>

                            <!-- Authentication Method (For SQL Server) -->
                            <StackPanel Spacing="4" IsVisible="{Binding SupportsWindowsAuth}">
                                <TextBlock Text="Authentication" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AuthTypes}" SelectedItem="{Binding AuthType}" HorizontalAlignment="Stretch" Height="30" CornerRadius="4" FontSize="12" />
                            </StackPanel>

                            <!-- Username & Password -->
                            <Grid ColumnDefinitions="*, 12, *" IsVisible="{Binding IsCredentialsEnabled}">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Username" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBox Text="{Binding Username}" Height="30" FontSize="12" CornerRadius="4" Padding="8,4" PlaceholderText="sa"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Password" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBox Text="{Binding Password}" PasswordChar="*" Height="30" FontSize="12" CornerRadius="4" Padding="8,4"/>
                                </StackPanel>
                            </Grid>

                            <!-- Options: Trust Server Certificate (SQL Server only) -->
                            <CheckBox IsChecked="{Binding TrustServerCertificate}" 
                                      Content="Trust Server Certificate (SSL/TLS Encryption)" 
                                      FontSize="11" 
                                      Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                      IsVisible="{Binding SupportsTrustCertificate}"
                                      Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- D. FILE-BASED CONFIGURATION (SQLite) -->
                        <StackPanel Spacing="12" IsVisible="{Binding IsFileBased}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Database File Path" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBox Text="{Binding FilePath}" Height="30" FontSize="12" CornerRadius="4" Padding="8,4" PlaceholderText="e.g. C:\data\database.db or :memory:"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Encryption Password (Optional)" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBox Text="{Binding Password}" PasswordChar="*" Height="30" FontSize="12" CornerRadius="4" Padding="8,4"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- E. Status Message Alert -->
                        <Border CornerRadius="4" 
                                Padding="10,8" 
                                BorderThickness="1"
                                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Border.Styles>
                                <!-- Default Testing / Progress Alert -->
                                <Style Selector="Border">
                                    <Setter Property="Background" Value="#EFF6FF" />
                                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                                </Style>
                                <!-- Success Alert -->
                                <Style Selector="Border[Tag=Success]">
                                    <Setter Property="Background" Value="#ECFDF5" />
                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                </Style>
                                <!-- Failure Alert -->
                                <Style Selector="Border[Tag=Error]">
                                    <Setter Property="Background" Value="#FEF2F2" />
                                    <Setter Property="BorderBrush" Value="#FECACA" />
                                </Style>
                            </Border.Styles>
                            <Border.Tag>
                                <MultiBinding>
                                    <MultiBinding.Bindings>
                                        <Binding Path="IsSuccess" />
                                    </MultiBinding.Bindings>
                                </MultiBinding>
                            </Border.Tag>

                            <Grid ColumnDefinitions="Auto, *">
                                <ui:FASymbolIcon Grid.Column="0" 
                                                 Symbol="Sync" 
                                                 FontSize="12" 
                                                 VerticalAlignment="Center" 
                                                 Margin="0,0,8,0"
                                                 Foreground="#2563EB"
                                                 IsVisible="{Binding IsTesting}"/>

                                <TextBlock Grid.Column="1" 
                                           Text="{Binding StatusMessage}" 
                                           FontSize="11" 
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Dialog Footer -->
                <Border Grid.Row="2" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,1,0,0" 
                        CornerRadius="0,0,8,8"
                        Padding="16,10">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Button Grid.Column="0" 
                                Classes="classic-tool-btn" 
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding !IsTesting}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FASymbolIcon Symbol="Sync" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Test Connection" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Classes="classic-tool-btn" 
                                    Content="Cancel" 
                                    Command="{Binding CloseCommand}"/>

                            <Button Background="{DynamicResource AppAccentBrush}" 
                                    Foreground="White" 
                                    FontWeight="SemiBold" 
                                    FontSize="11" 
                                    CornerRadius="4" 
                                    Padding="16,6"
                                    Content="{Binding ConnectButtonText}" 
                                    Command="{Binding ConnectCommand}"
                                    IsEnabled="{Binding !IsConnecting}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
