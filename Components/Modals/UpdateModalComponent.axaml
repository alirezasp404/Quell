<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:b="using:Quell.Behaviors"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Quell.Components.UpdateModalComponent"
             x:DataType="vm:UpdateModalViewModel"
             IsVisible="{Binding IsOpen}">

    <!-- Reusable Software Update & GitHub Release Notification Modal Dialog -->
    <Grid>
        <!-- Backdrop (Click to dismiss) -->
        <Border Classes="modal-backdrop" Cursor="Hand" Focusable="False" FocusAdorner="{x:Null}" Background="{DynamicResource AppModalOverlayBrush}" PointerPressed="OnBackdropPointerPressed" />

        <!-- Centered Dialog Window Card -->
        <Border Classes="modal-dialog-card"
                Background="{DynamicResource AppWorkspaceBrush}" 
                BorderBrush="{DynamicResource AppBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                ClipToBounds="True"
                Focusable="False" FocusAdorner="{x:Null}" 
                BoxShadow="0 10 25 0 #33000000"
                Width="520"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            <i:Interaction.Behaviors>
                <b:GpuModalEntranceBehavior StartScale="0.93" DurationMs="220" />
            </i:Interaction.Behaviors>
            
            <Grid RowDefinitions="Auto, *, Auto">
                
                <!-- 1. Header -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        CornerRadius="8,8,0,0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" 
                                Background="{DynamicResource AppAccentBrush}" 
                                CornerRadius="6" 
                                Width="28" 
                                Height="28" 
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Download" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="New Version Available" 
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                       FontSize="13" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="A new release of Quell Studio is ready on GitHub" 
                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                       FontSize="11"/>
                        </StackPanel>

                        <!-- Dismiss (X) Button -->
                        <Button Grid.Column="2" 
                                Classes="classic-tool-btn" 
                                Command="{Binding DismissCommand}"
                                Padding="4"
                                Width="26" Height="26"
                                ToolTip.Tip="Remind me later (Dismiss)">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Body -->
                <StackPanel Grid.Row="1" Spacing="14" Margin="18,16">
                    
                    <!-- Version Comparison Badges -->
                    <Grid ColumnDefinitions="*, Auto, *">
                        <!-- Current Installed Version -->
                        <Border Grid.Column="0" 
                                Background="{DynamicResource AppSurfaceBrush}" 
                                BorderBrush="{DynamicResource AppBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="12,8">
                            <StackPanel Spacing="3">
                                <TextBlock Text="CURRENT VERSION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                <TextBlock Text="{Binding CurrentVersion}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Arrow Indicator -->
                        <Border Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="ChevronRight" FontSize="14" Foreground="{DynamicResource AppTextMutedBrush}"/>
                        </Border>

                        <!-- Latest Release Version -->
                        <Border Grid.Column="2" 
                                Background="{DynamicResource AppAccentBrush}" 
                                CornerRadius="6" 
                                Padding="12,8">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0" Text="LATEST RELEASE" FontSize="9" FontWeight="Bold" Foreground="#CCFFFFFF"/>
                                    <Border Grid.Column="1" Background="#22C55E" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                        <TextBlock Text="UPDATE" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding LatestVersion}" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Release Title -->
                    <TextBlock Text="{Binding ReleaseTitle}" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Release Highlights / Notes Box -->
                    <Border Background="{DynamicResource AppSurfaceMutedBrush}" 
                            BorderBrush="{DynamicResource AppBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="10" 
                            MaxHeight="140">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ReleaseNotes}" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                       LineHeight="16"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Optional Update Notice -->
                    <Border Background="{DynamicResource AppSurfaceBrush}" 
                            BorderBrush="{DynamicResource AppBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="10,8">
                        <Grid ColumnDefinitions="Auto, *">
                            <ui:FASymbolIcon Grid.Column="0" Symbol="Help" FontSize="13" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" 
                                       Text="Updating is optional. You can download the new version now or continue working and update at any time from 'Get Update' in the status bar." 
                                       FontSize="10.5" 
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                       TextWrapping="Wrap" 
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 3. Footer Actions -->
                <Border Grid.Row="2" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,1,0,0" 
                        CornerRadius="0,0,8,8"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding PublishedAt}" 
                                   FontSize="10" 
                                   Foreground="{DynamicResource AppTextMutedBrush}" 
                                   VerticalAlignment="Center"/>

                        <!-- Secondary: Remind Me Later -->
                        <Button Grid.Column="1" 
                                Classes="classic-tool-btn" 
                                Command="{Binding DismissCommand}"
                                Content="Remind Me Later" 
                                FontSize="11"
                                Padding="12,6" 
                                Margin="0,0,8,0"
                                Cursor="Hand"/>

                        <!-- Primary: Download & Install / View Release -->
                        <Button Grid.Column="2" 
                                Background="{DynamicResource AppAccentBrush}" 
                                Foreground="White" 
                                Command="{Binding OpenReleaseUrlCommand}"
                                FontSize="11" 
                                FontWeight="SemiBold"
                                Padding="14,6" 
                                CornerRadius="4"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ui:FASymbolIcon Symbol="Download" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Download Update" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>