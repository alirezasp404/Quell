<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:b="using:Quell.Behaviors"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Quell.Components.UpdateModalComponent"
             x:DataType="vm:UpdateModalViewModel"
             IsVisible="{Binding IsOpen}">

    <!-- Reusable Software Update 3-Step Modern Dialog (Available -> Downloading -> Ready) -->
    <Grid>
        <!-- Backdrop (Click to dismiss) -->
        <Border Classes="modal-backdrop" Cursor="Hand" Focusable="False" FocusAdorner="{x:Null}" Background="{DynamicResource AppModalOverlayBrush}" PointerPressed="OnBackdropPointerPressed" />

        <!-- Centered Dialog Window Card -->
        <Border Classes="modal-dialog-card"
                Background="{DynamicResource AppSurfaceBrush}"
                Focusable="False"
                Width="460"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            <i:Interaction.Behaviors>
                <b:GpuModalEntranceBehavior StartScale="0.93" DurationMs="200" />
            </i:Interaction.Behaviors>
            
            <Panel Margin="24,22">

                <!-- ======================================================== -->
                <!-- STEP 1: UPDATE AVAILABLE                                  -->
                <!-- ======================================================== -->
                <StackPanel Spacing="16" IsVisible="{Binding IsStep1Available}">
                    <!-- Header with Icon -->
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AppTablePkBadgeBackgroundBrush}" 
                                CornerRadius="8" 
                                Width="40" Height="40" 
                                VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Download" FontSize="18" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding ReleaseTitle}" 
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                       FontSize="15" 
                                       FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="You have" FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                <TextBlock Text="{Binding CurrentVersion}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                <TextBlock Text="{Binding DownloadSize}" FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                <TextBlock Text="{Binding PublishedAt}" FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- What's New Section -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="WHAT'S NEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" LetterSpacing="0.4"/>
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:FASymbolIcon Symbol="Checkmark" FontSize="10" Foreground="{DynamicResource AppStatusActiveBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Faster results grid for large tables" FontSize="12.5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:FASymbolIcon Symbol="Checkmark" FontSize="10" Foreground="{DynamicResource AppStatusActiveBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Schema diagram with foreign-key navigation" FontSize="12.5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:FASymbolIcon Symbol="Checkmark" FontSize="10" Foreground="{DynamicResource AppStatusActiveBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Export to Excel and Markdown" FontSize="12.5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:FASymbolIcon Symbol="Checkmark" FontSize="10" Foreground="{DynamicResource AppStatusActiveBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Fixes for connection time-outs" FontSize="12.5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Release Notes Link -->
                        <Button Background="Transparent" 
                                BorderThickness="0" 
                                Padding="0,4"
                                Command="{Binding OpenReleaseUrlCommand}"
                                Cursor="Hand" 
                                HorizontalAlignment="Left">
                            <TextBlock Text="Full release notes ↗" FontSize="12" Foreground="{DynamicResource AppAccentBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Actions Footer -->
                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,6,0,0">
                        <Button Grid.Column="0" 
                                Classes="classic-tool-btn" 
                                Command="{Binding DismissCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8,6"
                                Content="Skip this version"/>
                        
                        <Button Grid.Column="2" 
                                Classes="classic-tool-btn" 
                                Command="{Binding DismissCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Margin="0,0,8,0"
                                Padding="12,6"
                                Content="Later"/>

                        <Button Grid.Column="3" 
                                Classes="quell-btn-primary"
                                Command="{Binding StartDownloadCommand}"
                                Padding="16,6"
                                Content="Update now">
                            <i:Interaction.Behaviors>
                                <b:GpuButtonPressBehavior PressScale="0.94" />
                            </i:Interaction.Behaviors>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- ======================================================== -->
                <!-- STEP 2: DOWNLOADING PROGRESS                              -->
                <!-- ======================================================== -->
                <StackPanel Spacing="16" IsVisible="{Binding IsStep2Downloading}">
                    <!-- Header with Icon -->
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AppTablePkBadgeBackgroundBrush}" 
                                CornerRadius="8" 
                                Width="40" Height="40" 
                                VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Download" FontSize="18" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Downloading Quell Update" 
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                       FontSize="15" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="You can keep working meanwhile" FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Progress Bar -->
                    <StackPanel Spacing="6">
                        <ProgressBar Value="{Binding DownloadProgress}" 
                                     Minimum="0" Maximum="100" 
                                     Height="6" 
                                     CornerRadius="3"
                                     Foreground="{DynamicResource AppAccentBrush}"
                                     Background="{DynamicResource AppBackgroundBrush}"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding DownloadProgressText}" FontSize="11.5" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                <TextBlock Text="{Binding DownloadSpeed}" FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TimeRemaining}" FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}"/>
                        </Grid>
                    </StackPanel>

                    <!-- State Notice -->
                    <Border Background="{DynamicResource AppSurfaceMutedBrush}" 
                            BorderBrush="{DynamicResource AppBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="12,10">
                        <TextBlock Text="Open tabs and unsaved queries are saved as drafts and restored after the restart." 
                                   FontSize="12" 
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Actions Footer -->
                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,6,0,0">
                        <Button Grid.Column="0" 
                                Classes="classic-tool-btn" 
                                Command="{Binding CancelDownloadCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8,6"
                                Content="Cancel download"/>

                        <Button Grid.Column="2" 
                                Command="{Binding RunInBackgroundCommand}"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                Foreground="{DynamicResource AppTextPrimaryBrush}"
                                FontWeight="Medium"
                                CornerRadius="6"
                                Padding="14,6"
                                Cursor="Hand"
                                Content="Run in background"/>
                    </Grid>
                </StackPanel>

                <!-- ======================================================== -->
                <!-- STEP 3: READY TO RESTART                                  -->
                <!-- ======================================================== -->
                <StackPanel Spacing="16" IsVisible="{Binding IsStep3Ready}">
                    <!-- Header with Icon -->
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AppStatusActiveBackgroundBrush}" 
                                CornerRadius="8" 
                                Width="40" Height="40" 
                                VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Checkmark" FontSize="18" Foreground="{DynamicResource AppStatusActiveBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Update ready to install" 
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                       FontSize="15" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="Quell restart takes a few seconds" FontSize="11.5" Foreground="{DynamicResource AppTextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Checklist -->
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:FASymbolIcon Symbol="Checkmark" FontSize="11" Foreground="{DynamicResource AppStatusActiveBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Unsaved queries saved as drafts" FontSize="12.5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:FASymbolIcon Symbol="Checkmark" FontSize="11" Foreground="{DynamicResource AppStatusActiveBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Active tabs will reopen after restart" FontSize="12.5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:FASymbolIcon Symbol="Checkmark" FontSize="11" Foreground="{DynamicResource AppStatusActiveBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Reconnects to database automatically" FontSize="12.5" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Query Warning Banner (if query running) -->
                    <Border Background="{DynamicResource AppWarningBackgroundBrush}" 
                            BorderBrush="{DynamicResource AppWarningBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="7" 
                            Padding="12,10"
                            IsVisible="{Binding IsQueryRunning}">
                        <TextBlock Text="A query is still running. Restarting will stop it." 
                                   FontSize="12" 
                                   Foreground="{DynamicResource AppWarningForegroundBrush}" 
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Actions Footer -->
                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,6,0,0">
                        <Button Grid.Column="1" 
                                Classes="classic-tool-btn" 
                                Command="{Binding DismissCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Margin="0,0,8,0"
                                Padding="12,6"
                                Content="Restart later"/>

                        <Button Grid.Column="2" 
                                Classes="quell-btn-primary"
                                Command="{Binding RestartNowCommand}"
                                Padding="16,6"
                                Content="Restart now">
                            <i:Interaction.Behaviors>
                                <b:GpuButtonPressBehavior PressScale="0.94" />
                            </i:Interaction.Behaviors>
                        </Button>
                    </Grid>
                </StackPanel>

            </Panel>
        </Border>
    </Grid>
</UserControl>
