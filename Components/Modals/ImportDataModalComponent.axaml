<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:components="using:Quell.Components"
             xmlns:ic="using:FluentIcons.Avalonia"
              xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="820"
             x:Class="Quell.Components.ImportDataModalComponent"
             x:DataType="vm:ImportDataModalViewModel"
             IsVisible="{Binding IsOpen}">

    <UserControl.Styles>
        <Style Selector="Border.canvas-card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 8 24 0 #35000000"/>
        </Style>
        <Style Selector="Border.canvas-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BoxShadow" Value="0 12 32 0 #50000000"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6,1,8,1"/>
        </Style>
    </UserControl.Styles>

    <!-- Reusable Visual Excel / CSV Data Import Modal Dialog -->
    <Grid>
        <!-- Backdrop (Click to dismiss) -->
        <Border Classes="modal-backdrop" 
                Cursor="Hand" 
                Focusable="False" 
                FocusAdorner="{x:Null}" 
                Background="{DynamicResource AppModalOverlayBrush}" 
                PointerPressed="OnBackdropPointerPressed" />

        <!-- Centered Dialog Window Card -->
        <Border Classes="modal-dialog-card"
                Background="{DynamicResource AppWorkspaceBrush}" 
                BorderBrush="{DynamicResource AppBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                ClipToBounds="True"
                Focusable="False" 
                FocusAdorner="{x:Null}" 
                BoxShadow="0 18 45 0 #60000000"
                Width="1050" MaxWidth="1600"
                Height="740" MaxHeight="960"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            
            <Grid RowDefinitions="Auto, Auto, *, Auto">
                
                <!-- 1. Header -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        CornerRadius="8,8,0,0"
                        Padding="16,10">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" 
                                Background="#10B981" 
                                CornerRadius="6" 
                                Width="32" 
                                Height="32" 
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="TableArrowUp" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Import Data from Excel / CSV" 
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                           FontSize="15" 
                                           FontWeight="Bold"/>
                                <Border Background="#1510B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Interactive Pan &amp; Zoom Mapper" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Select target columns to download matching template, customize field inclusion, and graphically link spreadsheet columns" 
                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                       FontSize="11" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                Classes="classic-menu-btn" 
                                Command="{Binding CloseCommand}"
                                Padding="8,4" 
                                MinHeight="26"
                                ToolTip.Tip="Close (Esc)">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="11"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Source & Target Selection Toolbar -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource AppBackgroundBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="16,8">
                    <Grid RowDefinitions="Auto, Auto" RowSpacing="8">
                        <!-- Row 1: Target Table & Template Download -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" 
                                       Text="Target Table:" 
                                       FontWeight="SemiBold" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                       VerticalAlignment="Center"/>

                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding AvailableTables}" 
                                      SelectedItem="{Binding SelectedTable}" 
                                      PlaceholderText="Choose database table to import into..." 
                                      HorizontalAlignment="Stretch" 
                                      Height="28" 
                                      CornerRadius="4" 
                                      FontSize="11"/>

                            <!-- Export Template for Selected Columns Button -->
                            <Button Grid.Column="2" 
                                    Classes="classic-tool-btn" 
                                    Height="28" 
                                    Padding="10,2"
                                    Command="{Binding DownloadTemplateCommand}"
                                    ToolTip.Tip="Generate and download Excel template containing ONLY the checked/selected columns">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ui:FASymbolIcon Symbol="Document" FontSize="11" Foreground="#10B981"/>
                                    <TextBlock Text="{Binding IncludedColumnsCount, StringFormat='Download Template ({0} Cols)'}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Refresh / Auto-Map Action -->
                            <Button Grid.Column="3" 
                                    Classes="classic-tool-btn" 
                                    Height="28" 
                                    Padding="8,2"
                                    Command="{Binding AutoMapColumnsCommand}"
                                    ToolTip.Tip="Re-map columns automatically">
                                <ui:FASymbolIcon Symbol="Sync" FontSize="11" Foreground="#38BDF8"/>
                            </Button>
                        </Grid>

                        <!-- Row 2: File Browser & Sheet Selector -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" 
                                       Text="Spreadsheet:" 
                                       FontWeight="SemiBold" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                       VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1" 
                                     Text="{Binding FilePath}" 
                                     PlaceholderText="Select Excel (.xlsx) or CSV (.csv) file from disk..." 
                                     Height="28" 
                                     FontSize="11" 
                                     CornerRadius="4" 
                                     Padding="8,3" 
                                     IsReadOnly="True"/>

                            <!-- Sheet Selector if multiple sheets -->
                            <ComboBox Grid.Column="2" 
                                      ItemsSource="{Binding AvailableSheets}" 
                                      SelectedItem="{Binding SelectedSheet}" 
                                      Height="28" 
                                      FontSize="11" 
                                      CornerRadius="4" 
                                      IsVisible="{Binding AvailableSheets.Count}"
                                      ToolTip.Tip="Active Excel Sheet"/>

                            <Button Grid.Column="3" 
                                    Classes="classic-tool-btn" 
                                    Height="28" 
                                    Padding="12,2"
                                    Command="{Binding BrowseFileCommand}"
                                    CommandParameter="{Binding $parent[TopLevel]}"
                                    ToolTip.Tip="Browse spreadsheet file from disk">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ui:FASymbolIcon Symbol="Folder" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                    <TextBlock Text="Browse File..." FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. Main Body: Tabs & Visual Mapping Area -->
                <Grid Grid.Row="2" RowDefinitions="Auto, *">
                    <!-- Tab Navigation Header Strip -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource AppSurfaceBrush}" 
                            BorderBrush="{DynamicResource AppBorderBrush}" 
                            BorderThickness="0,0,0,1" 
                            Padding="16,3,16,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                <Button Classes="classic-tab-btn" 
                                        Height="28" 
                                        Padding="12,2" 
                                        Command="{Binding SetTabCommand}" 
                                        CommandParameter="Mapping">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FASymbolIcon Symbol="Link" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                        <TextBlock Text="Visual Column Mapping" FontSize="11" FontWeight="SemiBold"/>
                                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="6,1" Margin="2,0,0,0">
                                            <TextBlock Text="{Binding MappedColumnsCount, StringFormat='{}{0}'}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <Button Classes="classic-tab-btn" 
                                        Height="28" 
                                        Padding="12,2" 
                                        Command="{Binding SetTabCommand}" 
                                        CommandParameter="ExcelPreview"
                                        IsEnabled="{Binding HasFileLoaded}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FASymbolIcon Symbol="Preview" FontSize="11"/>
                                        <TextBlock Text="Excel Data Preview" FontSize="11"/>
                                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="6,1" Margin="2,0,0,0" IsVisible="{Binding HasFileLoaded}">
                                            <TextBlock Text="{Binding TotalExcelRowsCount, StringFormat='{}{0:N0} rows'}" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <Button Classes="classic-tab-btn" 
                                        Height="28" 
                                        Padding="12,2" 
                                        Command="{Binding SetTabCommand}" 
                                        CommandParameter="ImportPreview"
                                        IsEnabled="{Binding HasFileLoaded}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FASymbolIcon Symbol="Document" FontSize="11"/>
                                        <TextBlock Text="Mapped Import Preview" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- View Mode & Mapping Controls Toolbar (Right side of tab strip) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsMappingTab}">
                                <!-- Column Selection Controls -->
                                <Button Classes="classic-tool-btn" 
                                        Height="24" 
                                        Padding="7,1" 
                                        Command="{Binding SelectAllColumnsCommand}" 
                                        ToolTip.Tip="Select all columns for template &amp; import">
                                    <TextBlock Text="Select All" FontSize="10"/>
                                </Button>

                                <Button Classes="classic-tool-btn" 
                                        Height="24" 
                                        Padding="7,1" 
                                        Command="{Binding DeselectAllColumnsCommand}" 
                                        ToolTip.Tip="Deselect all columns">
                                    <TextBlock Text="Deselect All" FontSize="10"/>
                                </Button>

                                <Button Classes="classic-tool-btn" 
                                        Height="24" 
                                        Padding="7,1" 
                                        Command="{Binding SelectRequiredColumnsCommand}" 
                                        ToolTip.Tip="Select only required database columns">
                                    <TextBlock Text="Only Required" FontSize="10"/>
                                </Button>

                                <Rectangle Width="1" Height="14" Fill="{DynamicResource AppBorderBrush}" Margin="2,0"/>

                                <!-- Views Mode Dropdown Menu (Canvas / List) -->
                                <Button Classes="classic-tool-btn" 
                                        Height="24" 
                                        Padding="8,1" 
                                        ToolTip.Tip="Select View Mode: Interactive 2D Canvas or Structured Columns List">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuItem Header="Canvas View" 
                                                      FontSize="10.5" Height="24" MinHeight="22" Padding="6,1,8,1"
                                                      Command="{Binding SetViewModeCommand}" 
                                                      CommandParameter="Canvas"
                                                      ToolTip.Tip="Interactive 2D Canvas with Pan &amp; Zoom">
                                                <MenuItem.Icon>
                                                    <ui:FASymbolIcon Symbol="Preview" FontSize="9" Foreground="#38BDF8"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="List View" 
                                                      FontSize="10.5" Height="24" MinHeight="22" Padding="6,1,8,1"
                                                      Command="{Binding SetViewModeCommand}" 
                                                      CommandParameter="List"
                                                      ToolTip.Tip="Detailed list view of database columns and mappings">
                                                <MenuItem.Icon>
                                                    <ui:FASymbolIcon Symbol="Document" FontSize="9" Foreground="#10B981"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Preview" FontSize="9" Foreground="#38BDF8" IsVisible="{Binding IsCanvasView}"/>
                                        <ui:FASymbolIcon Symbol="Document" FontSize="9" Foreground="#10B981" IsVisible="{Binding IsListView}"/>
                                        <TextBlock Text="Views" FontSize="10" FontWeight="SemiBold"/>
                                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="{Binding ViewMode}" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        </Border>
                                        <ui:FASymbolIcon Symbol="ChevronDown" FontSize="7" Foreground="{DynamicResource AppTextMutedBrush}" Margin="2,1,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Rectangle Width="1" Height="14" Fill="{DynamicResource AppBorderBrush}" Margin="2,0"/>

                                <!-- Auto-Map & 1:1 Position Mapping Dropdown Menu -->
                                <Button Classes="classic-tool-btn" 
                                        Height="24" 
                                        Padding="8,1" 
                                        ToolTip.Tip="Select mapping strategy (Auto-Map or 1:1 Position)">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuItem Header="Auto-Map" 
                                                      FontSize="10.5" Height="24" MinHeight="22" Padding="6,1,8,1"
                                                      Command="{Binding AutoMapColumnsCommand}"
                                                      ToolTip.Tip="Smart match columns by English &amp; Persian names, synonyms, and types">
                                                <MenuItem.Icon>
                                                    <ui:FASymbolIcon Symbol="Sync" FontSize="9" Foreground="#38BDF8"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="1:1 Position" 
                                                      FontSize="10.5" Height="24" MinHeight="22" Padding="6,1,8,1"
                                                      Command="{Binding MapByPositionCommand}"
                                                      ToolTip.Tip="Connect columns 1:1 in sequential order (ideal for templates)">
                                                <MenuItem.Icon>
                                                    <ui:FASymbolIcon Symbol="Forward" FontSize="9" Foreground="#10B981"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Margin="0,1"/>
                                            <MenuItem Header="Clear All" 
                                                      FontSize="10.5" Height="24" MinHeight="22" Padding="6,1,8,1"
                                                      Command="{Binding ClearMappingsCommand}"
                                                      ToolTip.Tip="Disconnect all mapped columns">
                                                <MenuItem.Icon>
                                                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="9" Foreground="#EF4444"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Sync" FontSize="9" Foreground="#38BDF8" IsVisible="{Binding IsAutoMapStrategy}"/>
                                        <ui:FASymbolIcon Symbol="Forward" FontSize="9" Foreground="#10B981" IsVisible="{Binding IsPositionStrategy}"/>
                                        <TextBlock Text="{Binding ActiveMappingStrategy}" FontSize="10" FontWeight="SemiBold"/>
                                        <ui:FASymbolIcon Symbol="ChevronDown" FontSize="7" Foreground="{DynamicResource AppTextMutedBrush}" Margin="2,1,0,0"/>
                                    </StackPanel>
                                </Button>

                                <Button Classes="classic-tool-btn" 
                                        Height="24" 
                                        Padding="8,1" 
                                        Command="{Binding ClearMappingsCommand}"
                                        ToolTip.Tip="Clear all column connections">
                                    <TextBlock Text="Clear All" FontSize="10"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TAB 1: VISUAL COLUMN MAPPING -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsMappingTab}">
                        
                        <!-- ============================================================== -->
                        <!-- MODE A: INTERACTIVE PAN & ZOOM CANVAS VIEW                     -->
                        <!-- ============================================================== -->
                        <Grid IsVisible="{Binding IsCanvasView}" RowDefinitions="Auto, *">
                            
                            <!-- Canvas Pan/Zoom Floating Bar -->
                            <Border Grid.Row="0" 
                                    Background="{DynamicResource AppBackgroundBrush}" 
                                    BorderBrush="{DynamicResource AppBorderBrush}" 
                                    BorderThickness="0,0,0,1" 
                                    Padding="16,4">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <!-- Column Selection & Link Counters -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Background="#1538BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="12" Padding="8,2">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="Selected:" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                <TextBlock Text="{Binding IncludedColumnsCount, StringFormat='{}{0}'}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="of" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                <TextBlock Text="{Binding TotalTableColumnsCount, StringFormat='{}{0} Columns'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="12" Padding="8,2">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <ui:FASymbolIcon Symbol="Link" FontSize="10" Foreground="#10B981"/>
                                                <TextBlock Text="{Binding MappedColumnsCount, StringFormat='{}{0}'}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                                <TextBlock Text="Connected" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                                <TextBlock Text="{Binding MappedPercentage, StringFormat='({0}%)'}" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Pan & Zoom Control Tools -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Classes="classic-tool-btn" Height="24" Padding="6,1" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom In (+)">
                                            <ui:FASymbolIcon Symbol="Add" FontSize="9"/>
                                        </Button>

                                        <Button Classes="classic-tool-btn" Height="24" Padding="6,1" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom Out (-)">
                                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="9"/>
                                        </Button>

                                        <Button Classes="classic-tool-btn" Height="24" Padding="8,1" Command="{Binding ResetZoomCommand}" ToolTip.Tip="Reset Zoom (100%)">
                                            <TextBlock Text="{Binding ZoomPercentageText}" FontSize="10" FontWeight="Bold"/>
                                        </Button>

                                        <Button Classes="classic-tool-btn" Height="24" Padding="8,1" Command="{Binding FitToViewCommand}" ToolTip.Tip="Fit All Columns in View (Double-click Canvas)">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <ui:FASymbolIcon Symbol="FullScreen" FontSize="9" Foreground="#38BDF8"/>
                                                <TextBlock Text="Fit" FontSize="10" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Interactive 2D Viewport Container -->
                            <Grid Grid.Row="1" 
                                  x:Name="ViewportContainer"
                                  Background="{DynamicResource AppWorkspaceBrush}"
                                  ClipToBounds="True"
                                  PointerPressed="OnCanvasPointerPressed"
                                  PointerMoved="OnCanvasPointerMoved"
                                  PointerReleased="OnCanvasPointerReleased"
                                  PointerWheelChanged="OnCanvasPointerWheelChanged"
                                  DoubleTapped="OnCanvasDoubleTapped">

                                <!-- World Canvas (Scalable & Pannable) -->
                                <Canvas x:Name="WorldCanvas"
                                        Width="2600" Height="2000"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">

                                    <!-- 1. Background Blueprint CAD Grid & Bezier Cables Surface -->
                                    <components:MappingSurfaceControl x:Name="MappingSurface"
                                                                      Width="2600" Height="2000"
                                                                      ViewModel="{Binding}" />

                                    <!-- 2. Target Database Table Node Card (Left Node at X:50, Y:40) -->
                                    <Border Canvas.Left="50" Canvas.Top="40"
                                            Classes="canvas-card"
                                            Width="320">
                                        <Grid RowDefinitions="Auto, *">
                                            <!-- Card Header -->
                                            <Border Grid.Row="0" 
                                                    Background="{DynamicResource AppBackgroundBrush}" 
                                                    BorderBrush="{DynamicResource AppBorderBrush}" 
                                                    BorderThickness="0,0,0,1" 
                                                    CornerRadius="8,8,0,0" 
                                                    Padding="12,10">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <Border Grid.Column="0" Background="#2038BDF8" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                                        <ic:SymbolIcon Symbol="Table" FontSize="14" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedTable, FallbackValue='Database Table'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding IncludedColumnsCount, StringFormat='Target Table Fields ({0} active)'}" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Table Column Rows List -->
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ColumnMappings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:ImportColumnMappingItem">
                                                        <Border Height="36" 
                                                                Background="{DynamicResource AppSurfaceBrush}" 
                                                                BorderBrush="{DynamicResource AppBorderBrush}" 
                                                                BorderThickness="0,0,0,1" 
                                                                Padding="8,0">
                                                            <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" VerticalAlignment="Center">
                                                                <!-- Inclusion Checkbox (Controls if column is in template & import!) -->
                                                                <CheckBox Grid.Column="0" 
                                                                          IsChecked="{Binding IsIncluded}" 
                                                                          Margin="0,0,6,0" 
                                                                          ToolTip.Tip="Check to include this column in template download and data import"/>

                                                                <!-- PK / REQ / NULL Badge -->
                                                                <Border Grid.Column="1" Background="{Binding PkBadgeColor}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding PkBadgeText}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                                                </Border>

                                                                <!-- Column Name -->
                                                                <TextBlock Grid.Column="2" 
                                                                           Text="{Binding TargetColumnName}" 
                                                                           FontSize="11" 
                                                                           FontWeight="SemiBold" 
                                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                                                           TextTrimming="CharacterEllipsis" 
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Data Type Badge -->
                                                                <Border Grid.Column="3" Background="{Binding DataTypeBadgeColor}" CornerRadius="3" Padding="4,1" Margin="6,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DataType}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                                                </Border>

                                                                <!-- Output Connection Port (Visual Circle) -->
                                                                <Ellipse Grid.Column="4" 
                                                                         Width="10" Height="10" 
                                                                         Fill="{Binding NodeColor}" 
                                                                         Stroke="{DynamicResource AppBorderBrush}" 
                                                                         StrokeThickness="1" 
                                                                         Margin="4,0,0,0" 
                                                                         VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>

                                    <!-- 3. Excel Spreadsheet Source Node Card (Right Node at X:640, Y:40) -->
                                    <Border Canvas.Left="640" Canvas.Top="40"
                                            Classes="canvas-card"
                                            Width="360">
                                        <Grid RowDefinitions="Auto, *">
                                            <!-- Card Header -->
                                            <Border Grid.Row="0" 
                                                    Background="{DynamicResource AppBackgroundBrush}" 
                                                    BorderBrush="{DynamicResource AppBorderBrush}" 
                                                    BorderThickness="0,0,0,1" 
                                                    CornerRadius="8,8,0,0" 
                                                    Padding="12,10">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <Border Grid.Column="0" Background="#2010B981" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                                                        <ic:SymbolIcon Symbol="DocumentTable" FontSize="14" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName, FallbackValue='Spreadsheet File'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding TotalExcelRowsCount, StringFormat='Excel Columns ({0:N0} data rows)'}" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Excel Columns List with Live Sample Previews -->
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding ExcelColumnItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:ExcelColumnDisplayItem">
                                                        <Border Height="36" 
                                                                Background="{DynamicResource AppSurfaceBrush}" 
                                                                BorderBrush="{DynamicResource AppBorderBrush}" 
                                                                BorderThickness="0,0,0,1" 
                                                                Padding="8,0">
                                                            <Grid ColumnDefinitions="Auto, Auto, *, Auto" VerticalAlignment="Center">
                                                                <!-- Input Connection Port (Visual Circle) -->
                                                                <Ellipse Grid.Column="0" 
                                                                         Width="10" Height="10" 
                                                                         Fill="#10B981" 
                                                                         Stroke="{DynamicResource AppBorderBrush}" 
                                                                         StrokeThickness="1" 
                                                                         Margin="0,0,8,0" 
                                                                         VerticalAlignment="Center"/>

                                                                <!-- Column Letter Badge [A], [B] -->
                                                                <Border Grid.Column="1" Background="#2010B981" BorderBrush="#4010B981" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding ColumnLetter}" FontSize="8" FontWeight="Bold" Foreground="#10B981"/>
                                                                </Border>

                                                                <!-- Header Name -->
                                                                <TextBlock Grid.Column="2" 
                                                                           Text="{Binding HeaderName}" 
                                                                           FontSize="11" 
                                                                           FontWeight="Bold" 
                                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                                                           TextTrimming="CharacterEllipsis" 
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Live Sample Value Pill -->
                                                                <Border Grid.Column="3" 
                                                                        Background="{DynamicResource AppBackgroundBrush}" 
                                                                        BorderBrush="{DynamicResource AppBorderBrush}" 
                                                                        BorderThickness="1" 
                                                                        CornerRadius="3" 
                                                                        Padding="6,1" 
                                                                        MaxWidth="140">
                                                                    <TextBlock Text="{Binding SampleText}" 
                                                                               FontSize="9" 
                                                                               Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Grid>

                        <!-- ============================================================== -->
                        <!-- MODE B: DETAILED STRUCTURED LIST VIEW                          -->
                        <!-- ============================================================== -->
                        <Grid IsVisible="{Binding IsListView}" Margin="16,10" RowDefinitions="Auto, *">
                            
                            <!-- Filter Chips Bar -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="classic-tab-btn" Height="24" Padding="8,1" Command="{Binding SetFilterCommand}" CommandParameter="All">
                                        <TextBlock Text="{Binding TotalTableColumnsCount, StringFormat='All ({0})'}" FontSize="10" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Classes="classic-tab-btn" Height="24" Padding="8,1" Command="{Binding SetFilterCommand}" CommandParameter="Included">
                                        <TextBlock Text="{Binding IncludedColumnsCount, StringFormat='Included ({0})'}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                    </Button>
                                    <Button Classes="classic-tab-btn" Height="24" Padding="8,1" Command="{Binding SetFilterCommand}" CommandParameter="Mapped">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border Background="#10B981" Width="6" Height="6" CornerRadius="3"/>
                                            <TextBlock Text="{Binding MappedColumnsCount, StringFormat='Connected ({0})'}" FontSize="10" FontWeight="SemiBold" Foreground="#10B981"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="classic-tab-btn" Height="24" Padding="8,1" Command="{Binding SetFilterCommand}" CommandParameter="Unmapped">
                                        <TextBlock Text="{Binding UnmappedColumnsCount, StringFormat='Unmapped ({0})'}" FontSize="10" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Classes="classic-tab-btn" Height="24" Padding="8,1" Command="{Binding SetFilterCommand}" CommandParameter="Required">
                                        <TextBlock Text="{Binding RequiredColumnsCount, StringFormat='Required ({0})'}" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                    </Button>
                                </StackPanel>

                                <Grid Grid.Column="2" ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                    <TextBlock Text="Target Field" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Pipeline Link" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="Source Column &amp; Sample" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                </Grid>
                            </Grid>

                            <!-- Mapping Cards List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="6">
                                    <ItemsControl ItemsSource="{Binding FilteredColumnMappings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ImportColumnMappingItem">
                                                <Border Background="{DynamicResource AppSurfaceBrush}" 
                                                        BorderBrush="{Binding CardBorderBrush}" 
                                                        BorderThickness="1.5" 
                                                        CornerRadius="8" 
                                                        Padding="12,8" 
                                                        Margin="0,2"
                                                        BoxShadow="0 2 6 0 #10000000">
                                                    <Grid ColumnDefinitions="320, 130, *" VerticalAlignment="Center">
                                                        
                                                        <!-- 1. Left: Target Database Column with Inclusion Checkbox -->
                                                        <Border Grid.Column="0" 
                                                                Background="{DynamicResource AppBackgroundBrush}" 
                                                                BorderBrush="{DynamicResource AppBorderBrush}" 
                                                                BorderThickness="1" 
                                                                CornerRadius="6" 
                                                                Padding="8,6">
                                                            <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" VerticalAlignment="Center">
                                                                <CheckBox Grid.Column="0" 
                                                                          IsChecked="{Binding IsIncluded}" 
                                                                          Margin="0,0,6,0"
                                                                          ToolTip.Tip="Include in template download and data import"/>

                                                                <Border Grid.Column="1" Background="{Binding PkBadgeColor}" CornerRadius="4" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding PkBadgeText}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                                                </Border>

                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                                    <TextBlock Text="{Binding TargetColumnName}" 
                                                                               FontSize="12" 
                                                                               FontWeight="Bold" 
                                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Border Background="{Binding DataTypeBadgeColor}" CornerRadius="3" Padding="4,0" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                                        <TextBlock Text="{Binding DataType}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                                                    </Border>
                                                                </StackPanel>

                                                                <Ellipse Grid.Column="4" 
                                                                         Width="10" Height="10" 
                                                                         Fill="{Binding NodeColor}" 
                                                                         Stroke="{DynamicResource AppBorderBrush}" 
                                                                         StrokeThickness="1"
                                                                         Margin="6,0,0,0"
                                                                         VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- 2. Center: Connection Wire & Status -->
                                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                                            <Rectangle Height="2" Fill="{Binding NodeColor}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                                                <Border Background="{Binding StatusBackground}" 
                                                                        BorderBrush="{Binding StatusForeground}" 
                                                                        BorderThickness="1" 
                                                                        CornerRadius="10" 
                                                                        Padding="6,1"
                                                                        HorizontalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                                        <ui:FASymbolIcon Symbol="Forward" FontSize="7" Foreground="{Binding StatusForeground}"/>
                                                                        <TextBlock Text="{Binding StatusBadge}" FontSize="8" FontWeight="Bold" Foreground="{Binding StatusForeground}"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <Button Classes="classic-menu-btn" 
                                                                        Command="{Binding UnlinkCommand}"
                                                                        Height="18" 
                                                                        Padding="4,0" 
                                                                        HorizontalAlignment="Center"
                                                                        IsVisible="{Binding IsMapped}"
                                                                        ToolTip.Tip="Disconnect this mapping">
                                                                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="8" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- 3. Right: Source Column & Sample Preview -->
                                                        <Border Grid.Column="2" 
                                                                Background="{DynamicResource AppBackgroundBrush}" 
                                                                BorderBrush="{DynamicResource AppBorderBrush}" 
                                                                BorderThickness="1" 
                                                                CornerRadius="6" 
                                                                Padding="10,6">
                                                            <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                                                                <Ellipse Grid.Column="0" 
                                                                         Width="10" Height="10" 
                                                                         Fill="{Binding NodeColor}" 
                                                                         Stroke="{DynamicResource AppBorderBrush}" 
                                                                         StrokeThickness="1" 
                                                                         Margin="0,0,8,0" 
                                                                         VerticalAlignment="Center"/>

                                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                                                        <ComboBox Grid.Column="0" 
                                                                                  ItemsSource="{Binding AvailableExcelColumns}" 
                                                                                  SelectedItem="{Binding SelectedExcelColumn}" 
                                                                                  HorizontalAlignment="Stretch" 
                                                                                  Height="28" 
                                                                                  FontSize="11" 
                                                                                  CornerRadius="4"/>

                                                                        <TextBox Grid.Column="1" 
                                                                                 Width="120" 
                                                                                 Height="28" 
                                                                                 FontSize="11" 
                                                                                 CornerRadius="4" 
                                                                                 PlaceholderText="Constant value..." 
                                                                                 Text="{Binding ConstantValue}" 
                                                                                 IsVisible="{Binding IsConstant}"/>
                                                                    </Grid>

                                                                    <Border Background="{DynamicResource AppSurfaceBrush}" 
                                                                            BorderBrush="{DynamicResource AppBorderBrush}" 
                                                                            BorderThickness="1" 
                                                                            CornerRadius="4" 
                                                                            Padding="6,2">
                                                                        <Grid ColumnDefinitions="Auto, *">
                                                                            <ui:FASymbolIcon Grid.Column="0" Symbol="Preview" FontSize="9" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" 
                                                                                       Text="{Binding SamplePreviewValue}" 
                                                                                       FontSize="9" 
                                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                                                                       TextTrimming="CharacterEllipsis" 
                                                                                       VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- TAB 2: EXCEL DATA PREVIEW -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsExcelPreviewTab}" Margin="16,10">
                        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10" Spacing="6">
                                    <TextBlock Text="Raw Excel File Preview (First 10 Rows)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding RawPreviewRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                                    <ItemsControl ItemsSource="{Binding}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="16"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Width="120">
                                                                    <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Value}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- TAB 3: MAPPED IMPORT PREVIEW -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsImportPreviewTab}" Margin="16,10">
                        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10" Spacing="6">
                                    <TextBlock Text="Target Table Mapped Preview (Data to be inserted into database)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding MappedPreviewRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                                    <ItemsControl ItemsSource="{Binding}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="16"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Width="120">
                                                                    <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold" Foreground="#10B981" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Value}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 4. Footer & Action Controls -->
                <Border Grid.Row="3" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,1,0,0" 
                        CornerRadius="0,0,8,8" 
                        Padding="16,10">
                    <Grid RowDefinitions="Auto, Auto">
                        
                        <!-- Top: Options Strip & Status -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8">
                            <!-- Import Options -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <!-- Mode Selector Dropdown -->
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Mode:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding ImportModes}" 
                                              SelectedItem="{Binding SelectedImportMode}" 
                                              Height="24" FontSize="10.5" CornerRadius="4"
                                              ToolTip.Tip="Append new records, Overwrite/Update existing records, or Truncate table first"/>
                                </StackPanel>

                                <!-- Match On / Key Column Dropdown (Visible only in Overwrite Mode) -->
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsOverwriteMode}">
                                    <TextBlock Text="Match On:" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding AvailableKeyColumns}" 
                                              SelectedItem="{Binding SelectedKeyColumn}" 
                                              Height="24" FontSize="10.5" CornerRadius="4"
                                              ToolTip.Tip="Column used to match existing rows to update (e.g. Primary Key, ID, Date, Code)"/>
                                </StackPanel>

                                <Rectangle Width="1" Height="14" Fill="{DynamicResource AppBorderBrush}" Margin="2,0"/>

                                <CheckBox Content="First row is header" 
                                          IsChecked="{Binding FirstRowIsHeader}" 
                                          FontSize="10.5"/>

                                <CheckBox Content="Skip error rows" 
                                          IsChecked="{Binding SkipErrors}" 
                                          FontSize="10.5" 
                                          ToolTip.Tip="Continue importing remaining rows if any individual row has constraint violations"/>
                            </StackPanel>

                            <!-- Status Message -->
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding StatusMessage}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{Binding StatusColor}"
                                       IsVisible="{Binding HasStatusMessage}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Margin="8,0"/>

                            <!-- Batch Size Selector -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Batch Size:" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding BatchSizes}" SelectedItem="{Binding BatchSize}" Height="24" FontSize="10" CornerRadius="4"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bottom: Progress Bar & Action Buttons -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            
                            <!-- Progress Bar & Text during import -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" IsVisible="{Binding IsImporting}">
                                <ProgressBar Value="{Binding ImportProgress}" Maximum="100" Height="6" CornerRadius="3" Foreground="#10B981"/>
                                <TextBlock Text="{Binding ImportProgressText}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Spacer when not importing -->
                            <Panel Grid.Column="0" IsVisible="{Binding !IsImporting}"/>

                            <!-- Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="classic-tool-btn" 
                                        Content="Cancel" 
                                        Command="{Binding CloseCommand}" 
                                        Height="30" 
                                        Padding="14,2" 
                                        FontSize="11"/>

                                <Button Classes="classic-tool-btn" 
                                        Command="{Binding DownloadTemplateCommand}" 
                                        Height="30" 
                                        Padding="12,2" 
                                        FontSize="11"
                                        ToolTip.Tip="Export empty template Excel file for clients (ONLY includes checked columns)">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Download" FontSize="10"/>
                                        <TextBlock Text="{Binding IncludedColumnsCount, StringFormat='Template ({0})'}" FontSize="11"/>
                                    </StackPanel>
                                </Button>

                                <Button Classes="primary-action-btn" 
                                        Command="{Binding ExecuteImportCommand}" 
                                        IsEnabled="{Binding !IsImporting}"
                                        Height="30" 
                                        Padding="16,2" 
                                        FontSize="11">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Upload" FontSize="11" Foreground="White"/>
                                        <TextBlock Text="{Binding ImportButtonText}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>