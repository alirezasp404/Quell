<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="Quell.Components.ImportDataModalComponent"
             x:DataType="vm:ImportDataModalViewModel"
             IsVisible="{Binding IsOpen}">

    <!-- Reusable Visual Excel / CSV Data Import Modal Dialog -->
    <Grid>
        <!-- Backdrop (Click to dismiss) -->
        <Border Classes="modal-backdrop" 
                Cursor="Hand" 
                Focusable="False" 
                FocusAdorner="{x:Null}" 
                Background="{DynamicResource AppModalOverlayBrush}" 
                PointerPressed="OnBackdropPointerPressed" />

        <!-- Centered Dialog Window Card -->
        <Border Classes="modal-dialog-card"
                Background="{DynamicResource AppWorkspaceBrush}" 
                BorderBrush="{DynamicResource AppBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                ClipToBounds="True"
                Focusable="False" 
                FocusAdorner="{x:Null}" 
                BoxShadow="0 16 40 0 #50000000"
                Width="980"
                MaxHeight="720"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            
            <Grid RowDefinitions="Auto, Auto, *, Auto">
                
                <!-- 1. Header -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        CornerRadius="8,8,0,0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" 
                                Background="#10B981" 
                                CornerRadius="6" 
                                Width="32" 
                                Height="32" 
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Download" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Import Data from Excel / CSV" 
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                           FontSize="15" 
                                           FontWeight="Bold"/>
                                <Border Background="#1510B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Graphical Pipeline &amp; Auto-Mapper" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Visually connect spreadsheet columns to database table fields with live sample preview" 
                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                       FontSize="11" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                Classes="classic-menu-btn" 
                                Command="{Binding CloseCommand}"
                                Padding="8,4" 
                                MinHeight="26"
                                ToolTip.Tip="Close (Esc)">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="11"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Source & Target Selection Toolbar -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource AppBackgroundBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="16,10">
                    <Grid RowDefinitions="Auto, Auto" RowSpacing="10">
                        <!-- Row 1: Target Table & Template Download -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" 
                                       Text="Target Table:" 
                                       FontWeight="SemiBold" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                       VerticalAlignment="Center"/>

                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding AvailableTables}" 
                                      SelectedItem="{Binding SelectedTable}" 
                                      PlaceholderText="Choose database table to import into..." 
                                      HorizontalAlignment="Stretch" 
                                      Height="30" 
                                      CornerRadius="4" 
                                      FontSize="11"/>

                            <!-- Export Template for Table Button -->
                            <Button Grid.Column="2" 
                                    Classes="classic-tool-btn" 
                                    Height="30" 
                                    Padding="10,2"
                                    Command="{Binding DownloadTemplateCommand}"
                                    ToolTip.Tip="Generate and download empty Excel template matching this table for clients to fill">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ui:FASymbolIcon Symbol="Document" FontSize="11" Foreground="#10B981"/>
                                    <TextBlock Text="Download Template" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Refresh / Auto-Map Action -->
                            <Button Grid.Column="3" 
                                    Classes="classic-tool-btn" 
                                    Height="30" 
                                    Padding="8,2"
                                    Command="{Binding AutoMapColumnsCommand}"
                                    ToolTip.Tip="Re-map columns automatically">
                                <ui:FASymbolIcon Symbol="Sync" FontSize="11" Foreground="#38BDF8"/>
                            </Button>
                        </Grid>

                        <!-- Row 2: File Browser & Sheet Selector -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" 
                                       Text="Spreadsheet:" 
                                       FontWeight="SemiBold" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                       VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1" 
                                     Text="{Binding FilePath}" 
                                     PlaceholderText="Select Excel (.xlsx) or CSV (.csv) file from disk..." 
                                     Height="30" 
                                     FontSize="11" 
                                     CornerRadius="4" 
                                     Padding="8,4" 
                                     IsReadOnly="True"/>

                            <!-- Sheet Selector if multiple sheets -->
                            <ComboBox Grid.Column="2" 
                                      ItemsSource="{Binding AvailableSheets}" 
                                      SelectedItem="{Binding SelectedSheet}" 
                                      Height="30" 
                                      FontSize="11" 
                                      CornerRadius="4" 
                                      IsVisible="{Binding AvailableSheets.Count}"
                                      ToolTip.Tip="Active Excel Sheet"/>

                            <Button Grid.Column="3" 
                                    Classes="classic-tool-btn" 
                                    Height="30" 
                                    Padding="12,2"
                                    Command="{Binding BrowseFileCommand}"
                                    CommandParameter="{Binding $parent[TopLevel]}"
                                    ToolTip.Tip="Browse spreadsheet file from disk">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ui:FASymbolIcon Symbol="Folder" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                    <TextBlock Text="Browse File..." FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. Main Body: Tabs & Visual Mapping Area -->
                <Grid Grid.Row="2" RowDefinitions="Auto, *">
                    <!-- Tab Navigation Header Strip -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource AppSurfaceBrush}" 
                            BorderBrush="{DynamicResource AppBorderBrush}" 
                            BorderThickness="0,0,0,1" 
                            Padding="16,4,16,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                <Button Classes="classic-tab-btn" 
                                        Height="28" 
                                        Padding="12,2" 
                                        Command="{Binding SetTabCommand}" 
                                        CommandParameter="Mapping">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FASymbolIcon Symbol="Link" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                        <TextBlock Text="Visual Column Mapping" FontSize="11" FontWeight="SemiBold"/>
                                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="6,1" Margin="2,0,0,0">
                                            <TextBlock Text="{Binding MappedColumnsCount, StringFormat='{}{0}'}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <Button Classes="classic-tab-btn" 
                                        Height="28" 
                                        Padding="12,2" 
                                        Command="{Binding SetTabCommand}" 
                                        CommandParameter="ExcelPreview"
                                        IsEnabled="{Binding HasFileLoaded}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FASymbolIcon Symbol="Preview" FontSize="11"/>
                                        <TextBlock Text="Excel Data Preview" FontSize="11"/>
                                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="6,1" Margin="2,0,0,0" IsVisible="{Binding HasFileLoaded}">
                                            <TextBlock Text="{Binding TotalExcelRowsCount, StringFormat='{}{0:N0} rows'}" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <Button Classes="classic-tab-btn" 
                                        Height="28" 
                                        Padding="12,2" 
                                        Command="{Binding SetTabCommand}" 
                                        CommandParameter="ImportPreview"
                                        IsEnabled="{Binding HasFileLoaded}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FASymbolIcon Symbol="Document" FontSize="11"/>
                                        <TextBlock Text="Mapped Import Preview" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Mapping Controls Toolbar (Right side of tab strip) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsMappingTab}">
                                <Button Classes="classic-tool-btn" 
                                        Height="24" 
                                        Padding="8,1" 
                                        Command="{Binding AutoMapColumnsCommand}"
                                        ToolTip.Tip="Smart match columns by English &amp; Persian names, synonyms, and types">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Sync" FontSize="9" Foreground="#38BDF8"/>
                                        <TextBlock Text="Smart Auto-Map" FontSize="10" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button Classes="classic-tool-btn" 
                                        Height="24" 
                                        Padding="8,1" 
                                        Command="{Binding MapByPositionCommand}"
                                        ToolTip.Tip="Connect columns 1:1 in sequential order (ideal for templates)">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Forward" FontSize="9" Foreground="#10B981"/>
                                        <TextBlock Text="Map by Position" FontSize="10"/>
                                    </StackPanel>
                                </Button>

                                <Button Classes="classic-tool-btn" 
                                        Height="24" 
                                        Padding="8,1" 
                                        Command="{Binding ClearMappingsCommand}"
                                        ToolTip.Tip="Clear all column connections">
                                    <TextBlock Text="Clear All" FontSize="10"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TAB 1: VISUAL COLUMN MAPPING -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsMappingTab}" Margin="16,10">
                        <Grid RowDefinitions="Auto, Auto, *">
                            
                            <!-- 1. Top Graphic Pipeline Source & Destination Overview -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, *" Margin="0,0,0,10" ColumnSpacing="12">
                                <!-- Left Card: Database Table -->
                                <Border Grid.Column="0" 
                                        Background="{DynamicResource AppSurfaceBrush}" 
                                        BorderBrush="#3038BDF8" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12,8">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Border Grid.Column="0" Background="#2038BDF8" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                                            <ui:FASymbolIcon Symbol="Document" FontSize="14" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="TARGET DATABASE TABLE" FontSize="8" FontWeight="Bold" Foreground="#38BDF8"/>
                                            <TextBlock Text="{Binding SelectedTable, FallbackValue='(No Table Selected)'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TotalTableColumnsCount, StringFormat='{}{0} Target Columns'}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Center Flow Bridge Pill -->
                                <Border Grid.Column="1" VerticalAlignment="Center" Padding="10,6" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="20">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Link" FontSize="12" Foreground="#10B981"/>
                                        <TextBlock Text="{Binding MappedColumnsCount, StringFormat='{}{0}'}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                        <TextBlock Text="of" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        <TextBlock Text="{Binding TotalTableColumnsCount, StringFormat='{}{0} Connected'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <Border Background="#2010B981" CornerRadius="8" Padding="6,1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding MappedPercentage, StringFormat='{}{0}%'}" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Right Card: Excel Source -->
                                <Border Grid.Column="2" 
                                        Background="{DynamicResource AppSurfaceBrush}" 
                                        BorderBrush="#3010B981" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="12,8">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <Border Grid.Column="0" Background="#2010B981" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                                            <ui:FASymbolIcon Symbol="Download" FontSize="14" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="SPREADSHEET SOURCE" FontSize="8" FontWeight="Bold" Foreground="#10B981"/>
                                            <TextBlock Text="{Binding FileName, FallbackValue='(No File Selected)'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TotalExcelRowsCount, StringFormat='{}{0:N0} Data Rows Available'}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 2. Filter Bar & Quick Counters -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="classic-tab-btn" Height="24" Padding="8,1" Command="{Binding SetFilterCommand}" CommandParameter="All">
                                        <TextBlock Text="{Binding TotalTableColumnsCount, StringFormat='All ({0})'}" FontSize="10" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Classes="classic-tab-btn" Height="24" Padding="8,1" Command="{Binding SetFilterCommand}" CommandParameter="Mapped">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border Background="#10B981" Width="6" Height="6" CornerRadius="3"/>
                                            <TextBlock Text="{Binding MappedColumnsCount, StringFormat='Connected ({0})'}" FontSize="10" FontWeight="SemiBold" Foreground="#10B981"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="classic-tab-btn" Height="24" Padding="8,1" Command="{Binding SetFilterCommand}" CommandParameter="Unmapped">
                                        <TextBlock Text="{Binding UnmappedColumnsCount, StringFormat='Unmapped ({0})'}" FontSize="10" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Classes="classic-tab-btn" Height="24" Padding="8,1" Command="{Binding SetFilterCommand}" CommandParameter="Required">
                                        <TextBlock Text="{Binding RequiredColumnsCount, StringFormat='Required ({0})'}" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                    </Button>
                                </StackPanel>

                                <!-- Column Headers Summary -->
                                <Grid Grid.Column="2" ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                    <TextBlock Text="Target Field" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Pipeline Link" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="Source Column &amp; Sample" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                </Grid>
                            </Grid>

                            <!-- 3. Mapping Cards Scroll Area -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="6">
                                    
                                    <ItemsControl ItemsSource="{Binding FilteredColumnMappings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ImportColumnMappingItem">
                                                <!-- Graphical 3-Part Mapping Card -->
                                                <Border Background="{DynamicResource AppSurfaceBrush}" 
                                                        BorderBrush="{Binding CardBorderBrush}" 
                                                        BorderThickness="1.5" 
                                                        CornerRadius="8" 
                                                        Padding="12,8" 
                                                        Margin="0,2"
                                                        BoxShadow="0 2 6 0 #10000000">
                                                    <Grid ColumnDefinitions="300, 130, *" VerticalAlignment="Center">
                                                        
                                                        <!-- 1. Left Box: Target Database Column -->
                                                        <Border Grid.Column="0" 
                                                                Background="{DynamicResource AppBackgroundBrush}" 
                                                                BorderBrush="{DynamicResource AppBorderBrush}" 
                                                                BorderThickness="1" 
                                                                CornerRadius="6" 
                                                                Padding="10,6">
                                                            <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                                                                <!-- PK / Required Badge -->
                                                                <Border Grid.Column="0" Background="{Binding PkBadgeColor}" CornerRadius="4" Padding="5,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding PkBadgeText}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                                                </Border>

                                                                <!-- Column Name and Data Type -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                    <TextBlock Text="{Binding TargetColumnName}" 
                                                                               FontSize="12" 
                                                                               FontWeight="Bold" 
                                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Border Background="{Binding DataTypeBadgeColor}" CornerRadius="3" Padding="4,0" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                                        <TextBlock Text="{Binding DataType}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Visual Node Port (Right edge) -->
                                                                <Ellipse Grid.Column="2" 
                                                                         Width="12" 
                                                                         Height="12" 
                                                                         Fill="{Binding NodeColor}" 
                                                                         Stroke="{DynamicResource AppBorderBrush}" 
                                                                         StrokeThickness="1.5"
                                                                         Margin="6,0,0,0"
                                                                         VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- 2. Center Box: Glowing Connection Wire & Status -->
                                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                                            <!-- Wire Line -->
                                                            <Rectangle Height="2" Fill="{Binding NodeColor}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                                                            <!-- Connection Badge Pill & Action -->
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                                                <Border Background="{Binding StatusBackground}" 
                                                                        BorderBrush="{Binding StatusForeground}" 
                                                                        BorderThickness="1" 
                                                                        CornerRadius="10" 
                                                                        Padding="6,1"
                                                                        HorizontalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                                        <ui:FASymbolIcon Symbol="Forward" FontSize="7" Foreground="{Binding StatusForeground}"/>
                                                                        <TextBlock Text="{Binding StatusBadge}" FontSize="8" FontWeight="Bold" Foreground="{Binding StatusForeground}"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Disconnect / Unlink button -->
                                                                <Button Classes="classic-menu-btn" 
                                                                        Command="{Binding UnlinkCommand}"
                                                                        Height="18" 
                                                                        Padding="4,0" 
                                                                        HorizontalAlignment="Center"
                                                                        IsVisible="{Binding IsMapped}"
                                                                        ToolTip.Tip="Disconnect this mapping">
                                                                    <ui:FASymbolIcon Symbol="Dismiss" FontSize="8" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- 3. Right Box: Excel Source Column & Live Sample Value -->
                                                        <Border Grid.Column="2" 
                                                                Background="{DynamicResource AppBackgroundBrush}" 
                                                                BorderBrush="{DynamicResource AppBorderBrush}" 
                                                                BorderThickness="1" 
                                                                CornerRadius="6" 
                                                                Padding="10,6">
                                                            <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                                                                <!-- Visual Node Port (Left edge) -->
                                                                <Ellipse Grid.Column="0" 
                                                                         Width="12" 
                                                                         Height="12" 
                                                                         Fill="{Binding NodeColor}" 
                                                                         Stroke="{DynamicResource AppBorderBrush}" 
                                                                         StrokeThickness="1.5"
                                                                         Margin="0,0,8,0"
                                                                         VerticalAlignment="Center"/>

                                                                <!-- Dropdown & Live Sample Preview -->
                                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                                                        <!-- Column Selector ComboBox -->
                                                                        <ComboBox Grid.Column="0" 
                                                                                  ItemsSource="{Binding AvailableExcelColumns}" 
                                                                                  SelectedItem="{Binding SelectedExcelColumn}" 
                                                                                  HorizontalAlignment="Stretch" 
                                                                                  Height="28" 
                                                                                  FontSize="11" 
                                                                                  CornerRadius="4"/>

                                                                        <!-- Constant Value input if Constant option is chosen -->
                                                                        <TextBox Grid.Column="1" 
                                                                                 Width="120" 
                                                                                 Height="28" 
                                                                                 FontSize="11" 
                                                                                 CornerRadius="4" 
                                                                                 PlaceholderText="Constant value..." 
                                                                                 Text="{Binding ConstantValue}" 
                                                                                 IsVisible="{Binding IsConstant}"/>
                                                                    </Grid>

                                                                    <!-- Live Sample Value Preview Pill -->
                                                                    <Border Background="{DynamicResource AppSurfaceBrush}" 
                                                                            BorderBrush="{DynamicResource AppBorderBrush}" 
                                                                            BorderThickness="1" 
                                                                            CornerRadius="4" 
                                                                            Padding="6,2">
                                                                        <Grid ColumnDefinitions="Auto, *">
                                                                            <ui:FASymbolIcon Grid.Column="0" Symbol="Preview" FontSize="9" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" 
                                                                                       Text="{Binding SamplePreviewValue}" 
                                                                                       FontSize="9" 
                                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                                                                       TextTrimming="CharacterEllipsis" 
                                                                                       VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty State when no table is selected -->
                                    <Border Background="{DynamicResource AppSurfaceBrush}" 
                                            BorderBrush="{DynamicResource AppBorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Padding="36" 
                                            IsVisible="{Binding !FilteredColumnMappings.Count}">
                                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                                            <ui:FASymbolIcon Symbol="Document" FontSize="28" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="No columns match the current filter" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <TextBlock Text="Select a target table or choose 'All' from the filter chips above" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- TAB 2: EXCEL DATA PREVIEW -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsExcelPreviewTab}" Margin="16,10">
                        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10" Spacing="6">
                                    <TextBlock Text="Raw Excel File Preview (First 10 Rows)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding RawPreviewRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                                    <ItemsControl ItemsSource="{Binding}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="16"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Width="120">
                                                                    <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Value}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- TAB 3: MAPPED IMPORT PREVIEW -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsImportPreviewTab}" Margin="16,10">
                        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10" Spacing="6">
                                    <TextBlock Text="Target Table Mapped Preview (Data to be inserted into database)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding MappedPreviewRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                                    <ItemsControl ItemsSource="{Binding}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="16"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Width="120">
                                                                    <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold" Foreground="#10B981" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Value}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 4. Footer & Action Controls -->
                <Border Grid.Row="3" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,1,0,0" 
                        CornerRadius="0,0,8,8" 
                        Padding="16,10">
                    <Grid RowDefinitions="Auto, Auto">
                        
                        <!-- Top: Options Strip & Status -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8">
                            <!-- Import Options -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <CheckBox Content="First row is header" 
                                          IsChecked="{Binding FirstRowIsHeader}" 
                                          FontSize="11"/>

                                <CheckBox Content="Skip error rows" 
                                          IsChecked="{Binding SkipErrors}" 
                                          FontSize="11" 
                                          ToolTip.Tip="Continue importing remaining rows if any individual row has constraint violations"/>

                                <CheckBox Content="Truncate table before import" 
                                          IsChecked="{Binding TruncateBeforeImport}" 
                                          FontSize="11" 
                                          ToolTip.Tip="Caution: Deletes all existing rows in target table prior to importing new data"/>
                            </StackPanel>

                            <!-- Status Message -->
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding StatusMessage}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{Binding IsSuccess, Converter={x:Null}}"
                                       IsVisible="{Binding HasStatusMessage}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Margin="8,0"/>

                            <!-- Batch Size Selector -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Batch Size:" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding BatchSizes}" SelectedItem="{Binding BatchSize}" Height="24" FontSize="10" CornerRadius="4"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bottom: Progress Bar & Action Buttons -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            
                            <!-- Progress Bar & Text during import -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" IsVisible="{Binding IsImporting}">
                                <ProgressBar Value="{Binding ImportProgress}" Maximum="100" Height="6" CornerRadius="3" Foreground="#10B981"/>
                                <TextBlock Text="{Binding ImportProgressText}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Spacer when not importing -->
                            <Panel Grid.Column="0" IsVisible="{Binding !IsImporting}"/>

                            <!-- Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="classic-tool-btn" 
                                        Content="Cancel" 
                                        Command="{Binding CloseCommand}" 
                                        Height="30" 
                                        Padding="14,2" 
                                        FontSize="11"/>

                                <Button Classes="classic-tool-btn" 
                                        Command="{Binding DownloadTemplateCommand}" 
                                        Height="30" 
                                        Padding="12,2" 
                                        FontSize="11"
                                        ToolTip.Tip="Export empty template Excel file for clients">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Download" FontSize="10"/>
                                        <TextBlock Text="Template" FontSize="11"/>
                                    </StackPanel>
                                </Button>

                                <Button Classes="primary-action-btn" 
                                        Command="{Binding ExecuteImportCommand}" 
                                        IsEnabled="{Binding !IsImporting}"
                                        Height="30" 
                                        Padding="16,2" 
                                        FontSize="11">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Upload" FontSize="11" Foreground="White"/>
                                        <TextBlock Text="Import Data into Table" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>