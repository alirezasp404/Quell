<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
             x:Class="Quell.Components.ImportDataModalComponent"
             x:DataType="vm:ImportDataModalViewModel"
             IsVisible="{Binding IsOpen}">

    <!-- Reusable Visual Excel / CSV Data Import Modal Dialog -->
    <Grid>
        <!-- Backdrop (Click to dismiss) -->
        <Border Classes="modal-backdrop" 
                Cursor="Hand" 
                Focusable="False" 
                FocusAdorner="{x:Null}" 
                Background="{DynamicResource AppModalOverlayBrush}" 
                PointerPressed="OnBackdropPointerPressed" />

        <!-- Centered Dialog Window Card -->
        <Border Classes="modal-dialog-card"
                Background="{DynamicResource AppWorkspaceBrush}" 
                BorderBrush="{DynamicResource AppBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                ClipToBounds="True"
                Focusable="False" 
                FocusAdorner="{x:Null}" 
                BoxShadow="0 12 32 0 #40000000"
                Width="880"
                MaxHeight="680"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            
            <Grid RowDefinitions="Auto, Auto, *, Auto">
                
                <!-- 1. Header -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        CornerRadius="8,8,0,0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" 
                                Background="#10B981" 
                                CornerRadius="6" 
                                Width="30" 
                                Height="30" 
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Download" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Import Data from Excel / CSV" 
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                           FontSize="14" 
                                           FontWeight="Bold"/>
                                <Border Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="Visual Schema Mapper" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Connect spreadsheet columns graphically to table fields and bulk insert data" 
                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                       FontSize="11" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                Classes="classic-menu-btn" 
                                Command="{Binding CloseCommand}"
                                Padding="6,2" 
                                MinHeight="24"
                                ToolTip.Tip="Close (Esc)">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="11"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Source & Target Selection Toolbar -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource AppBackgroundBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="16,10">
                    <Grid RowDefinitions="Auto, Auto" RowSpacing="10">
                        <!-- Row 1: Target Table & Template Download -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" 
                                       Text="Target Table:" 
                                       FontWeight="SemiBold" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                       VerticalAlignment="Center"/>

                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding AvailableTables}" 
                                      SelectedItem="{Binding SelectedTable}" 
                                      PlaceholderText="Choose database table to import into..." 
                                      HorizontalAlignment="Stretch" 
                                      Height="30" 
                                      CornerRadius="4" 
                                      FontSize="11"/>

                            <!-- Export Template for Table Button -->
                            <Button Grid.Column="2" 
                                    Classes="classic-tool-btn" 
                                    Height="30" 
                                    Padding="10,2"
                                    Command="{Binding DownloadTemplateCommand}"
                                    ToolTip.Tip="Generate and download empty Excel template matching this table for clients to fill">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ui:FASymbolIcon Symbol="Document" FontSize="11" Foreground="#10B981"/>
                                    <TextBlock Text="Download Table Template" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Refresh Table Columns -->
                            <Button Grid.Column="3" 
                                    Classes="classic-tool-btn" 
                                    Height="30" 
                                    Padding="8,2"
                                    Command="{Binding AutoMapColumnsCommand}"
                                    ToolTip.Tip="Re-map columns automatically">
                                <ui:FASymbolIcon Symbol="Sync" FontSize="11"/>
                            </Button>
                        </Grid>

                        <!-- Row 2: File Browser & File Status -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" 
                                       Text="Spreadsheet:" 
                                       FontWeight="SemiBold" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                       VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1" 
                                     Text="{Binding FilePath}" 
                                     PlaceholderText="Select Excel (.xlsx) or CSV (.csv) file..." 
                                     Height="30" 
                                     FontSize="11" 
                                     CornerRadius="4" 
                                     Padding="8,4" 
                                     IsReadOnly="True"/>

                            <Button Grid.Column="2" 
                                    Classes="classic-tool-btn" 
                                    Height="30" 
                                    Padding="12,2"
                                    Command="{Binding BrowseFileCommand}"
                                    CommandParameter="{Binding $parent[TopLevel]}"
                                    ToolTip.Tip="Browse spreadsheet file from disk">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ui:FASymbolIcon Symbol="Folder" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                    <TextBlock Text="Browse File..." FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. Main Body: Tabs & Visual Mapping Area -->
                <Grid Grid.Row="2" RowDefinitions="Auto, *">
                    <!-- Tab Navigation Header Strip -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource AppSurfaceBrush}" 
                            BorderBrush="{DynamicResource AppBorderBrush}" 
                            BorderThickness="0,0,0,1" 
                            Padding="16,4,16,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                <Button Classes="classic-tab-btn" 
                                        Height="28" 
                                        Padding="12,2" 
                                        Command="{Binding SetTabCommand}" 
                                        CommandParameter="Mapping">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FASymbolIcon Symbol="Link" FontSize="10" Foreground="{DynamicResource AppAccentBrush}"/>
                                        <TextBlock Text="Visual Column Mapping" FontSize="11" FontWeight="SemiBold"/>
                                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="5,0" Margin="2,0,0,0">
                                            <TextBlock Text="{Binding MappedColumnsCount, StringFormat='{}{0}'}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <Button Classes="classic-tab-btn" 
                                        Height="28" 
                                        Padding="12,2" 
                                        Command="{Binding SetTabCommand}" 
                                        CommandParameter="ExcelPreview"
                                        IsEnabled="{Binding HasFileLoaded}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FASymbolIcon Symbol="Preview" FontSize="10"/>
                                        <TextBlock Text="Excel Data Preview" FontSize="11"/>
                                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="5,0" Margin="2,0,0,0" IsVisible="{Binding HasFileLoaded}">
                                            <TextBlock Text="{Binding TotalExcelRowsCount, StringFormat='{}{0:N0} rows'}" FontSize="9" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <Button Classes="classic-tab-btn" 
                                        Height="28" 
                                        Padding="12,2" 
                                        Command="{Binding SetTabCommand}" 
                                        CommandParameter="ImportPreview"
                                        IsEnabled="{Binding HasFileLoaded}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:FASymbolIcon Symbol="Document" FontSize="10"/>
                                        <TextBlock Text="Mapped Import Preview" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Mapping Controls Toolbar (Right side of tab strip) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsMappingTab}">
                                <Button Classes="classic-tool-btn" 
                                        Height="24" 
                                        Padding="8,1" 
                                        Command="{Binding AutoMapColumnsCommand}"
                                        ToolTip.Tip="Automatically connect columns with matching or similar names">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Sync" FontSize="9" Foreground="#38BDF8"/>
                                        <TextBlock Text="Auto-Map by Name" FontSize="10"/>
                                    </StackPanel>
                                </Button>

                                <Button Classes="classic-tool-btn" 
                                        Height="24" 
                                        Padding="8,1" 
                                        Command="{Binding ClearMappingsCommand}"
                                        ToolTip.Tip="Clear all column connections">
                                    <TextBlock Text="Clear Mappings" FontSize="10"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TAB 1: VISUAL COLUMN MAPPING -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsMappingTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,10">
                            <StackPanel Spacing="6">
                                
                                <!-- Column List Header -->
                                <Border Background="{DynamicResource AppSurfaceBrush}" 
                                        BorderBrush="{DynamicResource AppBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Padding="12,6" 
                                        Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="260, 40, *, 120">
                                        <TextBlock Grid.Column="0" Text="Target Table Column" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Source Excel / CSV Column" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                        <TextBlock Grid.Column="3" Text="Status" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Mapping Rows -->
                                <ItemsControl ItemsSource="{Binding ColumnMappings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ImportColumnMappingItem">
                                            <Border Background="{DynamicResource AppSurfaceBrush}" 
                                                    BorderBrush="{DynamicResource AppBorderBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Padding="12,8" 
                                                    Margin="0,2">
                                                <Grid ColumnDefinitions="260, 40, *, 120" VerticalAlignment="Center">
                                                    
                                                    <!-- Left: Target Table Column -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <!-- PK / Required Badge -->
                                                        <Border Background="{Binding PkBadgeColor}" CornerRadius="3" Padding="4,1" Width="36" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding PkBadgeText}" FontSize="8" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Column Name & Data Type -->
                                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock Text="{Binding TargetColumnName}" 
                                                                       FontSize="11" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding DataType}" 
                                                                       FontSize="9" 
                                                                       Foreground="{DynamicResource AppTextMutedBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Center: High-Tech Connector -->
                                                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ui:FASymbolIcon Symbol="Forward" FontSize="10" Foreground="{Binding StatusForeground}"/>
                                                    </Border>

                                                    <!-- Right: Excel Column Selector -->
                                                    <Grid Grid.Column="2" ColumnDefinitions="*, Auto" ColumnSpacing="6" VerticalAlignment="Center">
                                                        <ComboBox Grid.Column="0" 
                                                                  ItemsSource="{Binding AvailableExcelColumns}" 
                                                                  SelectedItem="{Binding SelectedExcelColumn}" 
                                                                  HorizontalAlignment="Stretch" 
                                                                  Height="28" 
                                                                  FontSize="11" 
                                                                  CornerRadius="4"/>

                                                        <!-- Constant Value Input (Visible when selected option is Constant) -->
                                                        <TextBox Grid.Column="1" 
                                                                 Width="120" 
                                                                 Height="28" 
                                                                 FontSize="11" 
                                                                 CornerRadius="4" 
                                                                 PlaceholderText="Value..." 
                                                                 Text="{Binding ConstantValue}" 
                                                                 IsVisible="{Binding IsConstant}"/>
                                                    </Grid>

                                                    <!-- Status Badge -->
                                                    <Border Grid.Column="3" 
                                                            Background="{Binding StatusBackground}" 
                                                            CornerRadius="4" 
                                                            Padding="6,2" 
                                                            HorizontalAlignment="Right" 
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusBadge}" 
                                                                   FontSize="10" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="{Binding StatusForeground}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State when no table selected -->
                                <Border Background="{DynamicResource AppSurfaceBrush}" 
                                        BorderBrush="{DynamicResource AppBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="30" 
                                        IsVisible="{Binding !ColumnMappings.Count}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                                        <ui:FASymbolIcon Symbol="Document" FontSize="24" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="No table schema loaded" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        <TextBlock Text="Please choose a target table from the dropdown above" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource AppTextMutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 2: EXCEL DATA PREVIEW -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsExcelPreviewTab}" Margin="16,10">
                        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10" Spacing="6">
                                    <TextBlock Text="Raw Excel File Preview (First 10 Rows)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding RawPreviewRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                                    <ItemsControl ItemsSource="{Binding}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="16"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Width="120">
                                                                    <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Value}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- TAB 3: MAPPED IMPORT PREVIEW -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsImportPreviewTab}" Margin="16,10">
                        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10" Spacing="6">
                                    <TextBlock Text="Target Table Mapped Preview (Data to be inserted into database)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding MappedPreviewRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                                    <ItemsControl ItemsSource="{Binding}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="16"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Width="120">
                                                                    <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold" Foreground="#10B981" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Value}" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 4. Footer & Action Controls -->
                <Border Grid.Row="3" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,1,0,0" 
                        CornerRadius="0,0,8,8" 
                        Padding="16,10">
                    <Grid RowDefinitions="Auto, Auto">
                        
                        <!-- Top: Options Strip & Status -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8">
                            <!-- Import Options -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <CheckBox Content="First row is header" 
                                          IsChecked="{Binding FirstRowIsHeader}" 
                                          FontSize="11"/>

                                <CheckBox Content="Skip error rows" 
                                          IsChecked="{Binding SkipErrors}" 
                                          FontSize="11" 
                                          ToolTip.Tip="Continue importing remaining rows if any individual row has constraint violations"/>

                                <CheckBox Content="Truncate table before import" 
                                          IsChecked="{Binding TruncateBeforeImport}" 
                                          FontSize="11" 
                                          ToolTip.Tip="Caution: Deletes all existing rows in target table prior to importing new data"/>
                            </StackPanel>

                            <!-- Status Message -->
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding StatusMessage}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{Binding IsSuccess, Converter={x:Null}}"
                                       IsVisible="{Binding HasStatusMessage}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Margin="8,0"/>

                            <!-- Batch Size Selector -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Batch Size:" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding BatchSizes}" SelectedItem="{Binding BatchSize}" Height="24" FontSize="10" CornerRadius="4"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bottom: Progress Bar & Action Buttons -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            
                            <!-- Progress Bar & Text during import -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" IsVisible="{Binding IsImporting}">
                                <ProgressBar Value="{Binding ImportProgress}" Maximum="100" Height="6" CornerRadius="3" Foreground="#10B981"/>
                                <TextBlock Text="{Binding ImportProgressText}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Spacer when not importing -->
                            <Panel Grid.Column="0" IsVisible="{Binding !IsImporting}"/>

                            <!-- Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="classic-tool-btn" 
                                        Content="Cancel" 
                                        Command="{Binding CloseCommand}" 
                                        Height="30" 
                                        Padding="14,2" 
                                        FontSize="11"/>

                                <Button Classes="classic-tool-btn" 
                                        Command="{Binding DownloadTemplateCommand}" 
                                        Height="30" 
                                        Padding="12,2" 
                                        FontSize="11"
                                        ToolTip.Tip="Export empty template Excel file for clients">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Download" FontSize="10"/>
                                        <TextBlock Text="Template" FontSize="11"/>
                                    </StackPanel>
                                </Button>

                                <Button Classes="primary-action-btn" 
                                        Command="{Binding ExecuteImportCommand}" 
                                        IsEnabled="{Binding !IsImporting}"
                                        Height="30" 
                                        Padding="16,2" 
                                        FontSize="11">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <ui:FASymbolIcon Symbol="Upload" FontSize="11" Foreground="White"/>
                                        <TextBlock Text="Import Data into Table" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
