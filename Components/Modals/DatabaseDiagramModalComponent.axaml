<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:components="using:Quell.Components"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Quell.Components.DatabaseDiagramModalComponent"
             x:DataType="vm:DatabaseDiagramModalViewModel"
             IsVisible="{Binding IsOpen}">

    <UserControl.Styles>
        <Style Selector="Border.diagram-table-card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="240"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BoxShadow" Value="0 4 12 0 #20000000"/>
        </Style>
        <Style Selector="Border.diagram-table-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BoxShadow" Value="0 6 18 0 #35000000"/>
        </Style>
        <!-- Animated 360-degree Rotating Spinner -->
        <Style Selector="Border.spin-indicator">
            <Style.Animations>
                <Animation Duration="0:0:1.0" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Quick Filter Toggle Buttons -->
        <Style Selector="Button.filter-pill-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.filter-pill-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppToolHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Button.filter-pill-btn.active">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Backdrop (Click to dismiss) -->
        <Border Classes="modal-backdrop" Cursor="Hand" Focusable="False" FocusAdorner="{x:Null}" 
                Background="{DynamicResource AppModalOverlayBrush}" 
                PointerPressed="OnBackdropPointerPressed" />

        <!-- Centered Dialog Window Card (Zero Black Edges with ClipToBounds) -->
        <Border Background="{DynamicResource AppWorkspaceBrush}" 
                BorderBrush="{DynamicResource AppBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                ClipToBounds="True"
                Focusable="False" FocusAdorner="{x:Null}" 
                BoxShadow="0 16 36 0 #50000000"
                Width="1020" MaxWidth="1150"
                Height="660" MaxHeight="750"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            
            <Grid RowDefinitions="Auto, Auto, *, Auto">
                
                <!-- 1. Header -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="16,12">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" 
                                Background="{DynamicResource AppAccentBrush}" 
                                CornerRadius="6" 
                                Width="28" 
                                Height="28" 
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Preview" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Database ER Diagram &amp; Schema Relations" 
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                           FontSize="13" 
                                           FontWeight="Bold"/>
                                <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DatabaseType}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="{Binding DatabaseTitle}" 
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                           FontSize="12" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Visual table schemas, primary keys, and foreign key relations" 
                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                       FontSize="11" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                Classes="classic-menu-btn" 
                                Command="{Binding CloseCommand}"
                                Padding="6,2" 
                                MinHeight="22"
                                ToolTip.Tip="Close (Esc)">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="10"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Controls Toolbar & Statistics Strip -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource AppBackgroundBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="14,7">
                    <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                        <!-- Search / Filter -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox Width="200" 
                                     Height="27" 
                                     FontSize="11" 
                                     Padding="6,3"
                                     CornerRadius="4" 
                                     IsEnabled="{Binding !IsLoading}"
                                     PlaceholderText="Filter tables &amp; columns..." 
                                     Text="{Binding SearchFilter}" />
                        </StackPanel>

                        <!-- Quick Filter Pills -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Classes="filter-pill-btn" 
                                    Height="27"
                                    IsEnabled="{Binding !IsLoading}"
                                    Command="{Binding SetFilterModeCommand}"
                                    CommandParameter="All"
                                    ToolTip.Tip="Show all discovered tables">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="All Tables"/>
                                    <TextBlock Text="{Binding TotalTablesCount, StringFormat='({0})'}" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="filter-pill-btn" 
                                    Height="27"
                                    IsEnabled="{Binding !IsLoading}"
                                    Command="{Binding SetFilterModeCommand}"
                                    CommandParameter="Relations"
                                    ToolTip.Tip="Show tables having Foreign Key relationships">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ui:FASymbolIcon Symbol="Link" FontSize="9" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Relations"/>
                                    <TextBlock Text="{Binding TablesWithRelationsCount, StringFormat='({0})'}" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="filter-pill-btn" 
                                    Height="27"
                                    IsEnabled="{Binding !IsLoading}"
                                    Command="{Binding SetFilterModeCommand}"
                                    CommandParameter="PK"
                                    ToolTip.Tip="Show tables with Primary Keys">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="PK Only"/>
                                    <TextBlock Text="{Binding TablesWithPkCount, StringFormat='({0})'}" FontWeight="Bold" Foreground="#F59E0B"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Status Message -->
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding StatusMessage}" 
                                   IsVisible="{Binding HasStatusMessage}"
                                   Foreground="#10B981" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Margin="8,0"/>

                        <!-- Action Buttons: Zoom & Export & Refresh -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Zoom Controls -->
                            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Height="27">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <Button Classes="classic-menu-btn" Height="25" Padding="6,1" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom Out">
                                        <TextBlock Text="-" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                    <Button Classes="classic-menu-btn" Height="25" Padding="5,1" Command="{Binding ResetZoomCommand}" ToolTip.Tip="Reset Zoom (100%)">
                                        <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}" FontSize="10" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Classes="classic-menu-btn" Height="25" Padding="6,1" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom In">
                                        <TextBlock Text="+" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Refresh Diagram Button -->
                            <Button Classes="classic-tool-btn" 
                                    Height="27" 
                                    Padding="8,2"
                                    IsEnabled="{Binding !IsLoading}"
                                    Command="{Binding RefreshDiagramCommand}"
                                    ToolTip.Tip="Re-analyze and reload schema relations">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <ui:FASymbolIcon Symbol="Sync" FontSize="10"/>
                                    <TextBlock Text="Reload" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- Copy Mermaid Code Button -->
                            <Button Classes="classic-tool-btn" 
                                    Height="27" 
                                    Padding="10,2"
                                    IsEnabled="{Binding !IsLoading}"
                                    Command="{Binding CopyMermaidDiagramCommand}"
                                    ToolTip.Tip="Generate and copy Mermaid ER diagram syntax for documentation">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <ui:FASymbolIcon Symbol="Copy" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                    <TextBlock Text="Mermaid" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Visual Entity-Relationship Canvas OR Loading State -->
                <Panel Grid.Row="2">
                    
                    <!-- A. Active Loading Indicator State (With Rotating Spinner Animation) -->
                    <Border Background="{DynamicResource AppWorkspaceBrush}" 
                            IsVisible="{Binding IsLoading}"
                            Padding="32">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Width="400">
                            <!-- Animated 360-degree Rotating Spinner -->
                            <Border Classes="spin-indicator"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppAccentBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="30"
                                    Width="56"
                                    Height="56"
                                    HorizontalAlignment="Center"
                                    RenderTransformOrigin="50%,50%">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Border.RenderTransform>
                                <ui:FASymbolIcon Symbol="Sync" 
                                                 FontSize="24" 
                                                 Foreground="{DynamicResource AppAccentBrush}" 
                                                 HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center"/>
                            </Border>

                            <!-- Loading Titles -->
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="Analyzing Database Schema &amp; Relations" 
                                           FontSize="14" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LoadingMessage}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Smooth Progress Bar -->
                            <ProgressBar Height="5" 
                                         CornerRadius="2" 
                                         Minimum="0" Maximum="100" 
                                         Value="{Binding LoadingProgress}" 
                                         IsIndeterminate="{Binding IsIndeterminate}" 
                                         Foreground="{DynamicResource AppAccentBrush}" 
                                         Background="{DynamicResource AppBorderBrush}" 
                                         HorizontalAlignment="Stretch"/>

                            <!-- Progress Detail & Percentage -->
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding LoadingDetailText}" 
                                           FontSize="10" 
                                           Foreground="{DynamicResource AppTextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding LoadingProgress, StringFormat='{}{0:0}%'}" 
                                           FontSize="10" 
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           IsVisible="{Binding !IsIndeterminate}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- B. Visual Entity-Relationship Canvas (Loaded) with Zoom Scaling -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto" 
                                  Padding="12"
                                  IsVisible="{Binding !IsLoading}">
                        <LayoutTransformControl>
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                            </LayoutTransformControl.LayoutTransform>
                            
                            <ItemsControl ItemsSource="{Binding FilteredTables}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="diagram-table-card">
                                            <Grid RowDefinitions="Auto, *, Auto">
                                                
                                                <!-- Table Card Header -->
                                                <Border Grid.Row="0" 
                                                        Background="{DynamicResource AppBackgroundBrush}" 
                                                        BorderBrush="{DynamicResource AppBorderBrush}" 
                                                        BorderThickness="0,0,0,1" 
                                                        CornerRadius="5,5,0,0"
                                                        Padding="8,6">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <ui:FASymbolIcon Symbol="Folder" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                                            <TextBlock Text="{Binding TableName}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                            <Button Classes="classic-menu-btn" 
                                                                    Padding="4,1" 
                                                                    Height="20"
                                                                    Command="{Binding $parent[components:DatabaseDiagramModalComponent].((vm:DatabaseDiagramModalViewModel)DataContext).ViewTableDataCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="Select Top 100 rows in Editor">
                                                                <ui:FASymbolIcon Symbol="Play" FontSize="9"/>
                                                            </Button>
                                                            <Button Classes="classic-menu-btn" 
                                                                    Padding="4,1" 
                                                                    Height="20"
                                                                    Command="{Binding $parent[components:DatabaseDiagramModalComponent].((vm:DatabaseDiagramModalViewModel)DataContext).GenerateDdlCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="Generate CREATE TABLE DDL">
                                                                <ui:FASymbolIcon Symbol="Code" FontSize="9"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Columns List -->
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Columns}" Margin="6,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="2,2">
                                                                <!-- Key Indicator -->
                                                                <Border Grid.Column="0" Width="20" HorizontalAlignment="Left">
                                                                    <Panel>
                                                                        <Border Background="#F59E0B" CornerRadius="2" Padding="2,0" IsVisible="{Binding IsPrimaryKey}">
                                                                            <TextBlock Text="PK" FontSize="8" FontWeight="Bold" Foreground="Black"/>
                                                                        </Border>
                                                                        <Border Background="#38BDF8" CornerRadius="2" Padding="2,0" IsVisible="{Binding IsForeignKey}">
                                                                            <TextBlock Text="FK" FontSize="8" FontWeight="Bold" Foreground="Black"/>
                                                                        </Border>
                                                                    </Panel>
                                                                </Border>

                                                                <!-- Column Name -->
                                                                <TextBlock Grid.Column="1" 
                                                                           Text="{Binding ColumnName}" 
                                                                           FontSize="11" 
                                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,0"/>

                                                                <!-- Data Type Pill -->
                                                                <TextBlock Grid.Column="2" 
                                                                           Text="{Binding DataType}" 
                                                                           FontSize="9" 
                                                                           Foreground="{DynamicResource AppTextMutedBrush}" 
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Table Card Footer: Relations -->
                                                <Border Grid.Row="2" 
                                                        Background="{DynamicResource AppBackgroundBrush}" 
                                                        BorderBrush="{DynamicResource AppBorderBrush}" 
                                                        BorderThickness="0,1,0,0" 
                                                        CornerRadius="0,0,5,5"
                                                        Padding="6,4"
                                                        IsVisible="{Binding OutgoingRelations.Count}">
                                                    <ItemsControl ItemsSource="{Binding OutgoingRelations}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <ui:FASymbolIcon Symbol="Link" FontSize="8" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding}" FontSize="9" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </LayoutTransformControl>
                    </ScrollViewer>

                    <!-- C. Empty State (No tables found) -->
                    <Border Background="{DynamicResource AppWorkspaceBrush}" 
                            IsVisible="{Binding IsEmptyState}"
                            Padding="32">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="320">
                            <Border Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="24"
                                    Width="48"
                                    Height="48"
                                    HorizontalAlignment="Center">
                                <ui:FASymbolIcon Symbol="Document" 
                                                 FontSize="18" 
                                                 Foreground="{DynamicResource AppTextMutedBrush}" 
                                                 HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="No Tables Available" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="No tables found in the active database or matching the search filter." 
                                       FontSize="11" 
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Panel>

                <!-- 4. Footer -->
                <Border Grid.Row="3" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,1,0,0" 
                        Padding="16,10">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Visible Tables:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FilteredTables.Count}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Total Relations:" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalRelationsCount}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Classes="classic-tool-btn" 
                                    Content="Close" 
                                    Command="{Binding CloseCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
