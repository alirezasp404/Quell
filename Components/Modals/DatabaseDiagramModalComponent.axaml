<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:components="using:Quell.Components"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Quell.Components.DatabaseDiagramModalComponent"
             x:DataType="vm:DatabaseDiagramModalViewModel"
             IsVisible="{Binding IsOpen}">

    <UserControl.Styles>
        <Style Selector="Border.diagram-table-card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="240"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style Selector="Border.diagram-table-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Backdrop (Click to dismiss) -->
        <Border Classes="modal-backdrop" Cursor="Hand" Focusable="False" FocusAdorner="{x:Null}" 
                Background="{DynamicResource AppModalOverlayBrush}" 
                PointerPressed="OnBackdropPointerPressed" />

        <!-- Centered Dialog Window Card -->
        <Border Background="{DynamicResource AppWorkspaceBrush}" 
                BorderBrush="{DynamicResource AppBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Focusable="False" FocusAdorner="{x:Null}" 
                BoxShadow="0 12 30 0 #40000000"
                Width="980" MaxWidth="1100"
                Height="640" MaxHeight="720"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            
            <Grid RowDefinitions="Auto, Auto, *, Auto">
                
                <!-- 1. Header -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        CornerRadius="8,8,0,0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" 
                                Background="{DynamicResource AppAccentBrush}" 
                                CornerRadius="6" 
                                Width="28" 
                                Height="28" 
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Preview" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Database ER Diagram &amp; Schema Relations" 
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                           FontSize="13" 
                                           FontWeight="Bold"/>
                                <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DatabaseType}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="{Binding DatabaseTitle}" 
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                           FontSize="12" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Visual table schemas, primary keys, and foreign key relations" 
                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                       FontSize="11" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                Classes="classic-menu-btn" 
                                Command="{Binding CloseCommand}"
                                Padding="6,2" 
                                MinHeight="22"
                                ToolTip.Tip="Close (Esc)">
                            <ui:FASymbolIcon Symbol="Dismiss" FontSize="10"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Controls Toolbar & Statistics Strip -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource AppBackgroundBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="16,8">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <!-- Search / Filter -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox Width="240" 
                                     Height="28" 
                                     FontSize="11" 
                                     Padding="6,3"
                                     CornerRadius="4" 
                                     PlaceholderText="Filter tables &amp; columns..." 
                                     Text="{Binding SearchFilter}" />
                        </StackPanel>

                        <!-- Status Message -->
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding StatusMessage}" 
                                   IsVisible="{Binding HasStatusMessage}"
                                   Foreground="#10B981" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"/>

                        <!-- Action Buttons & Badges -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Tables:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalTablesCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="FK Relations:" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalRelationsCount}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Border>

                            <!-- Copy Mermaid Code Button -->
                            <Button Classes="classic-tool-btn" 
                                    Height="28" 
                                    Padding="10,2"
                                    Command="{Binding CopyMermaidDiagramCommand}"
                                    ToolTip.Tip="Generate and copy Mermaid ER diagram syntax for documentation">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <ui:FASymbolIcon Symbol="Copy" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                    <TextBlock Text="Copy Mermaid" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Visual Entity-Relationship Canvas -->
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="12">
                    <ItemsControl ItemsSource="{Binding FilteredTables}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="diagram-table-card">
                                    <Grid RowDefinitions="Auto, *, Auto">
                                        
                                        <!-- Table Card Header -->
                                        <Border Grid.Row="0" 
                                                Background="{DynamicResource AppBackgroundBrush}" 
                                                BorderBrush="{DynamicResource AppBorderBrush}" 
                                                BorderThickness="0,0,0,1" 
                                                CornerRadius="5,5,0,0"
                                                Padding="8,6">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <ui:FASymbolIcon Symbol="Folder" FontSize="11" Foreground="{DynamicResource AppAccentBrush}"/>
                                                    <TextBlock Text="{Binding TableName}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                    <Button Classes="classic-menu-btn" 
                                                            Padding="4,1" 
                                                            Height="20"
                                                            Command="{Binding $parent[components:DatabaseDiagramModalComponent].((vm:DatabaseDiagramModalViewModel)DataContext).ViewTableDataCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Select Top 100 rows in Editor">
                                                        <ui:FASymbolIcon Symbol="Play" FontSize="9"/>
                                                    </Button>
                                                    <Button Classes="classic-menu-btn" 
                                                            Padding="4,1" 
                                                            Height="20"
                                                            Command="{Binding $parent[components:DatabaseDiagramModalComponent].((vm:DatabaseDiagramModalViewModel)DataContext).GenerateDdlCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Generate CREATE TABLE DDL">
                                                        <ui:FASymbolIcon Symbol="Code" FontSize="9"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Columns List -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Columns}" Margin="6,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="2,2">
                                                        <!-- Key Indicator -->
                                                        <Border Grid.Column="0" Width="20" HorizontalAlignment="Left">
                                                            <Panel>
                                                                <Border Background="#F59E0B" CornerRadius="2" Padding="2,0" IsVisible="{Binding IsPrimaryKey}">
                                                                    <TextBlock Text="PK" FontSize="8" FontWeight="Bold" Foreground="Black"/>
                                                                </Border>
                                                                <Border Background="#38BDF8" CornerRadius="2" Padding="2,0" IsVisible="{Binding IsForeignKey}">
                                                                    <TextBlock Text="FK" FontSize="8" FontWeight="Bold" Foreground="Black"/>
                                                                </Border>
                                                            </Panel>
                                                        </Border>

                                                        <!-- Column Name -->
                                                        <TextBlock Grid.Column="1" 
                                                                   Text="{Binding ColumnName}" 
                                                                   FontSize="11" 
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0"/>

                                                        <!-- Data Type Pill -->
                                                        <TextBlock Grid.Column="2" 
                                                                   Text="{Binding DataType}" 
                                                                   FontSize="9" 
                                                                   Foreground="{DynamicResource AppTextMutedBrush}" 
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Table Card Footer: Relations -->
                                        <Border Grid.Row="2" 
                                                Background="{DynamicResource AppBackgroundBrush}" 
                                                BorderBrush="{DynamicResource AppBorderBrush}" 
                                                BorderThickness="0,1,0,0" 
                                                CornerRadius="0,0,5,5"
                                                Padding="6,4"
                                                IsVisible="{Binding OutgoingRelations.Count}">
                                            <ItemsControl ItemsSource="{Binding OutgoingRelations}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <ui:FASymbolIcon Symbol="Link" FontSize="8" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding}" FontSize="9" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 4. Footer -->
                <Border Grid.Row="3" 
                        Background="{DynamicResource AppSurfaceBrush}" 
                        BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="0,1,0,0" 
                        CornerRadius="0,0,8,8"
                        Padding="16,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="classic-tool-btn" 
                                Content="Close" 
                                Command="{Binding CloseCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
