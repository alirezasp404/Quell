<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Quell.Components.ToolButtonComponent">

    <Button x:Name="InnerButton"
            Classes="classic-tool-btn"
            Height="24"
            Padding="8,3"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <ui:FASymbolIcon x:Name="ButtonIcon" Symbol="Add" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock x:Name="ButtonText" Text="Tool" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>
    </Button>
</UserControl>
