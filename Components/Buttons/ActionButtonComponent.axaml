<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Fdb.Components.ActionButtonComponent">

    <Button x:Name="InnerButton"
            Background="{DynamicResource AppAccentBrush}"
            Foreground="White"
            FontWeight="SemiBold"
            FontSize="11"
            CornerRadius="4"
            Padding="12,5"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <ui:FASymbolIcon x:Name="ButtonIcon" Symbol="Play" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock x:Name="ButtonText" Text="Action" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
</UserControl>
