<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Quell.Components.IconButtonComponent">

    <Button x:Name="InnerButton"
            Classes="classic-menu-btn"
            Padding="4,2"
            Height="22"
            Width="22"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Center">
        <ui:FASymbolIcon x:Name="ButtonIcon" Symbol="Refresh" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Button>
</UserControl>
